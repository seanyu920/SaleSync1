                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
                <div class="map-overlay-badge">
                    <span>Our Location</span>
                    Taytay, Rizal
                </div>
            </div>
        </div>
    </section>


    <footer class="footer">
        <div class="footer-content">
            <p>© 2026 Cafèro. Crafted for connection.</p>
            <p class="salesync-badge">Powered by <strong>SaleSync</strong></p>
        </div>
    </footer>

