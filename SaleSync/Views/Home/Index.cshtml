                        <div class="contact-details">
                            <strong>Phone</strong>
                            <p>+63 912 345 6789</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-map-side">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3861.642531649257!2d121.1311029!3d14.5623004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3397c7e3f88f8d55%3A0xb6ca2ffb01230d7b!2sB.%20A.%20Cruz%2C%20Taytay%2C%201920%20Rizal!5e0!3m2!1sen!2sph!4v1700000000000!5m2!1sen!2sph"
                        allowfullscreen=""
