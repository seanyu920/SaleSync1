@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cafèro | Coffee & Connection</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="images/CaferoLogo.jpg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/HomePage.css" asp-append-version="true" />
</head>
<body>

    <header class="top-bar">
        <div class="top-bar-left">
            <a href="#home" class="logo">
                <img src="/images/Untitled design.png" alt="Cafero Logo" class="logo-icon" />
                <span>Cafèro</span>
            </a>
        </div>

        <div class="nav-container" id="navContainer">
            <nav class="nav-menu">
                <a href="#home" onclick="closeNav()">Home</a>
                <a href="#about" onclick="closeNav()">About</a>
                <a href="#menu" onclick="closeNav()">Menu</a>
                <a href="#contact" onclick="closeNav()">Contact</a>
            </nav>
        </div>

        <div class="top-bar-right">
            <a asp-controller="Home" asp-action="Login" class="login-btn">
                <i class="fas fa-user"></i> Log In
            </a>
            <button class="hamburger" id="hamburger" onclick="toggleNav()">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <main class="hero-section" id="home">
        <div class="hero-content">
            <span class="hero-badge">Est. 2026</span>
            <h1>Where Every<br>Sip Feels Like <em>Home</em></h1>
            <p>Craft coffee, warm spaces, and a menu made for lingering. Cafèro is your corner escape in Taytay.</p>
            <div class="hero-actions">
                <a href="/Home/Login" class="hero-btn">Order Now</a>
                <a href="#menu" class="hero-btn btn-outline">Explore Menu</a>
            </div>
            <div class="hero-stats">

</div>
        </div>

        <div class="hero-specialty-container">
            <span class="specialty-label"><i class="fas fa-star"></i> Our Specialties</span>

            <div class="specialty-grid">
                <div class="specialty-column">
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/spanish-latte.jpg" alt="Spanish Latte" />
                        <div class="specialty-info">
                            <h4>Spanish Latte</h4>
                            <p>Sweetened, creamy traditional espresso favorite.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/okinawa.jpg" alt="Okinawa Milktea" />
                        <div class="specialty-info">
                            <h4>Okinawa</h4>
                            <p>Rich, roasted brown sugar milk tea perfection.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/croissant.jpg" alt="Croissant" />
                        <div class="specialty-info">
                            <h4>Croissant</h4>
                            <p>Flaky, light buttery pastry baked fresh daily.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>

                <div class="specialty-column">
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/hot-latte.jpg" alt="Hot Latte" />
                        <div class="specialty-info">
                            <h4>Hot Latte</h4>
                            <p>Classic smooth espresso balanced with steamed milk.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/mango.jpg" alt="Mango Fruit Tea" />
                        <div class="specialty-info">
                            <h4>Mango</h4>
                            <p>Luscious, bright tropical mango fruit tea.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/tapsilog.jpg" alt="Hot Silog" />
                        <div class="specialty-info">
                            <h4>Hot Silog</h4>
                            <p>Savory cured beef tapa with garlic rice and egg.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>

                <div class="specialty-column">
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/ensaymada.jpg" alt="Cheese Ensaymada" />
                        <div class="specialty-info">
                            <h4>Cheese Ensaymada</h4>
                            <p>Sweet brioche roll grated heavily with cheese.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/wintermelon.jpg" alt="Wintermelon Milktea" />
                        <div class="specialty-info">
                            <h4>Wintermelon</h4>
                            <p>Classic, cool, and refreshing brown sugar taste.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="specialty-card">
                        <img class="specialty-img" src="/images/carbonara.jpg" alt="Carbonara" />
                        <div class="specialty-info">
                            <h4>Carbonara</h4>
                            <p>Creamy rich white sauce pasta with savory bacon.</p>
                            <a href="#menu" class="specialty-link">Find Out More <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <section class="about-story-section" id="about">
        <div class="story-container">
            <span class="section-eyebrow">Our Story</span>
            <h2>Welcome to<br><span>Cafèro</span></h2>
            <p class="about-story-text">
                Established in December 2025, <strong>Cafèro</strong> is Taytay, Rizal’s newest coffee sanctuary.
                We believe that exceptional, passion-crafted coffee shouldn't come with a premium price tag.
                That’s why we’re dedicated to bringing you rich flavors, cozy vibes, and daily brews that are beautifully budget-friendly.
            </p>

            <div class="story-highlights">
                <div class="highlight-item">
                    <span class="highlight-number">30+</span>
                    <span class="highlight-label">Menu Items</span>
                </div>

                <div class="highlight-divider"></div>

                <div class="highlight-item">
                    <span class="highlight-number">₱85</span>
                    <span class="highlight-label">Lowest Price</span>
                </div>

                <div class="highlight-divider"></div>

                <div class="highlight-item">
                    <span class="highlight-number">2025</span>
                    <span class="highlight-label">Est. Year</span>
                </div>

                <div class="highlight-divider"></div>

                <div class="highlight-item">
                    <span class="highlight-number">Taytay</span>
                    <span class="highlight-label">Location</span>
                </div>
            </div>
        </div>
    </section>

    <section class="about-section" id="menu">
        <div class="section-header">
            <div class="section-header-left">
                <span class="section-eyebrow">Our Menu</span>
                <h2>Crafted with<br><span>Passion</span></h2>
            </div>
        </div>

        <div class="feature-grid">
            <div class="feature-card" onclick="openCategoryModal('coffee', 'Coffee')">
                <div class="card-inner">
                    <div class="card-front">
                        <div class="card-icon"><img src="~/images/Coffee.png" alt="Coffee" asp-append-version="true" /></div>
                        <h3>Coffee</h3>
                        <p>Artisan blends brewed to perfection by our expert baristas.</p>
                        <span class="card-tap-hint">Tap to see menu</span>
                    </div>
                </div>
            </div>

            <div class="feature-card" onclick="openCategoryModal('milktea', 'Milktea')">
                <div class="card-inner">
                    <div class="card-front">
                        <div class="card-icon"><img src="/images/MilkTea.png" alt="Milk Tea" asp-append-version="true" /></div>
                        <h3>Milk Tea</h3>
                        <p>Perfectly balanced sweetness with premium tea leaves.</p>
                        <span class="card-tap-hint">Tap to see menu</span>
                    </div>
                </div>
            </div>

            <div class="feature-card" onclick="openCategoryModal('fruittea', 'Fruit Tea')">
                <div class="card-inner">
                    <div class="card-front">
                        <div class="card-icon"><img src="/images/FruitTea.png" alt="Fruit Tea" asp-append-version="true" /></div>
                        <h3>Fruit Tea</h3>
                        <p>Refreshing infusions of real fruit and natural botanicals.</p>
                        <span class="card-tap-hint">Tap to see menu</span>
                    </div>
                </div>
            </div>

            <div class="feature-card" onclick="openCategoryModal('rice', 'Rice Meals')">
                <div class="card-inner">
                    <div class="card-front">
                        <div class="card-icon"><img src="/images/Silog.png" alt="Rice Meals" asp-append-version="true" /></div>
                        <h3>Rice Meals</h3>
                        <p>Hearty, savory meals that provide comfort in every bite.</p>
                        <span class="card-tap-hint">Tap to see menu</span>
                    </div>
                </div>
            </div>

            <div class="feature-card" onclick="openCategoryModal('snacks', 'Snacks & Pasta')">
                <div class="card-inner">
                    <div class="card-front">
                        <div class="card-icon"><img src="/images/Pasta.png" alt="Pasta & Snacks" asp-append-version="true" /></div>
                        <h3>Pasta & Snacks</h3>
                        <p>Classic favorites reimagined for your mid-day escape.</p>
                        <span class="card-tap-hint">Tap to see menu</span>
                    </div>
                </div>
            </div>

            <div class="feature-card" onclick="openCategoryModal('pastry', 'Bread & Pastry')">
                <div class="card-inner">
                    <div class="card-front">
                        <div class="card-icon"><img src="/images/Bread.png" alt="Bread & Pastries" /></div>
                        <h3>Bread & Pastries</h3>
                        <p>Baked fresh daily with high-quality, local ingredients.</p>
                        <span class="card-tap-hint">Tap to see menu</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="contact-section">
