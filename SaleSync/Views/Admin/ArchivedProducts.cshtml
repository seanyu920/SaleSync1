@model SaleSync.Models.ArchiveViewModel
@{
    Layout = null;
    bool isManager = User.IsInRole("Manager");
    string homeController = isManager ? "Manager" : "Admin";
    string displayRole = isManager ? "Manager" : "Admin";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
@inject SaleSync.Services.StoreSettingsService StoreSettings
@{
    var store = StoreSettings.GetSettings();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Archive - @store.StoreName</title>

    <!-- FontAwesome Library for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" type="image/jpeg" href="~/images/CaferoLogo.jpg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ArchivedProducts.css" asp-append-version="true" />
    <partial name="_ThemeStyles" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="dashboard-container">

        <aside class="sidebar">
            <div>
                <div class="logo-section">
                    <div class="logo-title">@store.StoreName</div>
                    <div class="logo-subtitle">@store.StoreTagline</div>
                </div>

                <div class="profile-section">
                    <div class="profile-circle">👤</div>
                    <div>
                        <h2 class="admin-name">@(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "User")</h2>
                        <div class="admin-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</div>
                    </div>
                </div>

                <nav class="sidebar-menu">
                    <a href="/@homeController/Dashboard" class="menu-btn @(currentAction == "Dashboard" ? "active" : "")">
                        Dashboard
                    </a>
                    <a href="/Admin/QueueOrder" class="menu-btn @(currentAction == "QueueOrder" ? "active" : "")">Queue</a>
                    <a href="/Promotions" class="menu-btn">Promotions</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ActivityLog" class="menu-btn @(currentAction == "ActivityLog" ? "active" : "")">
                            Activity Log
                        </a>
                    }

                    <a href="/Admin/Analytics" class="menu-btn @(currentAction == "Analytics" ? "active" : "")">
                        Analytics
                    </a>

                    <a href="/Admin/Products" class="menu-btn @(currentAction == "Products" ? "active" : "")">
                        Products
                    </a>

                    <a href="/Admin/Inventory" class="menu-btn @(currentAction == "Inventory" ? "active" : "")">
                        Inventory
                    </a>

                    <a href="/Admin/ArchivedProducts" class="menu-btn @(currentAction == "ArchivedProducts" || currentAction == "Archive" ? "active" : "")">
                        Archived
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ManageAccounts" class="menu-btn @(currentAction == "ManageAccounts" ? "active" : "")">
                            Accounts
                        </a>
                    }
                    <a href="/Admin/WebCustomization" class="menu-btn @(currentAction == "WebCustomization" ? "active" : "")">Customization</a>
                </nav>
            </div>

            <div class="logout-section">
                <form method="post" action="/Home/Logout" id="logoutForm">
                    <button type="button" class="menu-btn logout-btn" onclick="confirmLogout()">
                        Log Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

        <div class="mobile-header">
            <button class="hamburger-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
            <div class="mobile-brand">Cafero</div>
        </div>

        <main class="main-content slide-up">
            <div class="page-header">
                <div>
                    <h1 class="greeting-title">Archive</h1>
                    <p class="greeting-subtitle widget-subtitle">Archived categories, menu items and ingredients. Restore them to bring them back to the POS and your stock levels.</p>
                </div>
            </div>

            <!-- ============================ CATEGORIES ============================ -->
            <h2 class="section-divider-title">Archived Categories</h2>
            <div class="table-card">
                <div class="table-responsive">
                    <table class="item-table">
                        <thead>
                            <tr>
                                <th class="col-id">ID</th>
                                <th>Category</th>
                                <th>Menu Items</th>
                                <th>Status</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ArchivedCategories != null && Model.ArchivedCategories.Any())
                            {
                                foreach (var cat in Model.ArchivedCategories)
                                {
                                    <tr>
                                        <td><span class="archive-id">#@cat.CategoryId</span></td>
                                        <td><span class="archive-chip">@cat.CategoryName</span></td>
                                        <td class="archive-strong">@cat.ItemCount @(cat.ItemCount == 1 ? "item" : "items")</td>
                                        <td><span class="status-badge-archived">Archived</span></td>
                                        <td class="col-action">
                                            <button type="button" class="restore-btn"
                                                    data-restore="category"
                                                    data-id="@cat.CategoryId"
                                                    data-name="@cat.CategoryName">
                                                <i class="fa-solid fa-rotate-left"></i> Restore
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="archive-empty">
                                        <i class="fa-solid fa-box-archive"></i>
                                        No archived categories.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ============================ MENU ITEMS ============================ -->
            <h2 class="section-divider-title">Archived Menu Items</h2>
            <div class="table-card">
                <div class="table-responsive">
                    <table class="item-table">
                        <thead>
                            <tr>
                                <th class="col-id">ID</th>
                                <th>Category</th>
                                <th>Product Name</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ArchivedProducts != null && Model.ArchivedProducts.Any())
                            {
                                foreach (var item in Model.ArchivedProducts)
                                {
                                    <tr>
                                        <td><span class="archive-id">#@item.ProductId</span></td>
                                        <td><span class="archive-chip">@item.CategoryName</span></td>
                                        <td class="archive-name">@item.ProductName</td>
                                        <td class="archive-price">₱@item.Price.ToString("0.00")</td>
                                        <td><span class="status-badge-archived">Archived</span></td>
                                        <td class="col-action">
                                            <button type="button" class="restore-btn"
                                                    data-restore="item"
                                                    data-id="@item.ProductId"
                                                    data-name="@item.ProductName">
                                                <i class="fa-solid fa-rotate-left"></i> Restore
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="archive-empty">
                                        <i class="fa-solid fa-box-archive"></i>
                                        No archived menu items.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ============================ INGREDIENTS ============================ -->
            <h2 class="section-divider-title">Archived Inventory Ingredients</h2>
            <div class="table-card">
                <div class="table-responsive">
                    <table class="item-table">
                        <thead>
                            <tr>
                                <th class="col-id">ID</th>
                                <th>Category</th>
                                <th>Ingredient Name</th>
                                <th>Last Cost</th>
                                <th>Remaining Stock</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ArchivedIngredients != null && Model.ArchivedIngredients.Any())
                            {
                                foreach (var item in Model.ArchivedIngredients)
                                {
                                    <tr>
                                        <td><span class="archive-id">#@item.ProductId</span></td>
                                        <td><span class="archive-chip">@item.ItemCategory</span></td>
                                        <td class="archive-name">@item.ItemName</td>
                                        <td class="archive-price">₱@item.PurchasePrice.ToString("0.00")</td>
                                        <td class="archive-strong">@item.Quantity.ToString("0.##") @item.Unit</td>
                                        <td class="col-action">
                                            <button type="button" class="restore-btn"
                                                    data-restore="ingredient"
                                                    data-id="@item.ProductId"
                                                    data-name="@item.ItemName">
                                                <i class="fa-solid fa-rotate-left"></i> Restore
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="archive-empty">
                                        <i class="fa-solid fa-box-archive"></i>
                                        No archived ingredients.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script>
        function confirmLogout() {
            Swal.fire({
                title: 'Are you sure?',
                text: 'You will be logged out of your session.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, log out',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        }

        // ------------------------------------------------------------------
        // Restore buttons (categories, menu items, ingredients)
        // Each button carries data-restore / data-id / data-name, so no names
        // are ever pasted into inline JavaScript.
        // ------------------------------------------------------------------
        const restoreConfig = {
            category: {
                endpoint: '/Admin/RestoreCategory',
                confirmTitle: 'Restore Category?',
                confirmText: name => `"${name}" will return to the Products page and the POS, together with the menu items that were archived with it.`,
                confirmButton: 'Yes, restore category',
                successTitle: 'Category Restored',
                successText: name => `${name} is back on the Products page and the POS.`,
                errorTitle: 'Cannot Restore Category'
            },
            item: {
                endpoint: '/Admin/RestoreMenuItem',
                confirmTitle: 'Restore Menu Item?',
                confirmText: name => `"${name}" will return to the Products page and the POS.`,
                confirmButton: 'Yes, restore item',
                successTitle: 'Menu Item Restored',
                successText: name => `${name} is back on the Products page and the POS.`,
                errorTitle: 'Cannot Restore Item'
            },
            ingredient: {
                endpoint: '/Admin/RestoreInventoryItem',
                confirmTitle: 'Restore Ingredient?',
                confirmText: name => `"${name}" will return to Inventory and count toward your stock levels and recipe deductions again.`,
                confirmButton: 'Yes, restore ingredient',
                successTitle: 'Ingredient Restored',
                successText: name => `${name} is back in Inventory.`,
                errorTitle: 'Cannot Restore Ingredient'
            }
        };

        // The server answers with either JSON ({ message }) or plain text.
        async function readError(res, fallback) {
            try {
                const text = await res.text();
                if (!text) return fallback;
                try {
                    const data = JSON.parse(text);
                    if (data && data.message) return data.message;
                } catch (e) { /* not JSON */ }
                return text.length < 300 ? text : fallback;
            } catch (e) {
                return fallback;
            }
        }

        function restoreRecord(button) {
            const cfg = restoreConfig[button.dataset.restore];
            if (!cfg) return;

            const id = parseInt(button.dataset.id, 10);
            const name = button.dataset.name;

            Swal.fire({
                title: cfg.confirmTitle,
                text: cfg.confirmText(name),
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: cfg.confirmButton,
                cancelButtonText: 'Cancel'
            }).then(result => {
                if (!result.isConfirmed) return;

                button.disabled = true; // stop double clicks while the request runs

                fetch(cfg.endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(id)
                }).then(async res => {
                    if (res.ok) {
                        Swal.fire({
                            title: cfg.successTitle,
                            text: cfg.successText(name),
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        button.disabled = false;
                        const message = await readError(res, 'Something went wrong. Please try again.');
                        Swal.fire(cfg.errorTitle, message, 'error');
                    }
                }).catch(() => {
                    button.disabled = false;
                    Swal.fire('Network Error', 'Unable to reach the server. Please try again.', 'error');
                });
            });
        }

        document.addEventListener('click', function (event) {
            const button = event.target.closest('.restore-btn');
            if (button && !button.disabled) {
                restoreRecord(button);
            }
        });

        // Safe toggle logic for mobile sidebar
        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.sidebar-overlay');

            if (sidebar) {
                sidebar.classList.toggle('mobile-open');
            }
            if (overlay) {
                overlay.classList.toggle('mobile-open');
            }
        }

        // Close sidebar when clicking outside on mobile screen
        document.addEventListener('click', function (event) {
            const sidebar = document.querySelector('.sidebar');
            const hamburger = document.querySelector('.hamburger-btn');

            if (sidebar && hamburger) {
                if (sidebar.classList.contains('mobile-open') &&
                    !sidebar.contains(event.target) &&
                    !hamburger.contains(event.target)) {

                    sidebar.classList.remove('mobile-open');
                }
            }
        });
    </script>
</body>
</html>
