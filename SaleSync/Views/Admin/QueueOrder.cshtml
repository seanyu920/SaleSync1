@model List<SaleHistoryItem>
@{
    ViewData["Title"] = "Queue Orders";
    Layout = null;
    bool isManager = User.IsInRole("Manager");
    string displayRole = isManager ? "Manager" : "Admin";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "QueueOrder";
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}
@inject SaleSync.Services.StoreSettingsService StoreSettings
@inject SaleSync.Services.PaymentVerificationService PaymentVerification
@{
    var store = StoreSettings.GetSettings();

    // GCash / Maya orders whose receipt still has to be checked by staff.
    var awaitingPayments = PaymentVerification.GetAwaiting();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafero</title>

    <!-- Framework Requirements matching your setup -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/QueueOrder.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/PaymentVerification.css" asp-append-version="true" />
    <partial name="_ThemeStyles" />
    <link rel="icon" type="image/jpeg" href="~/images/CaferoLogo.jpg" asp-append-version="true" />
    <!-- SweetAlert2 Library for Elegant Dark-Themed Popups -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="dashboard-container">

        <!-- Sidebar Panel Component -->
        <aside class="sidebar">
            <div>
                <div class="logo-section">
                    <div class="logo-title">@store.StoreName</div>
                    <div class="logo-subtitle">@store.StoreTagline</div>
                </div>

                <div class="profile-section">
                    <div class="profile-circle">👤</div>
                    <div>
                        <h2 class="admin-name">@(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "User")</h2>
                        <div class="admin-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</div>
                    </div>
                </div>

                <nav class="sidebar-menu">
                    <a href="@(isAdminOrManager ? Url.Action("Dashboard", "Admin") : Url.Action("Dashboard", "Cashier"))" class="menu-btn @(currentAction == "Dashboard" ? "active" : "")">
                        Dashboard
                    </a>

                    @if (User.IsInRole("Cashier"))
                        {
                        <a href="@Url.Action("CashierMenu", "Cashier")" class="menu-btn @(currentAction == "CashierMenu" || currentAction == "CashierMenu" ? "active" : "")">
                            POS
                        </a>
                        }

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Cashier"))
                    {
                        <a href="@Url.Action("QueueOrder", "Admin")" class="menu-btn @(currentAction == "QueueOrder" || currentAction == "QueueOrders" ? "active" : "")">
                            Queue
                        </a>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a href="@Url.Action("Index", "Promotions")" class="menu-btn @(currentAction == "Promos" || currentAction == "Promos" ? "active" : "")">
                            Promotions
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("ActivityLog", "Admin")" class="menu-btn @(currentAction == "ActivityLog" ? "active" : "")">
                            Activity Log
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a href="@Url.Action("Analytics", "Admin")" class="menu-btn @(currentAction == "Analytics" ? "active" : "")">
                            Analytics
                        </a>

                        <a href="@Url.Action("Products", "Admin")" class="menu-btn @(currentAction == "Products" ? "active" : "")">
                            Products
                        </a>

                        <a href="@Url.Action("Inventory", "Admin")" class="menu-btn @(currentAction == "Inventory" ? "active" : "")">
                            Inventory
                        </a>

                        <a href="@Url.Action("ArchivedProducts", "Admin")" class="menu-btn @(currentAction == "ArchivedProducts" || currentAction == "Archive" ? "active" : "")">
                            Archived
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("ManageAccounts", "Admin")" class="menu-btn @(currentAction == "ManageAccounts" ? "active" : "")">
                            Accounts
                        </a>
                    }
                    @if (isAdminOrManager)
                    {
                        <a href="@Url.Action("WebCustomization", "Admin")" class="menu-btn @(currentAction == "WebCustomization" ? "active" : "")">
                            Customization
                        </a>
                    }
                </nav>
            </div>

            <div class="logout-section">
                <form method="post" action="@Url.Action("Logout", "Home")" id="logoutForm">
                    <button type="button" class="menu-btn logout-btn" onclick="confirmLogout()">
                        Log Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

        <div class="mobile-header">
            <button class="hamburger-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
            <div class="mobile-brand">Cafero</div>
        </div>

        <!-- Main Workspace Grid -->
        <main class="main-content slide-up">
            <div class="queue-header">
                <div>
                    <h1>Live Production Queue</h1>
                    <p>Orders sorted oldest to newest. Complete orders to trigger automated ingredient level deductions.</p>
                </div>
                <div class="queue-stats">
                    @if (awaitingPayments.Count > 0)
                    {
                        <span class="stat-badge pv-stat-badge">Awaiting payment: @awaitingPayments.Count</span>
                    }
                    <span class="stat-badge badge-pending">Pending: @Model.Count(o => o.Status == "Pending")</span>
                    <span class="stat-badge badge-preparing">Preparing: @Model.Count(o => o.Status == "Preparing" || o.Status == "Processing")</span>
                </div>
            </div>

            @if (awaitingPayments.Count > 0)
            {
                <section class="pv-panel" id="paymentVerificationPanel">
                    <div class="pv-header">
                        <h2>
                            <i class="fas fa-shield-alt"></i> Payments awaiting verification
                            <span class="pv-count">@awaitingPayments.Count</span>
                        </h2>
                        <p>These GCash / Maya orders are not in the kitchen queue yet. Check each receipt against the café's own account, then confirm or reject it.</p>
                    </div>

                    <div class="pv-grid">
                        @foreach (var pay in awaitingPayments)
                        {
                            <div class="pv-card" data-proof-id="@pay.ProofId">
                                <div class="pv-card-top">
                                    <span class="pv-order-id">#ORD-@pay.SaleId</span>
                                    <span class="pv-method">@pay.PaymentMethod</span>
                                </div>

                                <div>
                                    <div class="pv-customer">@pay.CustomerName</div>
                                    <div class="pv-sub">@pay.OrderType &middot; sent @pay.SubmittedAt.ToString("MMM d, hh:mm tt")</div>
                                </div>

                                <div class="pv-items">@pay.ItemsSummary</div>

                                <div class="pv-facts">
                                    <div class="pv-fact">
                                        <span>Amount due</span>
                                        <strong>₱@pay.AmountDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</strong>
                                    </div>
                                    <div class="pv-fact">
                                        <span>Reference no.</span>
                                        <strong>@pay.DisplayReference</strong>
                                    </div>
                                </div>

                                <button type="button" class="pv-review-btn"
                                        data-proof-id="@pay.ProofId"
                                        data-sale-id="@pay.SaleId"
                                        data-method="@pay.PaymentMethod"
                                        data-customer="@pay.CustomerName"
                                        data-amount="@pay.AmountDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                        data-reference="@pay.DisplayReference"
                                        onclick="openReceiptModal(this)">
                                    <i class="fas fa-search"></i> Review receipt
                                </button>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center" style="padding: 60px; background: #1a1d1b; border: 1px dashed #3a3d3b; border-radius: 12px; margin-top: 30px;">
                    <i class="fas fa-check-circle text-success" style="font-size: 54px; margin-bottom: 15px;"></i>
                    <h3 style="color: #fff; margin-bottom: 5px;">All caught up!</h3>
                    <p style="color: #a0a5a1; margin: 0;">There are no active orders inside the production pipeline right now.</p>
                </div>
            }
            else
            {
                <div class="queue-grid">
                    @foreach (var order in Model)
                    {
                        <div class="queue-card status-@order.Status" data-sale-id="@order.SaleId">
                            <div>
                                <div class="card-header-info">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <span class="order-id">#ORD-@order.SaleId</span>

                                        @{
                                            string badgeClass = "badge-q-default";
                                            string iconClass = "fas fa-clock";
                                            string currentStatus = order.Status ?? "Pending";

                                            switch (currentStatus)
                                            {
                                                case "Pending":
                                                    badgeClass = "badge-q-pending";
                                                    iconClass = "fas fa-hourglass-half animate-pulse";
                                                    break;
                                                case "Preparing":
                                                case "Processing":
                                                    badgeClass = "badge-q-preparing";
                                                    iconClass = "fas fa-mug-hot";
                                                    break;
                                                case "Delivery":
                                                case "Out for Delivery":
                                                    badgeClass = "badge-q-delivery";
                                                    iconClass = "fas fa-shipping-fast";
                                                    break;
                                                case "Completed":
                                                case "Done":
                                                    badgeClass = "badge-q-done";
                                                    iconClass = "fas fa-check-double";
                                                    break;
                                            }
                                        }
                                        <span class="badge-q @badgeClass">
                                            <i class="@iconClass"></i> @currentStatus
                                        </span>
                                    </div>
                                    <span class="order-time"><i class="far fa-clock"></i> @order.SaleDate.ToString("hh:mm tt")</span>
                                </div>

                                <h3 class="customer-name">
                                    @(string.IsNullOrEmpty(order.CustomerName) ? "Walk-In Customer" : order.CustomerName)
                                </h3>

                                <div class="order-meta">
                                    <span class="meta-tag"><i class="fas fa-utensils"></i> @(order.OrderType ?? "Dine-In")</span>
                                    <span class="meta-tag"><i class="fas fa-wallet"></i> @(order.PaymentMethod ?? "Cash")</span>
                                    <span class="meta-tag"><i class="fas fa-receipt"></i> ₱@order.TotalAmount.ToString("0.00")</span>
                                    @if (string.Equals(order.OrderType, "Pick-up", StringComparison.OrdinalIgnoreCase) && order.PickupTime.HasValue)
                                     {
                                     <span class="meta-tag"><i class="fas fa-clock"></i> Pick-up: @order.PickupTime.Value.ToString("MMM d, hh:mm tt")</span>
                                        }
                                   </div>

                                @if (order.Items != null && order.Items.Count > 0)
                                {
                                    <ul class="queue-items">
                                        @foreach (var line in order.Items)
                                        {
                                            <li>
                                                <span class="qi-name">
                                                    @line.Quantity&times; @line.Name
                                                    @if (!string.IsNullOrWhiteSpace(line.Size) && line.Size != "Regular")
                                                    {
                                                        <span class="qi-size">@line.Size</span>
                                                    }
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(line.Notes))
                                                {
                                                    <span class="qi-notes"><i class="fas fa-sticky-note"></i> @line.Notes</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>

                            <div class="card-actions">
                                <button class="btn-action btn-view" onclick="openDetailsModal(@order.SaleId)">
                                    <i class="fas fa-eye"></i> Details
                                </button>

                                @if (order.Status == "Pending")
                                {
                                    <button class="btn-action btn-start" onclick="promptPrepare(@order.SaleId)">
                                        <i class="fas fa-coffee"></i> Prepare
                                    </button>
                                }
                                else if (order.Status == "Preparing" || order.Status == "Processing")
                                {
                                    <button class="btn-action btn-complete" onclick="promptPreparingOptions(@order.SaleId, '@(order.OrderType ?? "Dine-In")')">
                                        <i class="fas fa-spinner fa-spin"></i> Preparing
                                    </button>
                                }
                                else if (order.Status == "Out for Delivery" || order.Status == "Delivery")
                                {
                                    <button class="btn-action btn-complete" onclick="promptDeliveryComplete(@order.SaleId)" style="background-color: #2eb872;">
                                        <i class="fas fa-shipping-fast"></i> Complete Delivery
                                    </button>
                                }

                                <button class="btn-action btn-void" onclick="openVoidModal(@order.SaleId)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>

    <!-- Order Details Modal -->
    <div id="detailsModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalOrderTitle" style="margin:0; font-weight:700;">Order Breakdown</h3>
                <button class="modal-close" onclick="closeModal('detailsModal')">&times;</button>
            </div>
            <div>
                <h4 style="margin: 0 0 10px 0; color: #ffffff;">Menu Items Ordered</h4>
                <ul id="modalItemsList" class="list-group"></ul>

                <h4 style="margin: 20px 0 10px 0; color: #ffffff;">Deductible Ingredients Profile</h4>
                <ul id="modalIngredientsList" class="list-group" style="color: #a0a5a1;"></ul>
            </div>
        </div>
    </div>

    <!-- GCash / Maya Receipt Review Modal -->
    <div id="pvModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 560px; max-height: 92vh; overflow: auto;">
            <div class="modal-header">
                <h3 id="pvTitle" style="margin:0; font-weight:700;">Check payment</h3>
                <button class="modal-close" onclick="closePvModal()">&times;</button>
            </div>
            <div class="pv-modal-body">
                <div class="pv-facts">
                    <div class="pv-fact">
                        <span>Amount due</span>
                        <strong id="pvAmount"></strong>
                    </div>
                    <div class="pv-fact">
                        <span>Reference no.</span>
                        <strong id="pvRef"></strong>
                    </div>
                </div>

                <div class="pv-sub">Customer: <span id="pvCustomer"></span> &middot; Paid via <span id="pvMethod"></span></div>

                <div class="pv-receipt-frame">
                    <img id="pvImage" alt="Customer payment receipt" />
                </div>

                <p class="pv-check-note">
                    Open the caf&eacute;'s own GCash / Maya account and check that a payment with this exact
                    <strong>amount</strong> and <strong>reference number</strong> was received. Don't rely on the picture
                    alone &mdash; screenshots can be edited.
                </p>

                <div class="pv-modal-actions">
                    <button type="button" id="pvRejectBtn" class="pv-reject-btn" onclick="pvReject()">
                        <i class="fas fa-times"></i> Reject
                    </button>
                    <button type="button" id="pvConfirmBtn" class="pv-confirm-btn" onclick="pvConfirm()">
                        <i class="fas fa-check"></i> Payment received
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Secure Void Override Prompt Modal -->
    <div id="voidModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h3 style="margin:0; font-weight:700;">Authorize Order Void</h3>
                <button class="modal-close" onclick="closeModal('voidModal')">&times;</button>
            </div>
            <div>
                <p style="margin:0 0 12px 0; color:#a0a5a1; font-size:14px; line-height:1.5;">Please input your manager account credentials to authorize voiding ticket <strong id="voidTargetLabel" style="color:#ffc107;"></strong>.</p>
                <input type="hidden" id="voidSaleId" />
                <input type="password" id="managerPassword" class="form-control" placeholder="Enter administrative password" />
                <div style="display:flex; gap:10px; margin-top:20px;">
                    <button class="btn-action btn-view" onclick="closeModal('voidModal')" style="flex:1;">Cancel</button>
                    <button class="btn-action btn-void" onclick="submitVoid()" style="flex:1; width:auto; font-weight:700;">Confirm Override</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Script Controllers using SweetAlert2 -->
    <script>
        function confirmLogout() {
        Swal.fire({
        title: 'Are you sure?',
        text: "You will be logged out of your session.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, log out',
        cancelButtonText: 'Cancel'
        }).then((result) => {
        if (result.isConfirmed) {
        document.getElementById('logoutForm').submit();
        }
        });
        }

        function promptPrepare(saleId) {
        Swal.fire({
        title: 'Prepare Order?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#5a5e5b',
        confirmButtonText: 'Yes',
        cancelButtonText: 'Cancel',
        background: '#1e201f',
        color: '#ffffff'
        }).then((result) => {
        if (result.isConfirmed) {
        updateStatus(saleId, 'Preparing');
        }
        });
        }

        function promptPreparingOptions(saleId, orderType) {
        const isDelivery = orderType && orderType.toLowerCase().includes('delivery');

        Swal.fire({
        title: isDelivery ? 'Dispatch Order?' : 'Complete Order?',
        text: isDelivery ? 'Mark this order as out for delivery.' : 'Mark this order as fulfilled and completed.',
        icon: 'info',
        showCancelButton: true,
        confirmButtonColor: '#2eb872',
        cancelButtonColor: '#5a5e5b',
        confirmButtonText: isDelivery ? 'Dispatch for Delivery' : 'Complete Order',
        cancelButtonText: 'Cancel',
        background: '#1e201f',
        color: '#ffffff'
        }).then((result) => {
        if (result.isConfirmed) {
        const nextStatus = isDelivery ? 'Out for Delivery' : 'Completed';
        updateStatus(saleId, nextStatus);
        }
        });
        }

        function promptDeliveryComplete(saleId) {
        Swal.fire({
        title: 'Order Delivered?',
        text: 'Confirm that this order has reached the customer safely.',
        icon: 'success',
        showCancelButton: true,
        confirmButtonColor: '#2eb872',
        cancelButtonColor: '#5a5e5b',
        confirmButtonText: 'Yes, Delivered',
        cancelButtonText: 'Cancel',
        background: '#1e201f',
        color: '#ffffff'
        }).then((result) => {
        if (result.isConfirmed) {
        updateStatus(saleId, 'Completed');
        }
        });
        }

        async function updateStatus(saleId, targetStatus) {
        try {
        const res = await fetch('@Url.Action("UpdateSaleStatus", "Admin")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ saleId: saleId, status: targetStatus })
        });

        if (res.ok) {
        let alertTitle = 'Order Completed';
        let alertText = `Order #ORD-${saleId} has been successfully fulfilled.`;

        if (targetStatus === 'Preparing') {
        alertTitle = 'Order Started';
        alertText = `Order #ORD-${saleId} is now being prepared.`;
        } else if (targetStatus === 'Out for Delivery') {
        alertTitle = 'Dispatched';
        alertText = `Order #ORD-${saleId} is now out with the courier.`;
        }

        await Swal.fire({
        icon: 'success',
        title: alertTitle,
        text: alertText,
        background: '#1e201f',
        color: '#ffffff',
        timer: 1500,
        showConfirmButton: false
        });
        location.reload();
        } else {
        let serverErrorMessage = 'Could not update the order status.';
        try {
        const errorData = await res.json();
        if (errorData && errorData.message) {
        serverErrorMessage = errorData.message;
        }
        } catch (jsonErr) {}

        Swal.fire({
        icon: 'error',
        title: 'Update Failed',
        text: serverErrorMessage,
        background: '#1e201f',
        color: '#ffffff',
        confirmButtonColor: '#dc3545'
        });
        }
        } catch (err) {
        console.error('Status Error:', err);
        Swal.fire({
        icon: 'error',
        title: 'Network Error',
        text: 'Failed to communicate with the server infrastructure.',
        background: '#1e201f',
        color: '#ffffff',
        confirmButtonColor: '#dc3545'
        });
        }
        }

        async function openDetailsModal(saleId) {
        try {
        document.getElementById('modalOrderTitle').innerText = `Order Details: #ORD-${saleId}`;
        const itemsList = document.getElementById('modalItemsList');
        const ingList = document.getElementById('modalIngredientsList');

        itemsList.innerHTML = '<li>Loading production lists...</li>';
        ingList.innerHTML = '<li>Calculating inventory weights...</li>';
        document.getElementById('detailsModal').style.display = 'flex';

        const res = await fetch(`@Url.Action("GetOrderDetails", "Admin")?saleId=${saleId}`);
        if (!res.ok) throw new Error('Server returned error status');

        const data = await res.json();
        itemsList.innerHTML = '';
        ingList.innerHTML = '';

        function escapeQueueHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        if (data.items && data.items.length > 0) {
        let runningTotal = 0;
        data.items.forEach(i => {
        const label = typeof i === 'string' ? i : i.name;
        const note = (typeof i === 'object' && i.notes) ? i.notes : null;
        const subtotal = (typeof i === 'object' && typeof i.subtotal === 'number') ? i.subtotal : null;
        const noteHtml = note ? `<div style="font-size:12px; color:#C9A84C; margin:2px 0 8px 24px;">📝 ${escapeQueueHtml(note)}</div>` : '';
        const priceHtml = subtotal !== null ? `<span style="float:right; color:#C9A84C; font-weight:600;">₱${subtotal.toFixed(2)}</span>` : '';

        if (subtotal !== null) runningTotal += subtotal;

        itemsList.innerHTML += `<li><i class="fas fa-shopping-basket" style="color:#888e8a; margin-right:8px;"></i> ${escapeQueueHtml(label)}${priceHtml}</li>${noteHtml}`;
        });

        if (runningTotal > 0) {
        itemsList.innerHTML += `<li style="border-top:1px solid #3a3d3b; margin-top:8px; padding-top:8px; font-weight:700;">Total<span style="float:right; color:#C9A84C;">₱${runningTotal.toFixed(2)}</span></li>`;
            }
        }
        else {
        itemsList.innerHTML = '<li>No menu items found for this record.</li>';
        }

        if (data.ingredients && data.ingredients.length > 0) {
        data.ingredients.forEach(i => ingList.innerHTML += `<li><i class="fas fa-leaf" style="color:#3dbf78; margin-right:8px;"></i> ${i}</li>`);
        } else {
        ingList.innerHTML = '<li>No recipe tracking parameters needed for this order configuration.</li>';
        }
        } catch (err) {
        console.error('Data Pull Error:', err);
        closeModal('detailsModal');
        Swal.fire({
        icon: 'error',
        title: 'Fetch Failed',
        text: 'Unable to query recipe item information parameters.',
        background: '#1e201f',
        color: '#ffffff',
        confirmButtonColor: '#dc3545'
        });
        }
        }

        function openVoidModal(saleId) {
        document.getElementById('voidSaleId').value = saleId;
        document.getElementById('voidTargetLabel').innerText = `#ORD-${saleId}`;
        document.getElementById('managerPassword').value = '';
        document.getElementById('voidModal').style.display = 'flex';
        }

        async function submitVoid() {
        const saleId = parseInt(document.getElementById('voidSaleId').value);
        const pass = document.getElementById('managerPassword').value;

        if (!pass) {
        Swal.fire({
        icon: 'warning',
        title: 'Access Denied',
        text: 'Management clearance passphrase required.',
        background: '#1e201f',
        color: '#ffffff',
        confirmButtonColor: '#ffc107'
        });
        return;
        }

        try {
        const res = await fetch('@Url.Action("VerifyAndVoid", "Admin")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ saleId: saleId, pass: pass })
        });

        if (res.ok) {
        closeModal('voidModal');
        await Swal.fire({
        icon: 'success',
        title: 'Ticket Voided',
        text: `Order #ORD-${saleId} has been successfully canceled.`,
        background: '#1e201f',
        color: '#ffffff',
        timer: 1500,
        showConfirmButton: false
        });
        location.reload();
        } else {
        let errorMessage = 'An unexpected system error occurred.';
        if (res.status === 401) {
        errorMessage = 'Invalid management credentials. Override denied.';
        } else {
        try {
        const errorData = await res.json();
        if (errorData && errorData.message) errorMessage = errorData.message;
        } catch (e) {}
        }

        Swal.fire({
        icon: 'error',
        title: res.status === 401 ? 'Unauthorized' : 'System Error',
        text: errorMessage,
        background: '#1e201f',
        color: '#ffffff',
        confirmButtonColor: '#dc3545'
        });
        }
        } catch (err) {
        console.error('Void Error Tracker:', err);
        Swal.fire({
        icon: 'error',
        title: 'Network Error',
        text: 'Failed to securely connect to authorization terminal.',
        background: '#1e201f',
        color: '#ffffff',
        confirmButtonColor: '#dc3545'
        });
        }
        }

        // ── GCash / Maya receipt checking ──────────────────────────────────────────
        const pvUrls = {
            receipt: '@Url.Action("Receipt", "PaymentVerification")',
            confirm: '@Url.Action("Confirm", "PaymentVerification")',
            reject: '@Url.Action("Reject", "PaymentVerification")',
            count: '@Url.Action("Count", "PaymentVerification")'
        };
        const pvInitialCount = @awaitingPayments.Count;
        let pvCurrent = null;

        function openReceiptModal(btn) {
            const d = btn.dataset;
            pvCurrent = { proofId: parseInt(d.proofId, 10), saleId: d.saleId };

            document.getElementById('pvTitle').textContent = 'Check payment: #ORD-' + d.saleId;
            document.getElementById('pvAmount').textContent = '₱' + Number(d.amount).toFixed(2);
            document.getElementById('pvRef').textContent = d.reference;
            document.getElementById('pvCustomer').textContent = d.customer;
            document.getElementById('pvMethod').textContent = d.method;
            document.getElementById('pvImage').src = pvUrls.receipt + '?id=' + encodeURIComponent(d.proofId);
            document.getElementById('pvConfirmBtn').disabled = false;
            document.getElementById('pvRejectBtn').disabled = false;
            document.getElementById('pvModal').style.display = 'flex';
        }

        function closePvModal() {
            document.getElementById('pvModal').style.display = 'none';
            document.getElementById('pvImage').removeAttribute('src');
            pvCurrent = null;
        }

        async function pvConfirm() {
            if (!pvCurrent) return;

            const answer = await Swal.fire({
                title: 'Payment received?',
                text: 'Order #ORD-' + pvCurrent.saleId + ' will go to the kitchen queue.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2eb872',
                cancelButtonColor: '#5a5e5b',
                confirmButtonText: 'Yes, I checked it',
                cancelButtonText: 'Not yet',
                background: '#1e201f',
                color: '#ffffff'
            });

            if (!answer.isConfirmed) return;
            await pvSend(pvUrls.confirm, { proofId: pvCurrent.proofId });
        }

        async function pvReject() {
            if (!pvCurrent) return;

            const answer = await Swal.fire({
                title: 'Reject this payment?',
                text: 'Order #ORD-' + pvCurrent.saleId + ' will be cancelled.',
                icon: 'warning',
                input: 'text',
                inputLabel: 'Reason (the customer will see this)',
                inputPlaceholder: 'e.g. Amount does not match / reference number not found',
                showCancelButton: true,
                confirmButtonColor: '#c94a4a',
                cancelButtonColor: '#5a5e5b',
                confirmButtonText: 'Reject & cancel order',
                background: '#1e201f',
                color: '#ffffff',
                inputValidator: function (value) {
                    if (!value || value.trim().length < 3) return 'Please type a short reason.';
                    return null;
                }
            });

            if (!answer.isConfirmed) return;
            await pvSend(pvUrls.reject, { proofId: pvCurrent.proofId, reason: answer.value.trim() });
        }

        async function pvSend(url, body) {
            const confirmBtn = document.getElementById('pvConfirmBtn');
            const rejectBtn = document.getElementById('pvRejectBtn');
            confirmBtn.disabled = true;
            rejectBtn.disabled = true;

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                let data = {};
                try { data = await res.json(); } catch (e) { }

                if (res.ok) {
                    closePvModal();
                    await Swal.fire({
                        icon: 'success',
                        title: 'Done',
                        text: data.message || 'Saved.',
                        background: '#1e201f',
                        color: '#ffffff',
                        timer: 1600,
                        showConfirmButton: false
                    });
                    location.reload();
                } else {
                    confirmBtn.disabled = false;
                    rejectBtn.disabled = false;
                    await Swal.fire({
                        icon: 'error',
                        title: 'Could not save',
                        text: data.message || 'Something went wrong. Please try again.',
                        background: '#1e201f',
                        color: '#ffffff',
                        confirmButtonColor: '#dc3545'
                    });
                }
            } catch (err) {
                confirmBtn.disabled = false;
                rejectBtn.disabled = false;
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Could not reach the server.',
                    background: '#1e201f',
                    color: '#ffffff',
                    confirmButtonColor: '#dc3545'
                });
            }
        }

        // Every 20 seconds, look for new (or already handled) receipts and refresh the page.
        // It never refreshes while a receipt window or popup is open.
        setInterval(async function () {
            try {
                if (document.getElementById('pvModal').style.display === 'flex') return;
                if (typeof Swal !== 'undefined' && Swal.isVisible()) return;

                const res = await fetch(pvUrls.count, { cache: 'no-store' });
                if (!res.ok) return;

                const data = await res.json();
                if (data.awaiting !== pvInitialCount) location.reload();
            } catch (e) { }
        }, 20000);

        function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
        }

        window.onclick = function(event) {
        if (event.target.classList.contains('modal-overlay')) {
        event.target.style.display = 'none';
        }
        }
        // If arriving from a dashboard notification click (?highlight=123),
        // scroll to that order, flash it, and open its details automatically.
        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const highlightId = params.get('highlight');

            if (!highlightId) return;

            const targetCard = document.querySelector(`.queue-card[data-sale-id="${highlightId}"]`);

            if (!targetCard) {
                Swal.fire({
                    icon: 'info',
                    title: 'Order Not Found',
                    text: `Order #ORD-${highlightId} is no longer in the active queue.`,
                    background: '#1e201f',
                    color: '#ffffff',
                    confirmButtonColor: '#C9A84C'
                });
                return;
            }

            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCard.classList.add('queue-card-highlight');

            setTimeout(() => {
                targetCard.classList.remove('queue-card-highlight');
            }, 3000);

            openDetailsModal(parseInt(highlightId, 10));

            // Clean the URL so refreshing the page doesn't re-trigger the highlight.
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
        });

        // Safe toggle logic for mobile sidebar
        function toggleSidebar() {
        const sidebar = document.querySelector('.sidebar');
        const overlay = document.querySelector('.sidebar-overlay');

        if (sidebar) {
        sidebar.classList.toggle('mobile-open');
        }
        if (overlay) {
        overlay.classList.toggle('mobile-open');
        }
        }

        // Close sidebar when clicking outside on mobile devices
        document.addEventListener('click', function (event) {
        const sidebar = document.querySelector('.sidebar');
        const hamburger = document.querySelector('.hamburger-btn');

        if (sidebar && hamburger) {
        if (sidebar.classList.contains('mobile-open') &&
        !sidebar.contains(event.target) &&
        !hamburger.contains(event.target)) {

        sidebar.classList.remove('mobile-open');
        }
        }
        });
    </script>
</body>
</html>