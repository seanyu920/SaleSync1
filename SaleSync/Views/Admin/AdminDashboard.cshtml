@model SaleSync.Models.CashierDashboardViewModel
@{
    Layout = null;
    string homeController = "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - Cafero</title>
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="icon" type="image/jpeg" href="~/images/CaferoLogo.jpg" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Real-Time Chat SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
</head>
<body>

    <div class="dashboard-container">
        <aside class="sidebar">
            <div>
                <div class="logo-section">
                    <div class="logo-title">Cafèro</div>
                    <div class="logo-subtitle">Coffee & Pastries</div>
                </div>

                <div class="profile-section">
                    <div class="profile-circle">👤</div>
                    <div>
                        <h2 class="admin-name">@(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "User")</h2>
                        <div class="admin-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? User.FindFirst("Role")?.Value ?? "User")</div>
                    </div>
                </div>

                <nav class="sidebar-menu">
                    <a href="/@homeController/Dashboard" class="menu-btn active">Dashboard</a>
                    <a href="/Admin/QueueOrder" class="menu-btn">Queue</a>
                    <a href="/Promotions" class="menu-btn">Promotions</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ActivityLog" class="menu-btn">Activity Log</a>
                    }

                    <a href="/Admin/Analytics" class="menu-btn">Analytics</a>
                    <a href="/Admin/Products" class="menu-btn">Products</a>
                    <a href="/Admin/Inventory" class="menu-btn">Inventory</a>

                    <a href="/Admin/ArchivedProducts" class="menu-btn">Archived</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ManageAccounts" class="menu-btn">Accounts</a>
                    }
                    <a href="/Admin/WebCustomization" class="menu-btn">Customization</a>
                </nav>
            </div>

            <div class="logout-section">
                <form method="post" action="/Home/Logout" id="logoutForm">
                    <button type="button" class="menu-btn logout-btn" onclick="confirmLogout()">
                        Log Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="mobile-header">
            <button class="hamburger-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
            <div class="mobile-brand">Cafèro</div>
        </div>

        <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
        <main class="main-content slide-up">

            <div class="top-navbar">
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" class="search-input" placeholder="Search transactions, products, or inventory..." oninput="globalSearch(this.value)" autocomplete="off" />
                    <div class="search-dropdown" id="searchDropdown"></div>
                </div>
                <div class="top-nav-controls">
                    <div class="datetime-display">
                        <div id="currentDate"></div>
                        <div id="currentTime"></div>
                    </div>
                    <div class="notification-bell" id="notifBell" onclick="goToQueue()" title="View pending orders">
                        <i class="fas fa-bell"></i>
                        <span class="bell-badge" id="bellBadge" style="display:none;"></span>
                    </div>
                    <div class="nav-chat-icon" onclick="toggleChat()" id="chatTrigger" title="Open customer support inbox">
                        <i class="fas fa-comments"></i>
                        <span class="chat-badge" id="chatBadge" style="display: none;"></span>
                    </div>
                </div>
            </div>

            <div class="page-header dashboard-header-card">
                <div>
                    <p class="header-label">Today's Net Sales</p>
                    <h1 class="header-sales-value">₱@Model.TodayTotalSales.ToString("N2")</h1>
                </div>
                <div class="header-status-group">
                    <div class="system-status-container">
                        <p class="status-label">System Status</p>
                        <div class="status-indicator-flex">
                            <span class="status-dot animate-pulse"></span>
                            <span class="status-text">Online & Syncing</span>
                        </div>
                    </div>
                    @{
                        var storeStatus = ViewBag.StoreStatus as SaleSync.Models.StoreStatus;
                    }
                    @if (storeStatus != null)
                    {
                        <div class="system-status-container store-status-container">
                            <p class="status-label">Store Status</p>
                            <div class="status-indicator-flex">
                                <span class="status-dot @(storeStatus.IsOpen ? "store-open-dot" : "store-closed-dot")"></span>
                                <span class="status-text @(storeStatus.IsOpen ? "store-open-text" : "store-closed-text")">@storeStatus.Label · @storeStatus.HoursLabel</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="summary-dashboard">
                <div class="summary-card">
                    <div class="card-icon-box icon-orange"><i class="fas fa-list"></i></div>
                    <div>
                        <div class="card-label">All Transactions</div>
                        <div class="card-value">@(Model.RecentSales?.Count ?? 0)</div>
                    </div>
                </div>

                <div class="summary-card">
                    <div class="card-icon-box icon-green"><i class="fas fa-hourglass-half"></i></div>
                    <div>
                        <div class="card-label">Pending Orders</div>
                        <div class="card-value">@(Model.RecentSales?.Count(s => s.Status == "Pending" || string.IsNullOrEmpty(s.Status)) ?? 0)</div>
                    </div>
                </div>

                <div class="summary-card">
                    <div class="card-icon-box icon-light-orange"><i class="fas fa-check-circle"></i></div>
                    <div>
                        <div class="card-label">Completed Sales</div>
                        <div class="card-value">@Model.TodayTransactionCount</div>
                    </div>
                </div>

                <div class="summary-card">
                    <div class="card-icon-box icon-red"><i class="fas fa-exclamation-triangle"></i></div>
                    <div>
                        <div class="card-label">Low Stock Alerts</div>
                        <div class="card-value">1</div>
                    </div>
                </div>
            </div>

            <div class="pos-grid-container">
                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div>
                            <div class="pos-card-title"><i class="fas fa-chart-line"></i> Sales This Week</div>
                            <div class="weekly-sales-value">
                                ₱@((Model.TodayTotalSales * 5.8m).ToString("N2"))
                            </div>
                        </div>
                        <span class="rolling-label">Past 7 Days Rolling</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="weeklySalesChart"></canvas>
                    </div>
                </div>

                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div class="pos-card-title"><i class="fas fa-history"></i> Recent Transactions</div>
                        <a href="/Admin/DailyReport" class="view-all-link">View All &rarr;</a>
                    </div>

                    <!-- DESKTOP VIEW: Table Structure -->
                    <div class="table-responsive desktop-only">
                        <table class="pos-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentSales != null && Model.RecentSales.Any())
                                {
                                    @foreach (var sale in Model.RecentSales.Take(5))
                                    {
                                        <tr>
                                            <td class="sale-id">#@sale.SaleId</td>
                                            <td>@(sale.CustomerName ?? "Walk-in")</td>
                                            <td>₱@sale.TotalAmount.ToString("N2")</td>
                                            <td>@(sale.PaymentMethod ?? "Cash")</td>
                                            <td>
                                                @if (sale.Status == "Completed")
                                                {
                                                    <span class="badge badge-success">Completed</span>
                                                }
                                                else if (sale.Status == "Cancelled" || sale.Status == "Voided")
                                                {
                                                    <span class="badge badge-danger">Cancelled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Pending</span>
                                                }
                                            </td>
                                            <td class="text-muted">@sale.SaleDate.ToString("hh:mm tt")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td class="sale-id">#8036</td>
                                        <td>Walk-in</td>
                                        <td>₱79.00</td>
                                        <td>Cash</td>
                                        <td><span class="badge badge-warning">Pending</span></td>
                                        <td class="text-muted">07:34 PM</td>
                                    </tr>
                                    <tr>
                                        <td class="sale-id">#8035</td>
                                        <td>Walk-in</td>
                                        <td>₱158.00</td>
                                        <td>GCash</td>
                                        <td><span class="badge badge-success">Completed</span></td>
                                        <td class="text-muted">07:12 PM</td>
                                    </tr>
                                    <tr>
                                        <td class="sale-id">#7036</td>
                                        <td>Juan Dela Cruz</td>
                                        <td>₱89.00</td>
                                        <td>Card</td>
                                        <td><span class="badge badge-success">Completed</span></td>
                                        <td class="text-muted">03:46 PM</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- MOBILE VIEW: Expandable Mobile Cards -->
                    <div class="mobile-tx-list mobile-only">
                        @if (Model.RecentSales != null && Model.RecentSales.Any())
                        {
                            @foreach (var sale in Model.RecentSales.Take(5))
                            {
                                <div class="tx-card">
                                    <div class="tx-card-summary">
                                        <div class="tx-main-info">
                                            <span class="sale-id">#@sale.SaleId</span>
                                            <span class="tx-customer">@(sale.CustomerName ?? "Walk-in")</span>
                                        </div>
                                        <button type="button" class="tx-view-btn" onclick="toggleTxDetails(this)">
                                            View <i class="fas fa-chevron-down"></i>
                                        </button>
                                    </div>
                                    <div class="tx-card-details hidden">
                                        <div class="tx-detail-row">
                                            <span class="tx-label">Total:</span>
                                            <span class="tx-value">₱@sale.TotalAmount.ToString("N2")</span>
                                        </div>
                                        <div class="tx-detail-row">
                                            <span class="tx-label">Method:</span>
                                            <span class="tx-value">@(sale.PaymentMethod ?? "Cash")</span>
                                        </div>
                                        <div class="tx-detail-row">
                                            <span class="tx-label">Status:</span>
                                            <span class="tx-value">
                                                @if (sale.Status == "Completed")
                                                {
                                                    <span class="badge badge-success">Completed</span>
                                                }
                                                else if (sale.Status == "Cancelled" || sale.Status == "Voided")
                                                {
                                                    <span class="badge badge-danger">Cancelled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Pending</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="tx-detail-row">
                                            <span class="tx-label">Time:</span>
                                            <span class="tx-value text-muted">@sale.SaleDate.ToString("hh:mm tt")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Mobile Fallback Card 1 -->
                            <div class="tx-card">
                                <div class="tx-card-summary">
                                    <div class="tx-main-info">
                                        <span class="sale-id">#8036</span>
                                        <span class="tx-customer">Walk-in</span>
                                    </div>
                                    <button type="button" class="tx-view-btn" onclick="toggleTxDetails(this)">
                                        View <i class="fas fa-chevron-down"></i>
                                    </button>
                                </div>
                                <div class="tx-card-details hidden">
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Total:</span>
                                        <span class="tx-value">₱79.00</span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Method:</span>
                                        <span class="tx-value">Cash</span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Status:</span>
                                        <span class="tx-value"><span class="badge badge-warning">Pending</span></span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Time:</span>
                                        <span class="tx-value text-muted">07:34 PM</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Fallback Card 2 -->
                            <div class="tx-card">
                                <div class="tx-card-summary">
                                    <div class="tx-main-info">
                                        <span class="sale-id">#8035</span>
                                        <span class="tx-customer">Walk-in</span>
                                    </div>
                                    <button type="button" class="tx-view-btn" onclick="toggleTxDetails(this)">
                                        View <i class="fas fa-chevron-down"></i>
                                    </button>
                                </div>
                                <div class="tx-card-details hidden">
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Total:</span>
                                        <span class="tx-value">₱158.00</span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Method:</span>
                                        <span class="tx-value">GCash</span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Status:</span>
                                        <span class="tx-value"><span class="badge badge-success">Completed</span></span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Time:</span>
                                        <span class="tx-value text-muted">07:12 PM</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Fallback Card 3 -->
                            <div class="tx-card">
                                <div class="tx-card-summary">
                                    <div class="tx-main-info">
                                        <span class="sale-id">#7036</span>
                                        <span class="tx-customer">Juan Dela Cruz</span>
                                    </div>
                                    <button type="button" class="tx-view-btn" onclick="toggleTxDetails(this)">
                                        View <i class="fas fa-chevron-down"></i>
                                    </button>
                                </div>
                                <div class="tx-card-details hidden">
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Total:</span>
                                        <span class="tx-value">₱89.00</span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Method:</span>
                                        <span class="tx-value">Card</span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Status:</span>
                                        <span class="tx-value"><span class="badge badge-success">Completed</span></span>
                                    </div>
                                    <div class="tx-detail-row">
                                        <span class="tx-label">Time:</span>
                                        <span class="tx-value text-muted">03:46 PM</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div class="pos-card-title"><i class="fas fa-crown"></i> Best Selling Products</div>
                        <span class="volume-label">By Volume</span>
                    </div>

                    <!-- DESKTOP VIEW: Table with Dual-Axis Scrolling -->
                    <div class="table-responsive desktop-only">
                        <table class="pos-table">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Units Sold</th>
                                    <th class="text-right">Revenue Generated</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Spanish Latte (Iced)</td>
                                    <td>
                                        <div class="progress-info">
                                            <span>142 units</span>
                                        </div>
                                        <div class="progress-container"><div class="progress-bar" style="width: 92%;"></div></div>
                                    </td>
                                    <td class="text-right revenue-val">₱22,720.00</td>
                                </tr>
                                <tr>
                                    <td>Café Americana (Hot)</td>
                                    <td>
                                        <div class="progress-info">
                                            <span>98 units</span>
                                        </div>
                                        <div class="progress-container"><div class="progress-bar" style="width: 68%;"></div></div>
                                    </td>
                                    <td class="text-right revenue-val">₱10,780.00</td>
                                </tr>
                                <tr>
                                    <td>Cream Cheese Ensaymada</td>
                                    <td>
                                        <div class="progress-info">
                                            <span>75 units</span>
                                        </div>
                                        <div class="progress-container"><div class="progress-bar" style="width: 51%;"></div></div>
                                    </td>
                                    <td class="text-right revenue-val">₱6,375.00</td>
                                </tr>
                                <tr>
                                    <td>Caramel Macchiato</td>
                                    <td>
                                        <div class="progress-info">
                                            <span>64 units</span>
                                        </div>
                                        <div class="progress-container"><div class="progress-bar" style="width: 43%;"></div></div>
                                    </td>
                                    <td class="text-right revenue-val">₱10,880.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- MOBILE VIEW: Expandable Card List -->
                    <div class="mobile-only">
                        <!-- Product 1 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Spanish Latte (Iced)</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Units Sold:</span>
                                    <span class="tx-value">142 units</span>
                                </div>
                                <div class="progress-container mb-2"><div class="progress-bar" style="width: 92%;"></div></div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Revenue Generated:</span>
                                    <span class="tx-value revenue-val">₱22,720.00</span>
                                </div>
                            </div>
                        </div>

                        <!-- Product 2 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Café Americana (Hot)</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Units Sold:</span>
                                    <span class="tx-value">98 units</span>
                                </div>
                                <div class="progress-container mb-2"><div class="progress-bar" style="width: 68%;"></div></div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Revenue Generated:</span>
                                    <span class="tx-value revenue-val">₱10,780.00</span>
                                </div>
                            </div>
                        </div>

                        <!-- Product 3 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Cream Cheese Ensaymada</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Units Sold:</span>
                                    <span class="tx-value">75 units</span>
                                </div>
                                <div class="progress-container mb-2"><div class="progress-bar" style="width: 51%;"></div></div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Revenue Generated:</span>
                                    <span class="tx-value revenue-val">₱6,375.00</span>
                                </div>
                            </div>
                        </div>

                        <!-- Product 4 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Caramel Macchiato</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Units Sold:</span>
                                    <span class="tx-value">64 units</span>
                                </div>
                                <div class="progress-container mb-2"><div class="progress-bar" style="width: 43%;"></div></div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Revenue Generated:</span>
                                    <span class="tx-value revenue-val">₱10,880.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div class="pos-card-title"><i class="fas fa-boxes"></i> Low Stock Details</div>
                        <a href="/Admin/Inventory" class="manage-link">Manage</a>
                    </div>

                    <!-- DESKTOP VIEW: Table with Dual-Axis Scrolling -->
                    <div class="table-responsive desktop-only">
                        <table class="pos-table">
                            <thead>
                                <tr>
                                    <th>Item Stock</th>
                                    <th>Current Qty</th>
                                    <th>Status</th>
                                    <th class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Espresso Coffee Beans</td>
                                    <td>2.5 kg</td>
                                    <td><span class="badge badge-danger">Critical</span></td>
                                    <td class="text-right">
                                        <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Whole Milk (1L Cartons)</td>
                                    <td>12 units</td>
                                    <td><span class="badge badge-warning">Low</span></td>
                                    <td class="text-right">
                                        <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Caramel Syrup Base</td>
                                    <td>1.2 L</td>
                                    <td><span class="badge badge-warning">Low</span></td>
                                    <td class="text-right">
                                        <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- MOBILE VIEW: Expandable Card List -->
                    <div class="mobile-only">
                        <!-- Item 1 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Espresso Coffee Beans</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Current Qty:</span>
                                    <span class="tx-value">2.5 kg</span>
                                </div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Status:</span>
                                    <span class="badge badge-danger">Critical</span>
                                </div>
                                <div class="tx-detail-row" style="margin-top: 6px;">
                                    <span class="tx-label">Action:</span>
                                    <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                                </div>
                            </div>
                        </div>

                        <!-- Item 2 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Whole Milk (1L Cartons)</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Current Qty:</span>
                                    <span class="tx-value">12 units</span>
                                </div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Status:</span>
                                    <span class="badge badge-warning">Low</span>
                                </div>
                                <div class="tx-detail-row" style="margin-top: 6px;">
                                    <span class="tx-label">Action:</span>
                                    <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                                </div>
                            </div>
                        </div>

                        <!-- Item 3 -->
                        <div class="tx-card">
                            <div class="tx-card-summary">
                                <div class="tx-main-info">
                                    <span class="tx-customer">Caramel Syrup Base</span>
                                </div>
                                <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                                    <span>Details</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="tx-card-details hidden">
                                <div class="tx-detail-row">
                                    <span class="tx-label">Current Qty:</span>
                                    <span class="tx-value">1.2 L</span>
                                </div>
                                <div class="tx-detail-row">
                                    <span class="tx-label">Status:</span>
                                    <span class="badge badge-warning">Low</span>
                                </div>
                                <div class="tx-detail-row" style="margin-top: 6px;">
                                    <span class="tx-label">Action:</span>
                                    <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bottom-three-column-grid">

                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div class="pos-card-title"><i class="fas fa-bolt"></i> Quick Manager Actions</div>
                    </div>
                    <div class="action-button-grid">
                        <button class="action-btn" onclick="location.href='/@homeController/Queue'"><i class="fas fa-shopping-cart"></i>New Order</button>
                        <button class="action-btn" onclick="location.href='/Admin/Products'"><i class="fas fa-plus-circle"></i>Add Product</button>
                        <button class="action-btn" onclick="location.href='/Admin/Inventory'"><i class="fas fa-dolly"></i>Add Inventory</button>
                        <button class="action-btn" onclick="location.href='/Admin/Analytics'"><i class="fas fa-file-invoice-dollar"></i>Sales Report</button>
                    </div>
                </div>

                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div class="pos-card-title"><i class="fas fa-wallet"></i> Payment Breakdown</div>
                    </div>
                    <div class="payment-chart-canvas-wrapper">
                        <canvas id="paymentMethodsChart"></canvas>
                    </div>
                </div>

                <div class="pos-card-wrapper">
                    <div class="pos-card-header">
                        <div class="pos-card-title"><i class="fas fa-bell"></i> Live Notifications</div>
                    </div>
                    <div class="notification-list">
                        <div class="notification-item">
                            <div class="notification-info">
                                <p>New web pickup order received (#ORD-8036)</p>
                                <div class="notification-time">2 mins ago</div>
                            </div>
                        </div>
                        <div class="notification-item alert-node">
                            <div class="notification-info">
                                <p>Inventory Alert: Espresso Beans fall below safety margin</p>
                                <div class="notification-time">14 mins ago</div>
                            </div>
                        </div>
                        <div class="notification-item success-node">
                            <div class="notification-info">
                                <p>System database backup completed securely</p>
                                <div class="notification-time">1 hour ago</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>
    <!-- Customer Support Inbox Popup -->
    <div class="chat-dropdown" id="chatDropdown">
        @Html.AntiForgeryToken()
        <div class="support-header">
            <div><span class="chat-status-dot"></span><strong>Support Inbox</strong><small>Customer conversations</small></div>
            <button type="button" class="support-close" onclick="toggleChat()" title="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="support-inbox">
            <aside class="support-contacts" id="chatContactList"><div class="system-message">Loading conversations…</div></aside>
            <section class="support-conversation">
                <div class="support-conversation-header"><strong id="activeChatName">Select a customer</strong><small id="activeChatRole">Customer support</small></div>
                <div class="chat-dropdown-body" id="chatMessages"><div class="system-message">Choose a customer conversation.</div></div>
                <div class="chat-dropdown-footer"><input type="text" id="chatInput" placeholder="Write a reply…" onkeypress="handleChatKey(event)" /><button class="chat-send-btn" onclick="sendChatMessage()"><i class="fas fa-paper-plane"></i> Send</button></div>
            </section>
        </div>
    </div>

    <script>
            function confirmLogout() {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You will be logged out of your session.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, log out',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('logoutForm').submit();
                    }
                });
            }
            // ── Support Inbox Popup Logic ──
            let chatConn;
            let currentChatWith = null;
            const chatCurrentUser = "@(User.FindFirst("Username")?.Value ?? "")";

            function toggleChat() {
                const popup = document.getElementById("chatDropdown");
                popup.classList.toggle("open");
                if (popup.classList.contains("open")) {
                    document.getElementById("chatBadge").style.display = "none";
                    loadChatContacts();
                }
            }

            document.addEventListener("click", event => {
                const popup = document.getElementById("chatDropdown");
                const trigger = document.getElementById("chatTrigger");
                if (popup.classList.contains("open") && !popup.contains(event.target) && !trigger.contains(event.target)) popup.classList.remove("open");
            });

            function handleChatKey(event) { if (event.key === "Enter") sendChatMessage(); }
            function sendChatMessage() {
                const input = document.getElementById("chatInput");
                const message = input.value.trim();
                if (!message || !currentChatWith || !chatConn) return;
                chatConn.invoke("SendMessage", currentChatWith, message).then(() => { input.value = ""; input.focus(); }).catch(console.error);
            }

            async function loadChatContacts() {
                const list = document.getElementById("chatContactList");
                try {
                    const response = await fetch("/Chat/GetContacts");
                    if (!response.ok) return;
                    const contacts = await response.json();
                    list.innerHTML = "";
                    if (!contacts.length) { list.innerHTML = '<div class="system-message">No customer conversations yet.</div>'; return; }
                    contacts.forEach(contact => {
                        const item = document.createElement("button");
                        item.type = "button";
                        item.className = "support-contact" + (contact.username === currentChatWith ? " active" : "");
                        const unread = Number(contact.unreadCount || 0) > 0 && contact.username !== currentChatWith ? '<span class="support-unread-dot"></span>' : "";
                        item.innerHTML = `<span class="support-contact-top"><strong>${escapeHTML(contact.username)}</strong>${unread}</span><small>${escapeHTML(contact.role || "Customer")}</small><span>${escapeHTML(contact.preview || "No messages yet")}</span>`;
                        item.onclick = () => switchChatContact(contact.username, contact.role);
                        list.appendChild(item);
                    });
                    if (!currentChatWith) switchChatContact(contacts[0].username, contacts[0].role);
                } catch (error) { console.error("Could not load conversations:", error); }
            }

            async function switchChatContact(username, role) {
                currentChatWith = username;
                document.getElementById("activeChatName").textContent = username;
                document.getElementById("activeChatRole").textContent = role || "Customer";
                const area = document.getElementById("chatMessages");
                area.innerHTML = '<div class="system-message">Loading messages…</div>';
                try {
                    const response = await fetch("/Chat/GetChatHistory?chatWith=" + encodeURIComponent(username));
                    if (!response.ok) return;
                    const history = await response.json();
                    area.innerHTML = "";
                    if (!history.length) area.innerHTML = '<div class="system-message">No messages yet. Start the conversation.</div>';
                    history.forEach(message => renderChatMessage(message.sender, message.text, message.time));
                    loadChatContacts();
                } catch (error) { console.error("Could not load messages:", error); }
            }

            function renderChatMessage(sender, message, time) {
                const area = document.getElementById("chatMessages");
                const row = document.createElement("div");
                row.className = "chat-msg-row " + (sender === chatCurrentUser ? "staff" : "other");
                const bubble = document.createElement("div"); bubble.className = "chat-bubble"; bubble.textContent = message;
                const meta = document.createElement("span"); meta.className = "chat-meta"; meta.textContent = (sender === chatCurrentUser ? "You" : sender) + " · " + time;
                row.append(bubble, meta); area.appendChild(row); area.scrollTop = area.scrollHeight;
            }

            function escapeHTML(value) { return String(value).replace(/[&<>'"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[c])); }

            
            // ── Notification Bell Logic (pending online order alerts) ──
            let lastKnownPendingCount = null;

            async function checkForNewOrders() {
                try {
                    const res = await fetch('/Admin/CheckNewOrders');
                    if (!res.ok) return;

                    const data = await res.json();
                    const pendingCount = data.pendingCount || 0;

                    if (lastKnownPendingCount === null) {
                        // First check on page load — just set the baseline, don't alert.
                        lastKnownPendingCount = pendingCount;
                        updateBellBadge(pendingCount);
                        return;
                    }

                    if (pendingCount > lastKnownPendingCount) {
                        const newOrders = pendingCount - lastKnownPendingCount;

                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'info',
                            title: newOrders === 1 ? 'New order received!' : `${newOrders} new orders received!`,
                            showConfirmButton: false,
                            timer: 4000,
                            timerProgressBar: true,
                            background: '#1C241C',
                            color: '#F2EDE4'
                        });
                    }

                    lastKnownPendingCount = pendingCount;
                    updateBellBadge(pendingCount);

                } catch (err) {
                    console.error('Failed to check for new orders:', err);
                }
            }

            function updateBellBadge(count) {
                const badge = document.getElementById('bellBadge');
                if (!badge) return;

                badge.style.display = count > 0 ? 'block' : 'none';
            }

            function goToQueue() {
                window.location.href = '/Admin/QueueOrder';
            }

            document.addEventListener("DOMContentLoaded", function() {
                // Clock Logic
                function updateClock() {
                    const now = new Date();
                    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                    document.getElementById('currentDate').innerText = now.toLocaleDateString('en-US', options);

                    let hours = now.getHours();
                    let minutes = now.getMinutes();
                    const ampm = hours >= 12 ? 'PM' : 'AM';
                    hours = hours % 12;
                    hours = hours ? hours : 12;
                    minutes = minutes < 10 ? '0' + minutes : minutes;
                    document.getElementById('currentTime').innerText = hours + ':' + minutes + ' ' + ampm;
                }
                setInterval(updateClock, 1000);
                updateClock();

                // Weekly Sales Chart Logic
                const rawTodaySales = parseFloat("@Model.TodayTotalSales") || 8500;
                const ctxWeekly = document.getElementById('weeklySalesChart').getContext('2d');
                new Chart(ctxWeekly, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Sales (₱)',
                            data: [
                                rawTodaySales * 0.85,
                                rawTodaySales * 0.95,
                                rawTodaySales * 1.1,
                                rawTodaySales,
                                rawTodaySales * 1.25,
                                rawTodaySales * 1.4,
                                rawTodaySales * 1.3
                            ],
                            borderColor: '#D4AF37',
                            backgroundColor: 'rgba(212, 175, 55, 0.05)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.35
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } }
                    }
                });

                // Payment Methods Chart Logic
                const ctxPayment = document.getElementById('paymentMethodsChart').getContext('2d');
                new Chart(ctxPayment, {
                    type: 'doughnut',
                    data: {
                        labels: ['Cash', 'GCash', 'Card'],
                        datasets: [{
                            data: [55, 30, 15],
                            backgroundColor: ['#D4AF37', '#2ECC71', '#F39C12'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'right' } },
                        cutout: '72%'
                    }
                });

                // ── Real-Time SignalR Connection Setup ──
                chatConn = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .build();

                chatConn.start()
                    .then(() => console.log("Admin Chat Connected!"))
                    .catch(err => console.error("SignalR Startup Error:", err));

                chatConn.on("ReceiveMessage", function(sender, receiver, message, time) {
                    var belongs = currentChatWith && (sender === currentChatWith || receiver === currentChatWith);
                    if (belongs) {
                        var ph = document.getElementById("chatMessages").querySelector('.system-message');
                        if (ph) ph.remove();
                        renderChatMessage(sender, message, time);
                    }
                    if (sender !== chatCurrentUser && !belongs) {
                        var dd = document.getElementById("chatDropdown");
                        if (!dd.classList.contains("open")) {
                            document.getElementById("chatBadge").style.display = "block";
                        }
                    }
                });

                // Start polling for new online orders.
                checkForNewOrders();
                setInterval(checkForNewOrders, 15000);
            });

            function toggleSidebar() {
                const sidebar = document.querySelector('.sidebar');
                const overlay = document.querySelector('.sidebar-overlay');

                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('mobile-open');
            }

            function filterDashboard(query) { /* unused - replaced by globalSearch */ }

            let searchTimeout;
            function globalSearch(query) {
                const dd = document.getElementById("searchDropdown");
                if (!query || query.length < 2) { dd.style.display = "none"; dd.innerHTML = ""; return; }
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(async () => {
                    try {
                        const url = "/Admin/GlobalSearch?q=" + encodeURIComponent(query);
                        console.log("Fetching:", url);
                        const res = await fetch(url);
                        console.log("Status:", res.status);
                        if (!res.ok) { console.error("Search failed:", res.statusText); return; }
                        const data = await res.json();
                        console.log("Results:", data);
                        let html = "";
                        if (data.products.length) {
                            html += '<div class="search-group-label">Products</div>';
                            data.products.forEach(p => {
                                html += '<a class="search-result-item" href="' + p.url + '"><i class="fas fa-coffee"></i><span>' + p.name + '</span><span class="search-price">₱' + p.price.toFixed(2) + '</span></a>';
                            });
                        }
                        if (data.inventory.length) {
                            html += '<div class="search-group-label">Inventory</div>';
                            data.inventory.forEach(i => {
                                html += '<a class="search-result-item" href="' + i.url + '"><i class="fas fa-box"></i><span>' + i.name + '</span><span class="search-stock">' + i.stock + ' ' + i.unit + '</span></a>';
                            });
                        }
                        if (data.transactions.length) {
                            html += '<div class="search-group-label">Transactions</div>';
                            data.transactions.forEach(t => {
                                html += '<a class="search-result-item" href="' + t.url + '"><i class="fas fa-receipt"></i><span>' + t.name + '</span><span class="search-price">₱' + t.amount.toFixed(2) + '</span></a>';
                            });
                        }
                        if (!html) html = '<div class="search-empty">No results found</div>';
                        dd.innerHTML = html;
                        dd.style.display = "block";
                    } catch (e) { console.error("Search error:", e); }
                }, 300);
            }

            document.addEventListener("click", function(e) {
                const dd = document.getElementById("searchDropdown");
                const wrapper = document.querySelector(".search-wrapper");
                if (dd && wrapper && !wrapper.contains(e.target)) {
                    dd.style.display = "none";
                }
            });
            function toggleTxDetails(btn) {
                const card = btn.closest('.tx-card');
                const details = card.querySelector('.tx-card-details');
                const icon = btn.querySelector('i');

                details.classList.toggle('hidden');

                if (details.classList.contains('hidden')) {
                    btn.childNodes[0].nodeValue = "View ";
                    icon.style.transform = "rotate(0deg)";
                } else {
                    btn.childNodes[0].nodeValue = "Hide ";
                    icon.style.transform = "rotate(180deg)";
                }
            }
            function toggleCardDetails(button) {
                const card = button.closest('.tx-card');
                const details = card.querySelector('.tx-card-details');
                const icon = button.querySelector('i');

                details.classList.toggle('hidden');
                if (details.classList.contains('hidden')) {
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    icon.style.transform = 'rotate(180deg)';
                }
            }
    </script>
</body>
</html>


