@model SaleSync.Models.AnalyticsViewModel
@{
    Layout = null;
    bool isManager = User.IsInRole("Manager");
    string homeController = isManager ? "Manager" : "Admin";
    string displayRole = isManager ? "Manager" : "Admin";
}
@inject SaleSync.Services.StoreSettingsService StoreSettings
@{
    var store = StoreSettings.GetSettings();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@displayRole Analytics - Cafero</title>

    <!-- FontAwesome Library for Icons -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="icon"
          type="image/jpeg"
          href="~/images/CaferoLogo.jpg"
          asp-append-version="true" />

    <!-- Required library for confirmLogout -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet"
          href="~/css/AdminDashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Analytics.css"
          asp-append-version="true" />

    <partial name="_ThemeStyles" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

    <div class="dashboard-container">

        <!-- ==========================================================
             SIDEBAR
             ========================================================== -->

        <aside class="sidebar">

            <div>

                <div class="logo-section">

                    <div class="logo-title">
                        @store.StoreName
                    </div>

                    <div class="logo-subtitle">
                        @store.StoreTagline
                    </div>

                </div>


                <div class="profile-section">

                    <div class="profile-circle">
                        👤
                    </div>

                    <div>

                        <h2 class="admin-name">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                ?? User.Identity?.Name
                                ?? "User")
                        </h2>

                        <div class="admin-role">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")
                        </div>

                    </div>

                </div>


                <nav class="sidebar-menu">

                    <a href="/@homeController/Dashboard"
                       class="menu-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        Dashboard
                    </a>

                    <a href="/Admin/QueueOrder"
                       class="menu-btn">
                        Queue
                    </a>

                    <a href="/Promotions"
                       class="menu-btn">
                        Promotions
                    </a>


                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ActivityLog"
                           class="menu-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "ActivityLog" ? "active" : "")">
                            Activity Log
                        </a>
                    }


                    <a href="/Admin/Analytics"
                       class="menu-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "active" : "")">
                        Analytics
                    </a>


                    <a href="/Admin/Products"
                       class="menu-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")">
                        Products
                    </a>


                    <a href="/Admin/Inventory"
                       class="menu-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "active" : "")">
                        Inventory
                    </a>


                    <a href="/Admin/ArchivedProducts"
                       class="menu-btn">
                        Archived
                    </a>


                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ManageAccounts"
                           class="menu-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageAccounts" ? "active" : "")">
                            Accounts
                        </a>
                    }


                    <a href="/Admin/WebCustomization"
                       class="menu-btn">
                        Customization
                    </a>

                </nav>

            </div>


            <div class="logout-section">

                <form method="post"
                      action="/Home/Logout"
                      id="logoutForm">

                    <button type="button"
                            class="menu-btn logout-btn"
                            onclick="confirmLogout()">
                        Log Out
                    </button>

                </form>

            </div>

        </aside>


        <div class="sidebar-overlay"
             onclick="toggleSidebar()">
        </div>


        <!-- ==========================================================
             MOBILE HEADER
             ========================================================== -->

        <div class="mobile-header">

            <button class="hamburger-btn"
                    onclick="toggleSidebar()">

                <i class="fas fa-bars"></i>

            </button>

            <div class="mobile-brand">
                Cafero
            </div>

        </div>


        <!-- ==========================================================
             MAIN CONTENT
             ========================================================== -->

        <main class="main-content slide-up">

            <!-- PAGE HEADER -->

            <div class="page-header">

                <div>

                    <h1 class="greeting-title">
                        Analytics Overview
                    </h1>

                    <p class="greeting-subtitle">
                        Deep dive into your sales and performance metrics.
                    </p>

                </div>


                <!-- ==================================================
                     TIMEFRAME FILTER
                     ================================================== -->

                <div class="timeframe-filter">

                    <select id="analyticsTimeframe"
                            title="Select Timeframe">

                        <option value="today"
                                selected="@(Model.SelectedTimeframe == "today")">
                            Today
                        </option>

                        <option value="week"
                                selected="@(Model.SelectedTimeframe == "week")">
                            This Week
                        </option>

                        <option value="month"
                                selected="@(Model.SelectedTimeframe == "month")">
                            This Month
                        </option>

                        <option value="year"
                                selected="@(Model.SelectedTimeframe == "year")">
                            This Year
                        </option>

                        <option value="custom"
                                selected="@(Model.SelectedTimeframe == "custom")">
                            Custom Range
                        </option>

                    </select>


                    <!-- CUSTOM DATE RANGE -->

                    <div id="customDateRange"
                         class="custom-date-range">

                        <div class="date-field">

                            <label for="startDate">
                                From
                            </label>

                            <input type="date"
                                   id="startDate" />

                        </div>


                        <div class="date-field">

                            <label for="endDate">
                                To
                            </label>

                            <input type="date"
                                   id="endDate" />

                        </div>


                        <button type="button"
                                id="applyCustomRange">
                            Apply
                        </button>

                    </div>

                </div>

            </div>


            <!-- ======================================================
                 KPI ROW
                 ====================================================== -->

            <div class="kpi-row">

                <div class="kpi-card">

                    <div class="kpi-details">

                        <h3>
                            Gross Revenue
                        </h3>

                        <p>
                            ₱@Model.TotalRevenue.ToString("N2")
                        </p>

                    </div>

                </div>


                <div class="kpi-card">

                    <div class="kpi-details">

                        <h3>
                            Total Transactions
                        </h3>

                        <p>
                            @Model.TotalTransactions.ToString("N0")
                        </p>

                    </div>

                </div>


                <div class="kpi-card">

                    <div class="kpi-details">

                        <h3>
                            Average Order Value
                        </h3>

                        <p>
                            ₱@Model.AverageOrderValue.ToString("N2")
                        </p>

                    </div>

                </div>

            </div>


            <!-- ======================================================
                 ANALYTICS MAIN GRID
                 ====================================================== -->

            <div class="analytics-main-grid">


                <!-- ==================================================
                     LEFT COLUMN
                     ================================================== -->

                <div class="charts-flex-column">


                    <!-- GROSS SALES -->

                    <div class="chart-card">

                        <h2 class="widget-title">
                            Gross Sales Volume
                        </h2>

                        <div style="position: relative; height: 280px; width: 100%;">
                            <canvas id="salesChart"></canvas>
                        </div>

                    </div>


                    <!-- PEAK HOURS -->

                    <div class="chart-card">

                        <h2 class="widget-title">
                            Peak Business Hours
                        </h2>

                        <div style="position: relative; height: 280px; width: 100%;">
                            <canvas id="peakHoursChart"></canvas>
                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     RIGHT COLUMN
                     ================================================== -->

                <div class="charts-flex-column">


                    <!-- BEST SELLERS -->

                    <div class="chart-card">

                        <h2 class="widget-title">
                            Best Sellers
                        </h2>

                        <div class="best-selling-list">

                            @if (Model.BestSellers != null && Model.BestSellers.Any())
                            {
                                foreach (var item in Model.BestSellers)
                                {
                                    <div class="best-selling-item">

                                        <span class="item-name">
                                            @item.ProductName
                                        </span>

                                        <span class="item-sold">
                                            @item.TotalSold sold
                                        </span>

                                    </div>
                                }
                            }
                            else
                            {
                                <div style="text-align: center; color: var(--muted); padding: 20px 0; font-size: 13px;">
                                    No sales transactions recorded within this tracking range.
                                </div>
                            }

                        </div>

                    </div>


                    <!-- PAYMENT METHODS -->

                    <div class="chart-card">

                        <h2 class="widget-title">
                            Payment Methods
                        </h2>

                        <div class="pie-chart-container">

                            <canvas id="paymentChart"></canvas>

                        </div>

                    </div>

                </div>

            </div>

        </main>

    </div>


    <!-- ==============================================================
         JAVASCRIPT
         ============================================================== -->

    <script>

        // ==========================================================
        // LOGOUT
        // ==========================================================

        function confirmLogout() {

            Swal.fire({

                title: 'Are you sure?',

                text: "You will be logged out of your session.",

                icon: 'warning',

                showCancelButton: true,

                confirmButtonColor: '#d33',

                cancelButtonColor: '#3085d6',

                confirmButtonText: 'Yes, log out',

                cancelButtonText: 'Cancel'

            }).then((result) => {

                if (result.isConfirmed) {

                    document
                        .getElementById('logoutForm')
                        .submit();

                }

            });

        }


        // ==========================================================
        // MOBILE SIDEBAR
        // ==========================================================

        function toggleSidebar() {

            const sidebar =
                document.querySelector('.sidebar');

            const overlay =
                document.querySelector('.sidebar-overlay');


            if (sidebar) {

                sidebar.classList.toggle('mobile-open');

            }


            if (overlay) {

                overlay.classList.toggle('mobile-open');

            }

        }


        // Close sidebar when tapping outside

        document.addEventListener('click', function (event) {

            const sidebar =
                document.querySelector('.sidebar');

            const overlay =
                document.querySelector('.sidebar-overlay');

            const hamburger =
                document.querySelector('.hamburger-btn');


            if (sidebar && hamburger) {

                if (
                    sidebar.classList.contains('mobile-open') &&
                    !sidebar.contains(event.target) &&
                    !hamburger.contains(event.target)
                ) {

                    sidebar.classList.remove('mobile-open');

                    if (overlay) {

                        overlay.classList.remove('mobile-open');

                    }

                }

            }

        });


        // ==========================================================
        // EMPTY CHART STATE
        // ==========================================================

        function showEmpty(canvas, message) {

            if (!canvas) return;


            const wrap =
                canvas.parentElement;


            canvas.remove();


            wrap.insertAdjacentHTML(
                'beforeend',
                '<div class="chart-empty">' +
                message +
                '</div>'
            );

        }


        // ==========================================================
        // ANALYTICS
        // ==========================================================

        document.addEventListener('DOMContentLoaded', function () {


            // ------------------------------------------------------
            // SERVER DATA
            // ------------------------------------------------------

            const salesLabels =
                @Html.Raw(Json.Serialize(Model.SalesLabels)) || [];

            const salesValues =
                @Html.Raw(Json.Serialize(Model.SalesValues)) || [];

            const peakHourLabels =
                @Html.Raw(Json.Serialize(Model.PeakHourLabels)) || [];

            const peakHourCounts =
                @Html.Raw(Json.Serialize(Model.PeakHourOrderCounts)) || [];

            const paymentLabels =
                @Html.Raw(Json.Serialize(Model.PaymentLabels)) || [];

            const paymentValues =
                @Html.Raw(Json.Serialize(Model.PaymentValues)) || [];


            // ------------------------------------------------------
            // SALES CHART
            // ------------------------------------------------------

            const salesCanvas =
                document.getElementById('salesChart');


            if (
                salesCanvas &&
                salesLabels.length > 0
            ) {

                const ctx =
                    salesCanvas.getContext('2d');


                new Chart(ctx, {

                    type: 'bar',

                    data: {

                        labels: salesLabels,

                        datasets: [{

                            label: 'Gross Revenue (₱)',

                            data: salesValues,

                            backgroundColor: '#C9A84C',

                            borderRadius: 6

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                display: false
                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                grid: {
                                    color: 'rgba(255, 255, 255, 0.05)'
                                },

                                ticks: {
                                    color: 'rgba(242, 237, 228, 0.6)'
                                }

                            },

                            x: {

                                grid: {
                                    display: false
                                },

                                ticks: {
                                    color: 'rgba(242, 237, 228, 0.6)'
                                }

                            }

                        }

                    }

                });

            }
            else if (salesCanvas) {

                showEmpty(
                    salesCanvas,
                    'No sales recorded for this range.'
                );

            }


            // ------------------------------------------------------
            // PEAK HOURS CHART
            // ------------------------------------------------------

            const peakCanvas =
                document.getElementById('peakHoursChart');


            if (
                peakCanvas &&
                peakHourLabels.length > 0
            ) {

                const ctx =
                    peakCanvas.getContext('2d');


                new Chart(ctx, {

                    type: 'line',

                    data: {

                        labels: peakHourLabels,

                        datasets: [{

                            label: 'Orders Processed',

                            data: peakHourCounts,

                            borderColor: '#C9A84C',

                            backgroundColor:
                                'rgba(201, 168, 76, 0.08)',

                            fill: true,

                            tension: 0.35,

                            pointBackgroundColor: '#f2ede4',

                            pointRadius: 4

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                display: false
                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                min: 0,

                                ticks: {
                                    stepSize: 1,
                                    color: 'rgba(242, 237, 228, 0.6)'
                                },

                                grid: {
                                    color: 'rgba(255, 255, 255, 0.05)'
                                }

                            },

                            x: {

                                grid: {
                                    display: false
                                },

                                ticks: {
                                    color: 'rgba(242, 237, 228, 0.6)'
                                }

                            }

                        }

                    }

                });

            }
            else if (peakCanvas) {

                showEmpty(
                    peakCanvas,
                    'No hourly trend activity found for this range.'
                );

            }


            // ------------------------------------------------------
            // PAYMENT CHART
            // ------------------------------------------------------

            const paymentCanvas =
                document.getElementById('paymentChart');


            if (
                paymentCanvas &&
                paymentLabels.length > 0
            ) {

                const paymentCtx =
                    paymentCanvas.getContext('2d');


                new Chart(paymentCtx, {

                    type: 'doughnut',

                    data: {

                        labels: paymentLabels,

                        datasets: [{

                            data: paymentValues,

                            backgroundColor: [
                                '#C9A84C',
                                '#DDB95E',
                                '#A18232',
                                '#E7CB7C'
                            ],

                            borderWidth: 0

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {

                                position: 'bottom',

                                labels: {

                                    color:
                                        'rgba(242, 237, 228, 0.8)',

                                    padding: 10,

                                    boxWidth: 12

                                }

                            }

                        },

                        cutout: '73%'

                    }

                });

            }
            else if (paymentCanvas) {

                showEmpty(
                    paymentCanvas,
                    'No payments recorded for this range.'
                );

            }


            // ======================================================
            // TIMEFRAME / CUSTOM RANGE
            // ======================================================

            const timeframeSelect =
                document.getElementById('analyticsTimeframe');

            const customDateRange =
                document.getElementById('customDateRange');

            const startDateInput =
                document.getElementById('startDate');

            const endDateInput =
                document.getElementById('endDate');

            const applyCustomRange =
                document.getElementById('applyCustomRange');


            // Show custom range if it is already selected

            if (
                timeframeSelect &&
                timeframeSelect.value === 'custom'
            ) {

                customDateRange.style.display = 'flex';

            }


            // ------------------------------------------------------
            // TIMEFRAME SELECT
            // ------------------------------------------------------

            if (timeframeSelect) {

                timeframeSelect.addEventListener(
                    'change',
                    function () {

                        // Custom Range

                        if (this.value === 'custom') {

                            customDateRange.style.display = 'flex';

                            return;

                        }


                        // Normal timeframe

                        customDateRange.style.display = 'none';


                        window.location.href =
                            '/Admin/Analytics?timeframe=' +
                            encodeURIComponent(this.value);

                    }
                );

            }


            // ------------------------------------------------------
            // APPLY CUSTOM RANGE
            // ------------------------------------------------------

            if (applyCustomRange) {

                applyCustomRange.addEventListener(
                    'click',
                    function () {

                        const startDate =
                            startDateInput.value;

                        const endDate =
                            endDateInput.value;


                        // Both dates required

                        if (
                            !startDate ||
                            !endDate
                        ) {

                            Swal.fire({

                                icon: 'warning',

                                title: 'Select a date range',

                                text: 'Please select both a start date and an end date.'

                            });

                            return;

                        }


                        // Start cannot be after end

                        if (startDate > endDate) {

                            Swal.fire({

                                icon: 'warning',

                                title: 'Invalid date range',

                                text: 'The start date cannot be later than the end date.'

                            });

                            return;

                        }


                        // Send dates to Analytics controller

                        window.location.href =
                            '/Admin/Analytics?timeframe=custom' +
                            '&startDate=' +
                            encodeURIComponent(startDate) +
                            '&endDate=' +
                            encodeURIComponent(endDate);

                    }
                );

            }

        });

    </script>

</body>
</html>