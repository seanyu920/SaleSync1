@{
    Layout = null;

    // Check if user has required role
    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");

    if (!isAdmin && !isManager)
    {
        Context.Response.Redirect("/Cashier/Queue");
        return;
    }

    string homeController = isAdmin ? "Admin" : (isManager ? "Manager" : "Cashier");
    string displayRole = isAdmin ? "Admin" : (isManager ? "Manager" : "Cashier");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Promotions - Cafero</title>

    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Promos.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <link rel="icon"
          type="image/jpeg"
          href="~/images/CaferoLogo.jpg"
          asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body>

    <div class="dashboard-container">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div>

                <div class="logo-section">
                    <div class="logo-title">Cafèro</div>
                    <div class="logo-subtitle">Coffee & Pastries</div>
                </div>

                <div class="profile-section">
                    <div class="profile-circle">👤</div>

                    <div>
                        <h2 class="admin-name">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                ?? User.Identity?.Name
                                ?? "User")
                        </h2>

                        <div class="admin-role">
                            @displayRole
                        </div>
                    </div>
                </div>

                <nav class="sidebar-menu">

                    @* Common to Admin, Manager, and Cashier *@
                    <a href="/@homeController/Dashboard" class="menu-btn">
                        Dashboard
                    </a>

                    <a href="/@homeController/QueueOrder" class="menu-btn">
                        Queue
                    </a>

                    @* Accessible ONLY by Admin and Manager *@
                    @if (isAdmin || isManager)
                        {
                            <a href="/@homeController/Promos" class="menu-btn active">
                                Promotions
                            </a>
                        }

                    @if (isAdmin)
                        {
                            <a href="/@homeController/ActivityLog" class="menu-btn">
                                Activity Log
                            </a>
                        }
                    @if (isAdmin || isManager)
                        {
                            <a href="/@homeController/Analytics" class="menu-btn">
                                Analytics
                            </a>

                            <a href="/@homeController/Products" class="menu-btn">
                                Products
                            </a>

                            <a href="/@homeController/Inventory" class="menu-btn">
                                Inventory
                            </a>

                            <a href="/@homeController/ArchivedProducts" class="menu-btn">
                                Archived
                            </a>
                        }
                    @if (isAdmin)
                    {
                        <a href="/@homeController/ManageAccounts" class="menu-btn">
                            Accounts
                        </a>
                    }
                    
                    @if (isAdmin || isManager)
                        {
                            <a href="/@homeController/WebCustomization" class="menu-btn">
                                Customization
                            </a>
                        }
                </nav>

            </div>

            <div class="logout-section">

                <form method="post"
                      action="/Home/Logout"
                      id="logoutForm">

                    <button type="button"
                            class="menu-btn logout-btn"
                            onclick="confirmLogout()">

                        Log Out

                    </button>

                </form>

            </div>

        </aside>

        <!-- MAIN -->
        <main class="main-content">

            <div class="promo-page">

                <!-- HEADER -->
                <div class="promo-header">

                    <div>

                        <h1>
                            Promotions
                        </h1>

                        <p>
                            Create and manage promotions that customers can see on the ordering page.
                        </p>

                    </div>

                    <button class="btn-create-promo"
                            onclick="openPromoModal()">

                        <i class="fas fa-plus"></i>
                        Create Promotion

                    </button>

                </div>

                <!-- SUMMARY -->
                <div class="promo-summary">

                    <div class="promo-summary-card">

                        <div class="promo-icon gold">
                            <i class="fas fa-tags"></i>
                        </div>

                        <div>
                            <div class="promo-summary-label">
                                Total Promotions
                            </div>

                            <div class="promo-summary-value">
                                4
                            </div>
                        </div>

                    </div>

                    <div class="promo-summary-card">

                        <div class="promo-icon green">
                            <i class="fas fa-bolt"></i>
                        </div>

                        <div>
                            <div class="promo-summary-label">
                                Active Promotions
                            </div>

                            <div class="promo-summary-value">
                                2
                            </div>
                        </div>

                    </div>

                    <div class="promo-summary-card">

                        <div class="promo-icon red">
                            <i class="fas fa-clock"></i>
                        </div>

                        <div>
                            <div class="promo-summary-label">
                                Expired
                            </div>

                            <div class="promo-summary-value">
                                1
                            </div>
                        </div>

                    </div>

                </div>

                <!-- PROMOTION TABLE -->
                <div class="promo-table-card">

                    <div class="promo-table-header">

                        <h2>
                            Promotion List
                        </h2>

                    </div>

                    <div class="promo-table-wrapper">

                        <table class="promo-table">

                            <thead>

                                <tr>

                                    <th>
                                        Promotion
                                    </th>

                                    <th>
                                        Code
                                    </th>

                                    <th>
                                        Discount
                                    </th>

                                    <th>
                                        Validity
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                <tr>

                                    <td>
                                        <div class="promo-name">
                                            Weekend Coffee Deal
                                        </div>
                                    </td>

                                    <td>
                                        <span class="promo-code">
                                            WEEKEND20
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-discount">
                                            20% OFF
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-date">
                                            Aug 22 – Aug 30
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-status active">
                                            Active
                                        </span>
                                    </td>

                                    <td>

                                        <div class="promo-actions">

                                            <button class="promo-action-btn"
                                                    onclick="editPromo('Weekend Coffee Deal')">
                                                <i class="fas fa-pen"></i>
                                            </button>

                                            <button class="promo-action-btn"
                                                    onclick="deletePromo('Weekend Coffee Deal')">
                                                <i class="fas fa-trash"></i>
                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                <tr>

                                    <td>
                                        <div class="promo-name">
                                            Iced Latte Special
                                        </div>
                                    </td>

                                    <td>
                                        <span class="promo-code">
                                            ICEDLATTE
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-discount">
                                            ₱20 OFF
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-date">
                                            Aug 25 – Sep 5
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-status scheduled">
                                            Scheduled
                                        </span>
                                    </td>

                                    <td>

                                        <div class="promo-actions">

                                            <button class="promo-action-btn"
                                                    onclick="editPromo('Iced Latte Special')">
                                                <i class="fas fa-pen"></i>
                                            </button>

                                            <button class="promo-action-btn"
                                                    onclick="deletePromo('Iced Latte Special')">
                                                <i class="fas fa-trash"></i>
                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                <tr>

                                    <td>
                                        <div class="promo-name">
                                            New Customer Discount
                                        </div>
                                    </td>

                                    <td>
                                        <span class="promo-code">
                                            WELCOME10
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-discount">
                                            10% OFF
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-date">
                                            Aug 1 – Aug 15
                                        </span>
                                    </td>

                                    <td>
                                        <span class="promo-status expired">
                                            Expired
                                        </span>
                                    </td>

                                    <td>

                                        <div class="promo-actions">

                                            <button class="promo-action-btn"
                                                    onclick="editPromo('New Customer Discount')">
                                                <i class="fas fa-pen"></i>
                                            </button>

                                            <button class="promo-action-btn"
                                                    onclick="deletePromo('New Customer Discount')">
                                                <i class="fas fa-trash"></i>
                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </main>

    </div>

    <!-- CREATE / EDIT PROMO MODAL -->
    <div class="promo-modal-overlay" id="promoModal">

        <div class="promo-modal">

            <div class="promo-modal-header">

                <h2 id="promoModalTitle">
                    Create Promotion
                </h2>

                <button class="promo-close"
                        onclick="closePromoModal()">

                    ✕

                </button>

            </div>

            <form id="promoForm"
                  onsubmit="savePromotion(event)">

                <div class="promo-form-grid">

                    <div class="promo-form-group full">

                        <label>
                            Promotion Name
                        </label>

                        <input type="text"
                               id="promoName"
                               placeholder="e.g. Weekend Coffee Deal"
                               required />

                    </div>

                    <div class="promo-form-group">

                        <label>
                            Promo Code
                        </label>

                        <input type="text"
                               id="promoCode"
                               placeholder="e.g. WEEKEND20"
                               required />

                    </div>

                    <div class="promo-form-group">

                        <label>
                            Discount Type
                        </label>

                        <select id="discountType">

                            <option value="percentage">
                                Percentage Discount
                            </option>

                            <option value="fixed">
                                Fixed Amount
                            </option>

                        </select>

                    </div>

                    <div class="promo-form-group">

                        <label>
                            Discount Value
                        </label>

                        <input type="number"
                               id="discountValue"
                               placeholder="20"
                               min="0"
                               step="0.01"
                               required />

                    </div>

                    <div class="promo-form-group">

                        <label>
                            Minimum Order
                        </label>

                        <input type="number"
                               id="minimumOrder"
                               placeholder="0"
                               min="0"
                               step="0.01" />

                    </div>

                    <div class="promo-form-group">

                        <label>
                            Start Date
                        </label>

                        <input type="date"
                               id="startDate"
                               required />

                    </div>

                    <div class="promo-form-group">

                        <label>
                            End Date
                        </label>

                        <input type="date"
                               id="endDate"
                               required />

                    </div>

                    <div class="promo-form-group full">

                        <label>
                            Description
                        </label>

                        <textarea id="promoDescription"
                                  placeholder="Describe the promotion customers will see..."></textarea>

                    </div>

                </div>

                <div class="promo-modal-footer">

                    <button type="button"
                            class="promo-cancel-btn"
                            onclick="closePromoModal()">

                        Cancel

                    </button>

                    <button type="submit"
                            class="promo-save-btn">

                        Save Promotion

                    </button>

                </div>

            </form>

        </div>

    </div>

    <script>

            function openPromoModal() {

                document.getElementById("promoModalTitle").innerText =
                    "Create Promotion";

                document.getElementById("promoForm").reset();

                document.getElementById("promoModal").classList.add("open");
            }


            function closePromoModal() {

                document.getElementById("promoModal").classList.remove("open");
            }


            function savePromotion(event) {

                event.preventDefault();

                Swal.fire({
                    title: "Promotion Saved!",
                    text: "The promotion has been saved successfully.",
                    icon: "success",
                    confirmButtonText: "OK"
                }).then(() => {

                    closePromoModal();

                });
            }


            function editPromo(name) {

                document.getElementById("promoModalTitle").innerText =
                    "Edit Promotion";

                document.getElementById("promoName").value =
                    name;

                document.getElementById("promoModal").classList.add("open");
            }


            function deletePromo(name) {

                Swal.fire({
                    title: "Delete Promotion?",
                    text: "Are you sure you want to delete " + name + "?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, delete it",
                    cancelButtonText: "Cancel",
                    confirmButtonColor: "#e05555"
                }).then((result) => {

                    if (result.isConfirmed) {

                        Swal.fire({
                            title: "Deleted!",
                            text: "The promotion has been removed.",
                            icon: "success"
                        });

                    }

                });
            }


            function confirmLogout() {

                Swal.fire({
                    title: "Are you sure?",
                    text: "You will be logged out of your session.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, log out",
                    cancelButtonText: "Cancel"
                }).then((result) => {

                    if (result.isConfirmed) {

                        document.getElementById("logoutForm").submit();

                    }

                });

            }


            window.onclick = function(event) {

                const modal =
                    document.getElementById("promoModal");

                if (event.target === modal) {

                    closePromoModal();

                }

            };

    </script>

</body>
</html>