                                  placeholder="e.g. extra shot, less ice, no sugar..."
                                  maxlength="120"
                                  rows="2"></textarea>

                    </div>


                    <button type="button"
                            class="add-btn-large"
                            onclick="addToCart()">

                        Add to Receipt

                    </button>

                </div>

            </div>

        </div>
        ```

    </div>

    <!-- ===================== PAYMENT MODAL ===================== -->

