    <!-- ===================== JAVASCRIPT ===================== -->

    <script>

            /* =====================================================
               LOGOUT
            ===================================================== */

            function confirmLogout() {

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You will be logged out of your session.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, log out',
                    cancelButtonText: 'Cancel'
                }).then((result) => {

                    if (result.isConfirmed) {
                        document.getElementById('logoutForm').submit();
                    }

                });

            }


            /* =====================================================
               MENU DATA
            ===================================================== */

            const menuData = {};
            const productIdMap = {};
            const basePrices = {};

            @if (Model != null)
                {
                        foreach (var item in Model)
                    {
                        @:var cat = "@Html.Raw(item.CategoryName?.Trim().ToUpper())";
                    @:if (!menuData[cat]) menuData[cat] = [];
                    @:var rawName = "@Html.Raw(item.ProductName)";
                    @:var baseName = rawName.replace(" - Small", "").replace(" - Large", "").replace(" - Regular", "");
                    @:if (!menuData[cat].includes(baseName)) menuData[cat].push(baseName);
                    @:productIdMap[rawName] = @item.ProductId;
                    @:basePrices[rawName] = parseFloat("@item.Price");
                    @:basePrices[baseName] = parseFloat("@item.Price");
                }
                }


                const sizedCategories = [
                "COFFEE",
                "MILKTEA",
                "FRUIT TEA"
            ];


            /* =====================================================
               CART / ORDER STATE
            ===================================================== */

            let cart =
                JSON.parse(localStorage.getItem('syncScaleCart')) || [];

            let selectedReceiptIndices = [];

            let activeItemName = "";

            let currentCategory = "";

            let finalPaymentMethod = "Cash";

            let currentCartTotal = 0;

            let pendingAmountPaid = 0;

            let currentOrderType = "Dine In";

            let currentCustomerName = "";

            let appliedPromoCode = "";

            let appliedPromoDiscount = 0;

            let appliedPromoName = "";


            document.addEventListener(
                "DOMContentLoaded",
                () => {

                    renderReceipt();

                }
            );


            /* =====================================================
               ORDER TYPE
            ===================================================== */

            function updateOrderType() {

                const selected =
                    document.querySelector(
                        'input[name="orderType"]:checked'
                    );

                if (selected) {
                    currentOrderType = selected.value;
                }

            }


            /* =====================================================
               PAYMENT
            ===================================================== */

            function openPaymentModal() {

                document.getElementById(
                    'paymentModal'
                ).style.display = 'flex';

            }


            function closePaymentModal() {

                document.getElementById(
                    'paymentModal'
                ).style.display = 'none';

            }


            function confirmPaymentMethod() {

                const selectedOption =
                    document.querySelector(
                        'input[name="paymentOption"]:checked'
                    );

                if (selectedOption) {

                    finalPaymentMethod =
                        selectedOption.value;

                    const icons = {
                        "Cash": "💵",
                        "GCash": "🔵",
                        "Maya": "🟢",
                        "Card": "💳"
                    };

                    document.getElementById(
                        'activePaymentLabel'
                    ).innerText =
                        `${icons[finalPaymentMethod]} ${finalPaymentMethod}`;


                    document.getElementById(
                        'cashSection'
                    ).style.display =
                        finalPaymentMethod === "Cash"
                            ? 'block'
                            : 'none';


                    if (finalPaymentMethod === "Cash") {

                        document.getElementById(
                            'amountTendered'
                        ).focus();

                    }


                    calculateChange();

                }

                closePaymentModal();

            }


            /* =====================================================
               CHANGE
            ===================================================== */

            function calculateChange() {

                const tendered =
                    parseFloat(
                        document.getElementById(
                            'amountTendered'
                        ).value
                    ) || 0;


                const changeDisplay =
                    document.getElementById(
                        'changeDisplay'
                    );


                if (
                    !document.getElementById(
                        'amountTendered'
                    ).value
                ) {

                    changeDisplay.innerText =
                        '₱0.00';

                    return;

                }


                const change =
                    tendered - currentCartTotal;


                changeDisplay.innerText =
                    change < 0
                        ? 'Insufficient'
                        : '₱' + change.toFixed(2);


                changeDisplay.style.color =
                    change < 0
                        ? 'red'
                        : '#3dbf78';

            }


            /* =====================================================
               MENU
            ===================================================== */

            function openSubMenu(cat) {

                currentCategory =
                    cat.toUpperCase();

                const items =
                    menuData[currentCategory] || [];


                document.getElementById(
                    'cashierTitle'
                ).innerText =
                    currentCategory;


                document.getElementById(
                    'backBtn'
                ).style.display =
                    'block';


                document.getElementById(
                    'categoryGrid'
                ).style.display =
                    'none';


                const grid =
                    document.getElementById(
                        'subItemsGrid'
                    );


                grid.style.display =
                    'grid';


                grid.innerHTML =
                    items.map(item => `

                            <div class="product-card"
                                 onclick="selectProductItem('${item.replace(/'/g, "\\'")}')">

                                <div class="product-thumb">
                                    ${getCategoryEmoji(currentCategory)}
                                </div>

                                <div class="product-info">

                                    <h3>
                                        ${item}
                                    </h3>

                                </div>

                            </div>

                        `).join('');

            }


            function backToCategories() {

                document.getElementById(
                    'cashierTitle'
                ).innerText =
                    "Menu Categories";


                document.getElementById(
                    'categoryGrid'
                ).style.display =
                    'grid';


                document.getElementById(
                    'subItemsGrid'
                ).style.display =
                    'none';


                document.getElementById(
                    'backBtn'
                ).style.display =
                    'none';

            }


            /* =====================================================
               PRODUCT SELECTION
            ===================================================== */

            function selectProductItem(name) {

                activeItemName = name;


                document.getElementById(
                    'selectionModal'
                ).style.display =
                    'flex';


                document.getElementById(
                    'displayName'
                ).innerText =
                    name;


                document.getElementById(
                    'qty'
                ).value =
                    1;


                document.getElementById(
                    'itemNotes'
                ).value =
                    "";


                const sizeSelector =
                    document.getElementById(
                        'sizeSelector'
                    );


                if (
                    sizedCategories.includes(
                        currentCategory
                    )
                ) {

                    sizeSelector.style.display =
                        'flex';


                    sizeSelector.innerHTML = `

                            <label class="custom-radio-card">

                                <input type="radio"
                                       name="size"
                                       value="Small"
                                       checked />

                                <span class="radio-tile">
                                    Small
                                </span>

                            </label>


                            <label class="custom-radio-card">

                                <input type="radio"
                                       name="size"
                                       value="Large" />

                                <span class="radio-tile">
                                    Large
                                </span>

                            </label>

                        `;

                }
                else {

                    sizeSelector.style.display =
                        'none';


                    sizeSelector.innerHTML = `

                            <input type="radio"
                                   name="size"
                                   value="Regular"
                                   checked
                                   style="display:none;">

                        `;

                }


                document.getElementById(
                    'detailImageContainer'
                ).innerHTML =
                    getCategoryEmoji(
                        currentCategory
                    );

            }


            function closeSelectionModal() {

                document.getElementById(
                    'selectionModal'
                ).style.display =
                    'none';

            }


            function getCategoryEmoji(cat) {

                return {
                    "COFFEE": "☕",
                    "MILKTEA": "🧋",
                    "RICE MEAL": "🍱",
                    "BREAD & PASTRY": "🥐",
                    "FRUIT TEA": "🍹",
                    "SNACKS & PASTA": "🍝"
                }[cat] || "🍴";

            }


            function increaseQty() {

                const q =
                    document.getElementById("qty");

                q.value =
                    parseInt(q.value) + 1;

            }


            function decreaseQty() {

                const q =
                    document.getElementById("qty");


                if (
                    parseInt(q.value) > 1
                ) {

                    q.value =
                        parseInt(q.value) - 1;

                }

            }


            /* =====================================================
               ADD TO CART
            ===================================================== */

            function addToCart() {

                const selectedSize =
                    document.querySelector(
                        'input[name="size"]:checked'
                    );


                const size =
                    selectedSize
                        ? selectedSize.value
                        : "Regular";


                const qty =
                    parseInt(
                        document.getElementById(
                            "qty"
                        ).value
                    );


                const dbKey =
                    (
                        sizedCategories.includes(
                            currentCategory
                        ) &&
                        size !== "Regular"
                    )
                        ? `${activeItemName} - ${size}`
                        : activeItemName;


                const price =
                    basePrices[dbKey] ||
                    basePrices[activeItemName] ||
                    0;


                const notes =
                    document.getElementById(
                        'itemNotes'
                    ).value.trim();


                cart.push({

                    name: activeItemName,

                    dbKey: dbKey,

                    size: size,

                    qty: qty,

                    price: price,

                    notes: notes

                });


                localStorage.setItem(
                    'syncScaleCart',
                    JSON.stringify(cart)
                );


                Toastify({

                    text:
                        `📦 ${qty}x ${activeItemName} added!`,

                    duration: 1500,

                    style: {
                        background: "#C9A84C"
                    }

                }).showToast();


                /*
                 * A cart change invalidates the previous promotion
                 * calculation because MinimumSpend may change.
                 */
                clearPromo(false);


                renderReceipt();

                closeSelectionModal();

            }


            /* =====================================================
               CART QUANTITY
            ===================================================== */

            function updateCartItemQty(index, change) {

                cart[index].qty += change;


                if (cart[index].qty <= 0) {

                    cart.splice(index, 1);

                    selectedReceiptIndices = [];

                    clearPromo(false);

                }


                localStorage.setItem(
                    'syncScaleCart',
                    JSON.stringify(cart)
                );


                renderReceipt();

            }


            /* =====================================================
               RECEIPT / CART RENDER
            ===================================================== */

            function renderReceipt() {

                const receipt =
                    document.getElementById(
                        "receiptList"
                    );


                const deleteBtn =
                    document.querySelector(
                        '.delete-btn'
                    );


                if (
                    selectedReceiptIndices.length > 1
                ) {

                    deleteBtn.innerText =
                        `Remove Items (${selectedReceiptIndices.length})`;

                }
                else {

                    deleteBtn.innerText =
                        "Remove Item";

                }


                if (cart.length === 0) {

                    receipt.innerHTML =
                        `<div class="empty-msg">
                                No items in order
                            </div>`;


                    document.getElementById(
                        "subtotalDisplay"
                    ).textContent =
                        "₱0.00";


                    document.getElementById(
                        "total"
                    ).textContent =
                        "₱0.00";


                    currentCartTotal = 0;

                    clearPromo(false);

                    calculateChange();

                    return;

                }


                let subtotal = 0;


                receipt.innerHTML =
                    cart.map((item, index) => {

                        const sub =
                            item.qty * item.price;


                        subtotal += sub;


                        const isSelected =
                            selectedReceiptIndices.includes(
                                index
                            );


                        const noteHtml =
                            item.notes
                                ? `
                                        <div style="
                                            font-size:11px;
                                            color:var(--gold);
                                            margin-top:2px;
                                        ">
                                            📝 ${escapeHtml(item.notes)}
                                        </div>
                                      `
                                : '';


                        return `

                                <div class="order-item-row ${isSelected ? 'selected-row' : ''}"
                                     onclick="selectReceiptItem(${index})"
                                     style="
                                        display:flex;
                                        align-items:center;
                                     ">

                                    <div style="flex-grow:1;">

                                        <div style="font-weight:700;">
                                            ${escapeHtml(item.name)}
                                        </div>

                                        <div style="
                                            font-size:11px;
                                            color:rgba(242,237,228,0.4);
                                        ">
                                            ${escapeHtml(item.size)}
                                            • ₱${item.price.toFixed(2)}/ea
                                        </div>

                                        ${noteHtml}

                                    </div>


                                    <div style="
                                        display:flex;
                                        align-items:center;
                                        border:1px solid rgba(255,255,255,0.08);
                                        border-radius:6px;
                                        background:rgba(255,255,255,0.04);
                                        margin-right:12px;
                                    "
                                    onclick="event.stopPropagation()">

                                        <button type="button"
                                                onclick="updateCartItemQty(${index},-1)"
                                                style="
                                                    border:none;
                                                    background:transparent;
                                                    padding:4px 10px;
                                                    cursor:pointer;
                                                    color:#C9A84C;
                                                    font-weight:bold;
                                                    font-size:14px;
                                                ">
                                            -
                                        </button>

                                        <span style="
                                            font-size:13px;
                                            font-weight:700;
                                            min-width:20px;
                                            text-align:center;
                                            color:#F2EDE4;
                                        ">
                                            ${item.qty}
                                        </span>

                                        <button type="button"
                                                onclick="updateCartItemQty(${index},1)"
                                                style="
                                                    border:none;
                                                    background:transparent;
                                                    padding:4px 10px;
                                                    cursor:pointer;
                                                    color:#C9A84C;
                                                    font-weight:bold;
                                                    font-size:14px;
                                                ">
                                            +
                                        </button>

                                    </div>


                                    <div style="
                                        font-weight:800;
                                        color:#C9A84C;
                                        text-align:right;
                                        min-width:60px;
                                    ">
                                        ₱${sub.toFixed(2)}
                                    </div>

                                </div>

                            `;

                    }).join('');


                /*
                 * If the currently applied discount is greater
                 * than the new subtotal, reset it.
                 */
                if (
                    appliedPromoDiscount > subtotal
                ) {

                    clearPromo(false);

                }


                currentCartTotal =
                    Math.max(
                        0,
                        subtotal - appliedPromoDiscount
                    );


                document.getElementById(
                    "subtotalDisplay"
                ).textContent =
                    "₱" + subtotal.toFixed(2);


                document.getElementById(
                    "total"
                ).textContent =
                    "₱" + currentCartTotal.toFixed(2);


                const discountRow =
                    document.getElementById(
                        "discountRow"
                    );


                if (
                    appliedPromoDiscount > 0
                ) {

                    discountRow.style.display =
                        'flex';


                    document.getElementById(
                        "discountDisplay"
                    ).innerText =
                        "-₱" +
                        appliedPromoDiscount.toFixed(2);

                }
                else {

                    discountRow.style.display =
                        'none';

                }


                calculateChange();

            }


            /* =====================================================
               RECEIPT SELECTION
            ===================================================== */

            function selectReceiptItem(index) {

                const position =
                    selectedReceiptIndices.indexOf(
                        index
                    );


                if (position > -1) {

                    selectedReceiptIndices.splice(
                        position,
                        1
                    );

                }
                else {

                    selectedReceiptIndices.push(
                        index
                    );

                }


                renderReceipt();

            }


            function removeSelectedItem() {

                if (
                    selectedReceiptIndices.length === 0
                ) {

                    return;

                }


                cart =
                    cart.filter(
                        (item, index) =>
                            !selectedReceiptIndices.includes(
                                index
                            )
                    );


                selectedReceiptIndices = [];


                localStorage.setItem(
                    'syncScaleCart',
                    JSON.stringify(cart)
                );


                clearPromo(false);

                renderReceipt();

            }


            /* =====================================================
               PROMOTION
            ===================================================== */

            async function applyPromo() {

                const input =
                    document.getElementById(
                        'promoCode'
                    );


                const code =
                    input.value.trim().toUpperCase();


                if (!code) {

                    showPromoMessage(
                        "Please enter a promo code.",
                        false
                    );

                    return;

                }


                if (cart.length === 0) {

                    showPromoMessage(
                        "Add items to the order before applying a promotion.",
                        false
                    );

                    return;

                }


                const subtotal =
                    cart.reduce(
                        (sum, item) =>
                            sum + (item.qty * item.price),
                        0
                    );


                const button =
                    document.getElementById(
                        'applyPromoBtn'
                    );


                button.disabled = true;

                button.innerText = "Checking...";


                try {

                    /*
                     * This endpoint must exist in the updated
                     * CashierController:
                     *
                     * POST /Cashier/ValidatePromotion
                     *
                     * It validates the promotion against the
                     * database and returns the calculated discount.
                     */

                    const response =
                        await fetch(
                            '/Cashier/ValidatePromo',
                            {
                                method: 'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body: JSON.stringify({

                                    promoCode: code,

                                    totalAmount: subtotal

                                })

                            }
                        );


                    const data =
                        await response.json();


                    if (!response.ok || !data.success) {

                        clearPromo(false);


                        showPromoMessage(
                            data.message ||
                            "Invalid or unavailable promotion.",
                            false
                        );


                        return;

                    }


                    appliedPromoCode =
                        code;


                    appliedPromoDiscount =
                        parseFloat(
                            data.discountAmount ||
                            0
                        );


                    appliedPromoName =
                        data.promotionName ||
                        code;


                    /*
                     * Never allow a client-side response
                     * to make the displayed total negative.
                     */

                    appliedPromoDiscount =
                        Math.min(
                            Math.max(
                                appliedPromoDiscount,
                                0
                            ),
                            subtotal
                        );


                    showPromoMessage(
                        data.message ||
                        `${appliedPromoName} applied successfully.`,
                        true
                    );


                    renderReceipt();


                    Toastify({

                        text:
                            `🎉 ${code} applied! Discount: ₱${appliedPromoDiscount.toFixed(2)}`,

                        duration: 2500,

                        style: {
                            background: "#3dbf78"
                        }

                    }).showToast();

                }
                catch (error) {

                    console.error(
                        "Promotion validation error:",
                        error
                    );


                    clearPromo(false);


                    showPromoMessage(
                        "Unable to validate promotion.",
                        false
                    );

                }
                finally {

                    button.disabled = false;

                    button.innerText = "Apply";

                }

            }


            function clearPromo(showMessage = true) {

                appliedPromoCode = "";

                appliedPromoDiscount = 0;

                appliedPromoName = "";


                const message =
                    document.getElementById(
                        'promoMessage'
                    );


                if (message) {

                    message.style.display =
                        showMessage
                            ? 'block'
                            : 'none';

                    if (showMessage) {

                        message.innerText =
                            "Promotion removed.";

                        message.style.color =
                            "#d9534f";

                    }

                }


                renderPromoTotalsOnly();

            }


            function renderPromoTotalsOnly() {

                if (!document.getElementById("subtotalDisplay")) {
                    return;
                }


                const subtotal =
                    cart.reduce(
                        (sum, item) =>
                            sum + (item.qty * item.price),
                        0
                    );


                currentCartTotal =
                    Math.max(
                        0,
                        subtotal - appliedPromoDiscount
                    );


                document.getElementById(
                    "subtotalDisplay"
                ).innerText =
                    "₱" + subtotal.toFixed(2);


                document.getElementById(
                    "total"
                ).innerText =
                    "₱" + currentCartTotal.toFixed(2);


                const discountRow =
                    document.getElementById(
                        "discountRow"
                    );


                if (
                    appliedPromoDiscount > 0
                ) {

                    discountRow.style.display =
                        "flex";


                    document.getElementById(
                        "discountDisplay"
                    ).innerText =
                        "-₱" +
                        appliedPromoDiscount.toFixed(2);

                }
                else {

                    discountRow.style.display =
                        "none";

                }


                calculateChange();

            }


            function showPromoMessage(
                message,
                success
            ) {

                const element =
                    document.getElementById(
                        'promoMessage'
                    );


                element.innerText =
                    message;


                element.style.display =
                    'block';


                element.style.color =
                    success
                        ? '#3dbf78'
                        : '#d9534f';

            }


            /* =====================================================
               CHECKOUT
            ===================================================== */

            function checkoutOrder() {

                if (cart.length === 0) {

                    Swal.fire(
                        "Empty Order",
                        "Please add at least one item.",
                        "warning"
                    );

                    return;

                }


                const amountPaid =
                    finalPaymentMethod === "Cash"
                        ? parseFloat(
                            document.getElementById(
                                'amountTendered'
                            ).value
                        ) || 0
                        : currentCartTotal;


                if (
                    finalPaymentMethod === "Cash" &&
                    amountPaid < currentCartTotal
                ) {

                    Swal.fire(
                        "Insufficient Cash",
                        "Please enter a valid amount tendered.",
                        "warning"
                    );

                    return;

                }


                pendingAmountPaid =
                    amountPaid;


                currentCustomerName =
                    document.getElementById(
                        "customerName"
                    ).value.trim();


                generateReceiptUI(
                    amountPaid
                );

            }


            /* =====================================================
               RECEIPT PREVIEW
            ===================================================== */

            function generateReceiptUI(
                amountPaid
            ) {

                const dateObj =
                    new Date();


                const dateStr =
                    dateObj.toLocaleDateString() +
                    ' ' +
                    dateObj.toLocaleTimeString();


                const receiptNum =
                    "ORD-" +
                    dateObj.getFullYear() +
                    (dateObj.getMonth() + 1)
                        .toString()
                        .padStart(2, '0') +
                    dateObj.getDate()
                        .toString()
                        .padStart(2, '0') +
                    "-" +
                    Math.floor(
                        1000 +
                        Math.random() * 9000
                    );


                document.getElementById(
                    "receiptDate"
                ).innerText =
                    dateStr;


                document.getElementById(
                    "receiptNumber"
                ).innerText =
                    receiptNum;


                document.getElementById(
                    "receiptOrderType"
                ).innerText =
                    currentOrderType;


                const custRow =
                    document.getElementById(
                        "receiptCustomerRow"
                    );


                if (
                    currentCustomerName !== ""
                ) {

                    document.getElementById(
                        "receiptCustomerName"
                    ).innerText =
                        currentCustomerName;


                    custRow.style.display =
                        "block";

                }
                else {

                    custRow.style.display =
                        "none";

                }


                const promoRow =
                    document.getElementById(
                        "receiptPromoRow"
                    );


                if (
                    appliedPromoCode
                ) {

                    document.getElementById(
                        "receiptPromoCode"
                    ).innerText =
                        appliedPromoCode;


                    promoRow.style.display =
                        "block";

                }
                else {

                    promoRow.style.display =
                        "none";

                }


                const tbody =
                    document.getElementById(
                        "receiptItemsTable"
                    );


                tbody.innerHTML = `

                        <tr>

                            <th style="
                                text-align:left;
                                padding-bottom:5px;
                            ">
                                Qty
                            </th>

                            <th style="
                                text-align:left;
                                padding-bottom:5px;
                            ">
                                Item
                            </th>

                            <th style="
                                text-align:right;
                                padding-bottom:5px;
                            ">
                                Total
                            </th>

                        </tr>

                    `;


                cart.forEach(item => {

                    const sub =
                        item.qty * item.price;


                    const noteLine =
                        item.notes
                            ? `
                                    <br>
                                    <small style="
                                        font-size:10px;
                                        color:#333;
                                    ">
                                        Note: ${escapeHtml(item.notes)}
                                    </small>
                                  `
                            : '';


                    tbody.innerHTML += `

                            <tr>

                                <td style="
                                    vertical-align:top;
                                    width:40px;
                                ">
                                    ${item.qty}x
                                </td>

                                <td style="
                                    padding-bottom:5px;
                                ">

                                    ${escapeHtml(item.name)}

                                    <br>

                                    <small style="
                                        font-size:10px;
                                        color:#555;
                                    ">
                                        ${escapeHtml(item.size)}
                                    </small>

                                    ${noteLine}

                                </td>

                                <td style="
                                    text-align:right;
                                    vertical-align:top;
                                ">
                                    ₱${sub.toFixed(2)}
                                </td>

                            </tr>

                        `;

                });


                const subtotal =
                    cart.reduce(
                        (sum, item) =>
                            sum + (item.qty * item.price),
                        0
                    );


                const finalTotal =
                    Math.max(
                        0,
                        subtotal - appliedPromoDiscount
                    );


                /*
                 * VAT is calculated from the discounted
                 * final amount displayed on the receipt.
                 */

                const vatableSales =
                    finalTotal / 1.12;


                const vatAmount =
                    finalTotal - vatableSales;


                document.getElementById(
                    "receiptSubtotal"
                ).innerText =
                    "₱" +
                    subtotal.toFixed(2);


                const receiptDiscountRow =
                    document.getElementById(
                        "receiptDiscountRow"
                    );


                if (
                    appliedPromoDiscount > 0
                ) {

                    receiptDiscountRow.style.display =
                        "flex";


                    document.getElementById(
                        "receiptDiscount"
                    ).innerText =
                        "-₱" +
                        appliedPromoDiscount.toFixed(2);

                }
                else {

                    receiptDiscountRow.style.display =
                        "none";

                }


                document.getElementById(
                    "receiptVat"
                ).innerText =
                    "₱" +
                    vatAmount.toFixed(2);


                document.getElementById(
                    "receiptTotal"
                ).innerText =
                    "₱" +
                    finalTotal.toFixed(2);


                document.getElementById(
                    "receiptPayMethod"
                ).innerText =
                    finalPaymentMethod;


                document.getElementById(
                    "receiptTendered"
                ).innerText =
                    "₱" +
                    amountPaid.toFixed(2);


                const change =
                    amountPaid - finalTotal;


                document.getElementById(
                    "receiptChange"
                ).innerText =
                    "₱" +
                    (
                        change > 0
                            ? change.toFixed(2)
                            : "0.00"
                    );


                document.getElementById(
                    "receiptModal"
                ).style.display =
                    "flex";

            }


            function cancelCheckout() {

                document.getElementById(
                    "receiptModal"
                ).style.display =
                    "none";

            }


            /* =====================================================
               FINAL CHECKOUT
            ===================================================== */

            async function finalizeOrder(
                shouldPrint
            ) {

                const payload =
                    cart.map(item => ({

                        productId:
                            productIdMap[item.dbKey] ||
                            productIdMap[item.name] ||
                            0,

                        quantity:
                            item.qty,

                        price:
                            item.price,

                        notes:
                            item.notes || ""

                    }));


                /*
                 * Client-side guard.
                 */

                if (
                    payload.some(
                        item => item.productId <= 0
                    )
                ) {

                    Swal.fire(
                        "Error",
                        "One or more products could not be identified.",
                        "error"
                    );

                    return;

                }


                const buttons =
                    document.querySelectorAll(
                        '.receipt-modal-actions button'
                    );


                buttons.forEach(btn => {

                    btn.disabled = true;

                    btn.style.opacity = '0.5';

                });


                try {

                    const response =
                        await fetch(
                            '/Cashier/Checkout',
                            {
                                method: 'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body: JSON.stringify({

                                    items: payload,

                                    paymentMethod:
                                        finalPaymentMethod,

                                    amountPaid:
                                        pendingAmountPaid,

                                    orderType:
                                        currentOrderType,

                                    customerName:
                                        currentCustomerName,

                                    promoCode:
                                        appliedPromoCode

                                })

                            }
                        );


                    const data =
                        await response.json()
                            .catch(() => ({}));


                    if (response.ok) {

                        if (shouldPrint) {

                            window.print();

                        }


                        document.getElementById(
                            "receiptModal"
                        ).style.display =
                            "none";


                        Swal.fire(
                            "Order Completed!",
                            "The system is ready for the next customer.",
                            "success"
                        );


                        /*
                         * Reset order state.
                         */

                        document.querySelector(
                            'input[name="orderType"][value="Dine In"]'
                        ).checked =
                            true;


                        currentOrderType =
                            "Dine In";


                        document.getElementById(
                            "customerName"
                        ).value =
                            "";


                        document.getElementById(
                            "promoCode"
                        ).value =
                            "";


                        currentCustomerName =
                            "";


                        appliedPromoCode =
                            "";


                        appliedPromoDiscount =
                            0;


                        appliedPromoName =
                            "";


                        document.getElementById(
                            "promoMessage"
                        ).style.display =
                            "none";


                        cart = [];

                        selectedReceiptIndices = [];


                        localStorage.removeItem(
                            'syncScaleCart'
                        );


                        document.getElementById(
                            'amountTendered'
                        ).value =
                            '';


                        finalPaymentMethod =
                            "Cash";


                        document.getElementById(
                            'activePaymentLabel'
                        ).innerText =
                            "💵 Cash";


                        document.getElementById(
                            'cashSection'
                        ).style.display =
                            "block";


                        renderReceipt();

                        backToCategories();

                    }
                    else {

                        Swal.fire(
                            "Error",
                            data.message ||
                            "Failed to save transaction.",
                            "error"
                        );

                    }

                }
                catch (err) {

                    console.error(
                        "Checkout error:",
                        err
                    );


                    Swal.fire(
                        "Error",
                        "Server error while saving transaction.",
                        "error"
                    );

                }
                finally {

                    buttons.forEach(btn => {

                        btn.disabled = false;

                        btn.style.opacity = '1';

                    });

                }

            }


            /* =====================================================
               HTML ESCAPING
            ===================================================== */

            function escapeHtml(value) {

                if (value === null ||
                    value === undefined) {

                    return "";

                }


                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");

            }


            /* =====================================================
               MOBILE SIDEBAR
            ===================================================== */

            function toggleSidebar() {

                const sidebar =
                    document.querySelector(
                        '.sidebar'
                    );


                const overlay =
                    document.querySelector(
                        '.sidebar-overlay'
                    );


                if (sidebar) {

                    sidebar.classList.toggle(
                        'mobile-open'
                    );

                }


                if (overlay) {

                    overlay.classList.toggle(
                        'mobile-open'
                    );

                }

            }

    </script>

</body>
</html>
