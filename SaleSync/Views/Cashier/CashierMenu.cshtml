@model List<SaleSync.Models.MenuItemModel>
@{
    Layout = null;


    string roleName = "Cashier";
    string homeController = "Cashier";
    string subtitle = "Front Desk Access";

    if (User.IsInRole("Admin"))
    {
        roleName = "Admin";
        homeController = "Admin";
        subtitle = "System Access";
    }
    else if (User.IsInRole("Manager"))
    {
        roleName = "Manager";
        homeController = "Manager";
        subtitle = "System Access";
    }


}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Point of Sale - Cafero</title>

    ```
    <link rel="stylesheet" href="~/css/CashierMenu.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

    <link rel="icon"
          type="image/jpeg"
          href="~/images/CaferoLogo.jpg"
          asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    ```

</head>

<body>

    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <div class="dashboard-container">

        ```
        <!-- ===================== SIDEBAR ===================== -->

        <aside class="sidebar no-print">

            <div>

                <div class="logo-section">
                    <div class="logo-title">Cafèro</div>
                    <div class="logo-subtitle">Coffee & Pastries</div>
                </div>

                <div class="profile-section">
                    <div class="profile-circle">👤</div>

                    <div>
                        <h2 class="admin-name">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                              ?? User.Identity?.Name
                              ?? "User")
                        </h2>

                        <div class="admin-role">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")
                        </div>
                    </div>
                </div>

                <nav class="sidebar-menu">

                    <a href="/@homeController/Dashboard" class="menu-btn">
                        Dashboard
                    </a>

                    @if (User.IsInRole("Cashier"))
                    {
                        <a href="javascript:void(0)" class="menu-btn active">
                            POS
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ActivityLog" class="menu-btn">
                            Activity Log
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a href="/@homeController/Analytics" class="menu-btn">
                            Analytics
                        </a>

                        <a href="/@homeController/QueueOrder" class="menu-btn">
                            Queue
                        </a>

                        <a href="/@homeController/Products" class="menu-btn">
                            Products
                        </a>

                        <a href="/@homeController/Inventory" class="menu-btn">
                            Inventory
                        </a>

                        <a href="/@homeController/ArchivedProducts" class="menu-btn">
                            Archived
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/ManageAccounts" class="menu-btn">
                            Accounts
                        </a>
                    }

                    <a href="/@homeController/WebCustomization" class="menu-btn">
                        Customization
                    </a>

                </nav>

            </div>

            <div class="logout-section">

                <form method="post"
                      action="/Home/Logout"
                      id="logoutForm">

                    <button type="button"
                            class="menu-btn logout-btn"
                            onclick="confirmLogout()">
                        Log Out
                    </button>

                </form>

            </div>

        </aside>

        <div class="mobile-header">

            <button class="hamburger-btn"
                    onclick="toggleSidebar()">

                <i class="fas fa-bars"></i>

            </button>

            <div class="mobile-brand">
                Cafero
            </div>

        </div>

        <!-- ===================== END SIDEBAR ===================== -->
        <!-- ===================== MAIN POS ===================== -->

        <main class="menu-side no-print slide-up">

            <div id="menuSection">

                <div class="page-header">

                    <div>

                        <h1 class="form-title"
                            id="cashierTitle">
                            Menu Categories
                        </h1>

                        <p class="form-subtitle"
                           id="cashierSubtitle">
                            Select an item to add to the order.
                        </p>

                    </div>

                    <button id="backBtn"
                            class="btn-secondary"
                            style="display:none;"
                            onclick="backToCategories()">

                        ← Back to Categories

                    </button>

                </div>


                <div id="categoryGrid"
                     class="product-grid">

                    <div class="product-card"
                         onclick="openSubMenu('COFFEE')">

                        <div class="product-thumb"
                             id="thumb-COFFEE">
                            ☕
                        </div>

                        <div class="product-info">
                            <h3>COFFEE</h3>
                        </div>

                    </div>


                    <div class="product-card"
                         onclick="openSubMenu('MILKTEA')">

                        <div class="product-thumb"
                             id="thumb-MILKTEA">
                            🧋
                        </div>

                        <div class="product-info">
                            <h3>MILK TEA</h3>
                        </div>

                    </div>


                    <div class="product-card"
                         onclick="openSubMenu('FRUIT TEA')">

                        <div class="product-thumb"
                             id="thumb-FRUIT TEA">
                            🍹
                        </div>

                        <div class="product-info">
                            <h3>FRUIT TEA</h3>
                        </div>

                    </div>


                    <div class="product-card"
                         onclick="openSubMenu('RICE MEAL')">

                        <div class="product-thumb"
                             id="thumb-RICE MEAL">
                            🍱
                        </div>

                        <div class="product-info">
                            <h3>RICE MEAL</h3>
                        </div>

                    </div>


                    <div class="product-card"
                         onclick="openSubMenu('BREAD & PASTRY')">

                        <div class="product-thumb"
                             id="thumb-BREAD & PASTRY">
                            🥐
                        </div>

                        <div class="product-info">
                            <h3>BREAD & PASTRY</h3>
                        </div>

                    </div>


                    <div class="product-card"
                         onclick="openSubMenu('SNACKS & PASTA')">

                        <div class="product-thumb"
                             id="thumb-SNACKS & PASTA">
                            🍝
                        </div>

                        <div class="product-info">
                            <h3>SNACKS & PASTA</h3>
                        </div>

                    </div>

                </div>


                <div id="subItemsGrid"
                     class="product-grid"
                     style="display:none;">
                </div>

            </div>

        </main>


        <!-- ===================== RECEIPT SIDEBAR ===================== -->

        <aside class="receipt-side no-print">

            <h2 class="widget-title receipt-title">
                🛒 Current Order
            </h2>

            <p class="receipt-subtitle">
                Tap an item to select for removal
            </p>


            <div class="order-items-list"
                 id="receiptList">

                <div class="empty-msg">
                    No items in order
                </div>

            </div>


            <div class="checkout-footer">

                <!-- CUSTOMER -->

                <div style="margin-bottom:12px;">

                    <input type="text"
                           id="customerName"
                           class="customer-name-input"
                           placeholder="Customer Name (Optional)"
                           autocomplete="off" />

                </div>


                <!-- ORDER TYPE -->

                <div style="display:flex; gap:10px; margin-bottom:12px;">

                    <label class="custom-radio-card"
                           style="flex:1;">

                        <input type="radio"
                               name="orderType"
                               value="Dine In"
                               checked
                               onchange="updateOrderType()" />

                        <span class="radio-tile"
                              style="padding:12px; font-size:14px;">
                            🍽️ Dine In
                        </span>

                    </label>


                    <label class="custom-radio-card"
                           style="flex:1;">

                        <input type="radio"
                               name="orderType"
                               value="Take Out"
                               onchange="updateOrderType()" />

                        <span class="radio-tile"
                              style="padding:12px; font-size:14px;">
                            🛍️ Take Out
                        </span>

                    </label>

                </div>


                <!-- PROMOTION -->

                <div class="promo-section"
                     style="margin-bottom:12px;">

                    <label style="
                        display:block;
                        margin-bottom:6px;
                        font-size:13px;
                        font-weight:700;
                        ">
                        Promotion Code
                    </label>

                    <div style="
                        display:flex;
                        gap:8px;
                        ">

                        <input type="text"
                               id="promoCode"
                               class="customer-name-input"
                               placeholder="Enter promo code"
                               autocomplete="off"
                               style="flex:1; text-transform:uppercase;" />

                        <button type="button"
                                onclick="applyPromo()"
                                id="applyPromoBtn"
                                class="btn-secondary"
                                style="white-space:nowrap;">
                            Apply
                        </button>

                    </div>


                    <div id="promoMessage"
                         style="
                        display:none;
                        margin-top:6px;
                        font-size:12px;
                        font-weight:600;
                        ">
                    </div>

                </div>


                <!-- TOTALS -->

                <div id="priceSummary"
                     style="margin-bottom:12px;">

                    <div class="receipt-row"
                         style="display:flex; justify-content:space-between; margin-bottom:5px;">

                        <span>
                            Subtotal
                        </span>

                        <span id="subtotalDisplay">
                            ₱0.00
                        </span>

                    </div>


                    <div id="discountRow"
                         class="receipt-row"
                         style="
                        display:none;
                        justify-content:space-between;
                        margin-bottom:5px;
                        ">

                        <span>
                            Discount
                        </span>

                        <span id="discountDisplay"
                              style="color:#3dbf78;">
                            -₱0.00
                        </span>

                    </div>


                    <div class="total-row">

                        <span class="total-label">
                            Grand Total
                        </span>

                        <span id="total">
                            ₱0.00
                        </span>

                    </div>

                </div>


                <!-- PAYMENT -->

                <button type="button"
                        onclick="openPaymentModal()"
                        class="payment-select-btn">

                    <span class="payment-label">
                        Payment Method
                    </span>

                    <span id="activePaymentLabel">
                        💵 Cash
                    </span>

                </button>


                <!-- REMOVE -->

                <div class="receipt-actions">

                    <button type="button"
                            onclick="removeSelectedItem()"
                            class="delete-btn">

                        Remove Item

                    </button>

                </div>


                <!-- CASH -->

                <div id="cashSection"
                     class="cash-section">

                    <label class="cash-label">
                        Amount Tendered (₱):
                    </label>

                    <input type="number"
                           id="amountTendered"
                           class="cash-input"
                           onkeyup="calculateChange()"
                           placeholder="0.00" />

                    <div class="change-row">

                        <span class="change-label">
                            Change Due:
                        </span>

                        <span id="changeDisplay"
                              class="change-amount">
                            ₱0.00
                        </span>

                    </div>

                </div>


                <button type="button"
                        onclick="checkoutOrder()"
                        class="btn-checkout">

                    Complete Checkout

                </button>

            </div>

        </aside>
        ```

    </div>

    <!-- ===================== PRODUCT SELECTION MODAL ===================== -->

    <div id="selectionModal"
         class="modal-overlay no-print"
         style="display:none;">

        ```
        <div class="form-card modal-card">

            <button type="button"
                    onclick="closeSelectionModal()"
                    class="modal-close-btn">
                &times;
            </button>


            <div class="item-display-flex">

                <div class="item-image-container"
                     id="detailImageContainer">
                </div>


