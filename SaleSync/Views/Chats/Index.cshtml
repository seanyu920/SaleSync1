@using System.Text.Json
@{
    Layout = null;
    var messages = ViewBag.Messages as List<object>;
    var contacts = ViewBag.Contacts as List<dynamic>;
    string chatWith = ViewBag.ChatWith ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Support Inbox | Cafero</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Outfit, sans-serif;
                color: #243047;
                background: #f4f6fa;
            }

            .inbox {
                display: flex;
                height: 100vh;
                max-width: 1440px;
                margin: auto;
                background: #fff;
            }

            .sidebar {
                width: 350px;
                border-right: 1px solid #e7ebf2;
                display: flex;
                flex-direction: column;
            }

            .brand {
                padding: 25px;
                border-bottom: 1px solid #e7ebf2;
            }

                .brand h1 {
                    margin: 0;
                    font-size: 21px;
                }

                .brand p {
                    margin: 5px 0 0;
                    color: #79839a;
                    font-size: 14px;
                }

            .contact-list {
                overflow-y: auto;
                padding: 10px;
            }

            .contact {
                position: relative;
                display: block;
                padding: 15px;
                border-radius: 12px;
                color: inherit;
                text-decoration: none;
                margin-bottom: 4px;
            }

                .contact:hover {
                    background: #f5f7fb;
                }

                .contact.active {
                    background: #edf4ff;
                }

            .contact-top {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                align-items: center;
            }

            .contact-name {
                font-weight: 600;
            }

            .role {
                color: #75819a;
                font-size: 12px;
                margin-top: 4px;
            }

            .preview {
                color: #95a0b5;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                font-size: 13px;
                margin-top: 7px;
            }

            .unread-dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #ef4444;
                flex: 0 0 auto;
            }

            .main {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 20px 28px;
                border-bottom: 1px solid #e7ebf2;
            }

                .header h2 {
                    margin: 0;
                    font-size: 17px;
                }

                .header span {
                    display: block;
                    margin-top: 4px;
                    font-size: 13px;
                    color: #7b879e;
                }

            .back {
                text-decoration: none;
                color: #4169e1;
                font-weight: 600;
                font-size: 14px;
            }

            .messages {
                flex: 1;
                overflow-y: auto;
                padding: 28px;
                display: flex;
                flex-direction: column;
                gap: 14px;
                background: #fafbfc;
            }

            .message {
                max-width: 70%;
                display: flex;
                flex-direction: column;
            }

            .sent {
                align-self: flex-end;
                align-items: flex-end;
            }

            .received {
                align-self: flex-start;
            }

            .bubble {
                padding: 11px 15px;
                border-radius: 16px;
                line-height: 1.45;
                font-size: 14px;
                word-break: break-word;
            }

            .sent .bubble {
                background: #4169e1;
                color: white;
                border-bottom-right-radius: 4px;
            }

            .received .bubble {
                background: white;
                border: 1px solid #e6eaf0;
                border-bottom-left-radius: 4px;
            }

            .time {
                color: #98a2b5;
                font-size: 11px;
                margin-top: 5px;
            }

            .composer {
                padding: 18px 28px;
                display: flex;
                gap: 10px;
                border-top: 1px solid #e7ebf2;
            }

                .composer input {
                    flex: 1;
                    border: 1px solid #dfe5ee;
                    border-radius: 10px;
                    padding: 13px 14px;
                    font: inherit;
                    outline: none;
                }

                    .composer input:focus {
                        border-color: #4169e1;
                        box-shadow: 0 0 0 3px #4169e122;
                    }

                .composer button {
                    border: 0;
                    border-radius: 10px;
                    padding: 0 20px;
                    color: white;
                    background: #4169e1;
                    font: inherit;
                    font-weight: 600;
                    cursor: pointer;
                }

            .empty {
                margin: auto;
                text-align: center;
                color: #7b879e;
            }

            @@media (max-width: 720px) {
                .sidebar {
                    width: 110px;
                }

                .role, .preview, .brand p {
                    display: none;
                }

                .brand {
                    padding: 20px 12px;
                }

                .contact {
                    padding: 12px 8px;
                }
            }
    </style>
</head>
<body>
    <div class="inbox">
        <aside class="sidebar">
            <div class="brand">
                <h1>Support Inbox</h1>
                <p>Customer conversations</p>
            </div>

            <div class="contact-list">
                @if (contacts != null && contacts.Count > 0)
                {
                    foreach (dynamic contact in contacts)
                    {
                        <a class="contact @(chatWith == contact.Username ? "active" : "")"
                           href="@Url.Action("Index", "Chat", new { chatWith = contact.Username })">
                            <div class="contact-top">
                                <span class="contact-name">@contact.Username</span>
                                @if (contact.UnreadCount > 0 && chatWith != contact.Username)
                                {
                                    <span class="unread-dot" title="Unread message"></span>
                                }
                            </div>
                            <div class="role">@contact.Role</div>
                            <div class="preview">@(string.IsNullOrWhiteSpace(contact.Preview) ? "No messages yet" : contact.Preview)</div>
                        </a>
                    }
                }
                else
                {
                    <p class="empty">No customer conversations yet.</p>
                }
            </div>
        </aside>

        <main class="main">
            @if (!string.IsNullOrWhiteSpace(chatWith))
            {
                <header class="header">
                    <div>
                        <h2>@chatWith</h2>
                        <span>Customer support conversation</span>
                    </div>
                    <a class="back" href="/">Back to dashboard</a>
                </header>

                <div class="messages" id="chatMessages">
                    @foreach (dynamic msg in messages)
                    {
                        bool isMe = msg.Sender == ViewBag.CurrentUser;
                        <div class="message @(isMe ? "sent" : "received")">
                            <div class="bubble">@msg.Text</div>
                            <div class="time">@msg.Time</div>
                        </div>
                    }
                </div>

                <div class="composer">
                    @Html.AntiForgeryToken()
                    <input id="messageInput" type="text" placeholder="Write a reply…" autocomplete="off" />
                    <button id="sendButton" type="button">Send</button>
                </div>
            }
            else
            {
                <div class="empty">
                    <h2>Select a conversation</h2>
                    <p>Customer messages will appear here.</p>
                </div>
            }
        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
            const currentUser = @Html.Raw(JsonSerializer.Serialize((string)ViewBag.CurrentUser ?? ""));
            const chatWith = @Html.Raw(JsonSerializer.Serialize(chatWith));
            const messages = document.getElementById("chatMessages");
            const input = document.getElementById("messageInput");
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            messages?.scrollTo(0, messages.scrollHeight);

            function addMessage(sender, text, time) {
                const item = document.createElement("div");
                item.className = `message ${sender === currentUser ? "sent" : "received"}`;

                const bubble = document.createElement("div");
                bubble.className = "bubble";
                bubble.textContent = text;

                const timestamp = document.createElement("div");
                timestamp.className = "time";
                timestamp.textContent = time;

                item.append(bubble, timestamp);
                messages.appendChild(item);
                messages.scrollTo(0, messages.scrollHeight);
            }

            async function markRead() {
                if (!chatWith || !token) return;

                await fetch(`/Chat/MarkAsRead?chatWith=${encodeURIComponent(chatWith)}`, {
                    method: "POST",
                    headers: { "RequestVerificationToken": token }
                });
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", async (sender, receiver, text, time) => {
                const isCurrentConversation =
                    (sender === currentUser && receiver === chatWith) ||
                    (sender === chatWith && receiver === currentUser);

                if (isCurrentConversation && messages) {
                    addMessage(sender, text, time);
                    if (receiver === currentUser) await markRead();
                } else if (receiver === currentUser) {
                    // Reload updates the red dot and moves the newest conversation to the top.
                    window.location.reload();
                }
            });

            connection.start().catch(console.error);

            async function sendMessage() {
                const text = input?.value.trim();
                if (!text || !chatWith) return;

                try {
                    await connection.invoke("SendMessage", chatWith, text);
                    input.value = "";
                    input.focus();
                } catch (error) {
                    console.error(error);
                }
            }

            document.getElementById("sendButton")?.addEventListener("click", sendMessage);
            input?.addEventListener("keydown", event => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    sendMessage();
                }
            });
    </script>
</body>
</html>