@functions {
    string GetCategoryEmoji(string? category)
    {
        return "";
    }
}

<script>

        function confirmLogout() {

            Swal.fire({
                title: 'Are you sure?',
                text: "You will be logged out of your session.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, log out',
                cancelButtonText: 'Cancel'
            }).then((result) => {

                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }

            });
        }

        // ── DATA from Razor ────────────────────────────────────────────────────────

        const allItems = {};

        @if (Model?.MenuItems != null)
            {
                                            foreach (var item in Model.MenuItems)
                {
                    @:allItems[@item.ProductId] = {
                    @:id: @item.ProductId,
                    @:name: @Html.Raw(Json.Serialize(item.ProductName)),
                    @:price: @item.Price,
                    @:cat: @Html.Raw(Json.Serialize((item.CategoryName ?? "").ToLower().Replace(" ", "")))
                        @:};
            }
            }

            // ── STATE ──────────────────────────────────────────────────────────────────

            let customerCart =
                JSON.parse(localStorage.getItem('caferoCustomerCart') || '[]');

        let favoriteIds =
            JSON.parse(localStorage.getItem('caferoFavorites') || '[]');

        let loyaltyPts =
            parseInt(localStorage.getItem('caferoLoyaltyPoints') || '0');

        let activeSmallId = null;
        let activeLargeId = null;
        let activeSmallPrice = 0;
        let activeLargePrice = null;
        let activeItemName = '';
        let activeCategory = '';

        // Tracks which single cart row (by index) is currently showing its
        // inline Instructions/Add-ons editor. null = none being edited.
        let editingIndex = null;

        // ── MOBILE SIDEBAR ─────────────────────────────────────────────────────────

        function toggleSidebar(event) {

            if (event) {
                event.stopPropagation();
            }

            const sidebar =
                document.querySelector('.sidebar');

            const overlay =
                document.getElementById('sidebarOverlay');

            const button =
                document.getElementById('mobileMenuButton');

            if (!sidebar) return;

            const isOpen =
                sidebar.classList.toggle('mobile-open');

            if (overlay) {
                overlay.classList.toggle('mobile-open', isOpen);
            }

            if (button) {
                button.setAttribute(
                    'aria-expanded',
                    isOpen ? 'true' : 'false'
                );
            }
        }

        function closeSidebar() {

            const sidebar =
                document.querySelector('.sidebar');

            const overlay =
                document.getElementById('sidebarOverlay');

            const button =
                document.getElementById('mobileMenuButton');

            if (sidebar) {
                sidebar.classList.remove('mobile-open');
            }

            if (overlay) {
                overlay.classList.remove('mobile-open');
            }

            if (button) {
                button.setAttribute(
                    'aria-expanded',
                    'false'
                );
            }
        }

        // Close the mobile sidebar after selecting a menu item
        document.addEventListener('click', function(event) {

            const sidebar =
                document.querySelector('.sidebar');

            const button =
                document.getElementById('mobileMenuButton');

            if (!sidebar ||
                !sidebar.classList.contains('mobile-open')) {
                return;
            }

            if (button &&
                button.contains(event.target)) {
                return;
            }

            if (sidebar.contains(event.target)) {
                return;
            }

            closeSidebar();
        });

        // ── STORE STATUS ───────────────────────────────────────────────────────────

        const storeOpeningTime =
                                @Html.Raw(Json.Serialize(storeSettings.OpeningTime ?? "07:00"));

        const storeClosingTime =
                                @Html.Raw(Json.Serialize(storeSettings.ClosingTime ?? "21:00"));

        const storeTemporarilyClosed =
                                @Html.Raw(Json.Serialize(storeSettings.IsTemporarilyClosed));

        function parseTimeToMinutes(hhmm) {

            const parts = hhmm.split(':');

            return (
                parseInt(parts[0], 10) * 60
            ) + parseInt(parts[1], 10);
        }

        function formatMinutesAsClock(totalMinutes) {

            const d = new Date();

            d.setHours(
                Math.floor(totalMinutes / 60),
                totalMinutes % 60,
                0,
                0
            );

            return d.toLocaleTimeString(
                [],
                {
                    hour: 'numeric',
                    minute: '2-digit'
                }
            );
        }

        // Top-level helper so it's callable from anywhere in this file
        // (e.g. submitOnlineOrder), not just from inside checkStoreStatus().
        function isStoreOpen() {

            if (storeTemporarilyClosed) {
                return false;
            }

            const now = new Date();
            const nowMinutes = (now.getHours() * 60) + now.getMinutes();
            const openMinutes = parseTimeToMinutes(storeOpeningTime);
            const closeMinutes = parseTimeToMinutes(storeClosingTime);

            return closeMinutes > openMinutes
                ? (nowMinutes >= openMinutes && nowMinutes < closeMinutes)
                : (nowMinutes >= openMinutes || nowMinutes < closeMinutes);
        }

        function checkStoreStatus() {

            const banner =
                document.getElementById('storeBanner');

            const text =
                document.getElementById('storeStatusText');

            if (!banner || !text) return;

            if (storeTemporarilyClosed) {

                banner.classList.remove('open');

                text.innerText =
                    `We're Temporarily Closed · Opens ${formatMinutesAsClock(
                        parseTimeToMinutes(storeOpeningTime)
                    )}`;

                return;
            }

            const now = new Date();

            const nowMinutes =
                (now.getHours() * 60) +
                now.getMinutes();

            const openMinutes =
                parseTimeToMinutes(storeOpeningTime);

            const closeMinutes =
                parseTimeToMinutes(storeClosingTime);

            const open =
                closeMinutes > openMinutes
                    ? (
                        nowMinutes >= openMinutes &&
                        nowMinutes < closeMinutes
                    )
                    : (
                        nowMinutes >= openMinutes ||
                        nowMinutes < closeMinutes
                    );

            if (open) {

                banner.classList.add('open');

                text.innerText =
                    `We're Open · Closes ${formatMinutesAsClock(closeMinutes)}`;

            }
            else {

                banner.classList.remove('open');

                text.innerText =
                    `We're Closed · Opens ${formatMinutesAsClock(openMinutes)}`;
            }
        }

        // ── LOYALTY ────────────────────────────────────────────────────────────────

        function updateLoyaltyUI() {

            const goal = 500;

            const display =
                document.getElementById('loyaltyPoints');

            const fillBar =
                document.getElementById('loyaltyBarFill');

            const hint =
                document.getElementById('loyaltyHint');

            if (display) {
                display.innerText =
                    loyaltyPts + ' pts';
            }

            if (fillBar) {

                const pct =
                    Math.min(
                        (loyaltyPts / goal) * 100,
                        100
                    );

                fillBar.style.width =
                    pct + '%';
            }

            if (hint) {

                const remaining =
                    goal - loyaltyPts;

                hint.innerText =
                    loyaltyPts >= goal
                        ? 'You have a reward ready!'
                        : `${remaining} pts until your next reward`;
            }
        }

        // ── FAVORITES ─────────────────────────────────────────────────────────────

        function toggleFav(btn, itemId) {

            event.stopPropagation();

            const id =
                String(itemId);

            const idx =
                favoriteIds.indexOf(id);

            if (idx > -1) {

                favoriteIds.splice(idx, 1);

                btn.innerText = '♡';

                btn.classList.remove(
                    'fav-active'
                );

            }
            else {

                favoriteIds.push(id);

                btn.innerText = '❤️';

                btn.classList.add(
                    'fav-active'
                );
            }

            localStorage.setItem(
                'caferoFavorites',
                JSON.stringify(favoriteIds)
            );

            if (
                document
                    .getElementById('menuGrid')
                    .getAttribute('data-current-cat') === 'favorites'
            ) {
                filterMenu('favorites');
            }
        }

        function restoreFavHearts() {

            document
                .querySelectorAll('.product-card')
                .forEach(card => {

                    const id =
                        card.getAttribute('data-id');

                    if (
                        favoriteIds.includes(
                            String(id)
                        )
                    ) {

                        const btn =
                            card.querySelector(
                                '.fav-heart'
                            );

                        if (btn) {

                            btn.innerText =
                                '❤️';

                            btn.classList.add(
                                'fav-active'
                            );
                        }
                    }
                });
        }

        // ── TAB SWITCHER ──────────────────────────────────────────────────────────

        function switchTab(tab, btn) {
            document.getElementById('tabMenu').style.display =
                tab === 'menu' ? 'block' : 'none';

            document.getElementById('tabOrders').style.display =
                tab === 'orders' ? 'block' : 'none';

            document.getElementById('tabPromos').style.display =
                tab === 'promos' ? 'block' : 'none';

            document.getElementById('catNav').style.display =
                tab === 'menu' ? 'block' : 'none';

            document.querySelectorAll('.tab-btn').forEach(
                b => b.classList.remove('active')
            );

            btn.classList.add('active');
        }

        // ── CART TOGGLE ───────────────────────────────────────────────────────────

        function toggleCart() {

            document.getElementById(
                'cartSidebar'
            ).classList.toggle(
                'open'
            );

            document.getElementById(
                'cartOverlay'
            ).classList.toggle(
                'open'
            );

            renderCustomerCart();
        }

        function toggleAddressField() {

            const v =
                document
                    .getElementById(
                        'customerOrderType'
                    )
                    .value;

            document.getElementById(
                'addressContainer'
            ).style.display =
                v === 'Delivery'
                    ? 'block'
                    : 'none';

            document.getElementById(
                'minOrderNote'
            ).style.display =
                v === 'Delivery'
                    ? 'block'
                    : 'none';

            document.getElementById(
                'pickupContainer'
            ).style.display =
                v === 'Pick-up'
                    ? 'block'
                    : 'none';

            if (v === 'Pick-up') {
                setPickupMinDateTime();
            }

            if (v === 'Delivery') {
                prefillSavedAddress();
            }
        }

        // ── PAYMENT PROOF (GCash / Maya) ─────────────────────────────────────────────

        function togglePaymentProof() {

            const method =
                document.getElementById('customerPaymentMethod').value;

            const isOnlinePayment =
                method === 'GCash' || method === 'Maya';

            const proofContainer =
                document.getElementById('paymentProofContainer');

            if (proofContainer) {
                proofContainer.style.display =
                    isOnlinePayment ? 'block' : 'none';
            }

            const methodLabel =
                document.getElementById('qrMethodLabel');

            if (methodLabel && isOnlinePayment) {
                methodLabel.innerText = method;
            }

            // Clear any leftover reference number when switching away from
            // an online payment method so it isn't submitted by mistake.
            if (!isOnlinePayment) {

                const refField =
                    document.getElementById('customerPaymentReference');

                if (refField) {
                    refField.value = '';
                }
            }
        }

        // ── SAVED ADDRESS (localStorage) ─────────────────────────────────────────────

        function prefillSavedAddress() {

            const saved =
                JSON.parse(
                    localStorage.getItem('caferoSavedAddress') || 'null'
                );

            if (!saved) return;

            const fields = {
                customerContactNumber: saved.contactNumber,
                customerStreetAddress: saved.street,
                customerBarangay: saved.barangay,
                customerLandmark: saved.landmark,
                customerDeliveryInstructions: saved.instructions
            };

            Object.entries(fields).forEach(([id, val]) => {

                const el = document.getElementById(id);

                if (el && !el.value && val) {
                    el.value = val;
                }
            });
        }

        function saveAddressIfRequested(addressParts) {

            const shouldSave =
                document.getElementById('saveAddressCheck')?.checked;

            if (!shouldSave) {
                localStorage.removeItem('caferoSavedAddress');
                return;
            }

            localStorage.setItem(
                'caferoSavedAddress',
                JSON.stringify(addressParts)
            );
        }

        // ── GEOLOCATION ───────────────────────────────────────────────────────────

        function useCurrentLocation() {

            if (!navigator.geolocation) {

                Swal.fire(
                    'Not Supported',
                    'Your browser does not support location services. Please type your address instead.',
                    'warning'
                );

                return;
            }

            const btn =
                document.getElementById('useLocationBtn');

            btn.disabled = true;
            btn.innerText = 'Getting location...';

            navigator.geolocation.getCurrentPosition(

                position => {

                    const lat =
                        position.coords.latitude.toFixed(6);

                    const lng =
                        position.coords.longitude.toFixed(6);

                    // Stored as a fallback pin for the rider; appended to
                    // the street address field rather than replacing it,
                    // since reverse-geocoding isn't wired up yet.
                    const streetField =
                        document.getElementById('customerStreetAddress');

                    const pinNote =
                        `[Pinned location: ${lat}, ${lng}]`;

                    if (streetField &&
                        !streetField.value.includes('[Pinned location:')) {

                        streetField.value =
                            (streetField.value.trim() + '\n' + pinNote).trim();
                    }

                    btn.disabled = false;
                    btn.innerText = '📍 Location added';

                    setTimeout(() => {
                        btn.innerText = '📍 Use my current location';
                    }, 2000);
                },

                error => {

                    btn.disabled = false;
                    btn.innerText = '📍 Use my current location';

                    Swal.fire(
                        'Location Unavailable',
                        'Could not get your location. Please type your address manually.',
                        'warning'
                    );
                },

                { timeout: 8000 }
            );
        }

        // Enforces a minimum lead time on the pick-up time picker so a
        // customer can't schedule a pick-up in the past or the next minute.
        function setPickupMinDateTime() {

            const input =
                document.getElementById(
                    'customerPickupTime'
                );

            if (!input) return;

            const minDate =
                new Date(
                    Date.now() + 20 * 60 * 1000
                );

            const pad =
                n => String(n).padStart(2, '0');

            const localValue =
                `${minDate.getFullYear()}-${pad(minDate.getMonth() + 1)}-${pad(minDate.getDate())}T${pad(minDate.getHours())}:${pad(minDate.getMinutes())}`;

            input.min = localValue;

            if (!input.value) {
                input.value = localValue;
            }
        }

        // ── ADD-ONS ───────────────────────────────────────────────────────────────
        // Category-specific so a rice meal never shows drink add-ons like
        // "Oat Milk", and a coffee never shows "Extra Rice". Categories here
        // match the "data-category" values built in the Razor loop above
        // (lowercased, spaces stripped).

        const addonsByCategory = {
            coffee: ['Extra Shot', 'Less Sugar', 'Less Ice', 'Oat Milk', 'Extra Ice'],
            milktea: ['Less Sugar', 'Less Ice', 'Extra Pearls', 'Extra Ice'],
            fruittea: ['Less Sugar', 'Less Ice', 'Extra Ice'],
            ricemeal: ['Extra Rice', 'Less Spicy', 'No Onions', 'Extra Sauce'],
            'snacks&pasta': ['Extra Rice', 'Less Spicy', 'No Onions', 'Extra Sauce', 'Extra Cheese'],
            'bread&pastry': ['Warmed Up', 'Extra Butter', 'No Nuts']
        };

        function getAddonsForCategory(category) {
            return addonsByCategory[category] || [];
        }

        // Combines the selected add-ons and free-text notes into a single
        // string for the existing SpecialInstructions field sent to the
        // server, so no backend/API changes are required.
        function buildInstructionsText(item) {

            const parts = [];

            if (item.addons && item.addons.length > 0) {
                parts.push('Add-ons: ' + item.addons.join(', '));
            }

            if (item.notes) {
                parts.push(item.notes);
            }

            return parts.join(' | ');
        }

        // ── MODAL ─────────────────────────────────────────────────────────────────

        function openModal(
            smallId,
            largeId,
            itemName,
            smallPrice,
            largePrice,
            category
        ) {

            activeSmallId =
                parseInt(
                    smallId
                );

            activeLargeId =
                largeId !== null
                    ? parseInt(
                        largeId
                    )
                    : null;

            activeSmallPrice =
                parseFloat(
                    smallPrice
                );

            activeLargePrice =
                largePrice !== null
                    ? parseFloat(
                        largePrice
                    )
                    : null;

            activeItemName =
                itemName;

            activeCategory =
                category || '';

            const hasSizes =
                activeLargeId !== null;

            document.getElementById(
                'modalItemName'
            ).innerText =
                itemName;

            document.getElementById(
                'sizeSection'
            ).style.display =
                hasSizes
                    ? 'block'
                    : 'none';

            document.getElementById(
                'smallPrice'
            ).innerText =
                '₱' +
                activeSmallPrice.toFixed(
                    2
                );

            document.getElementById(
                'largePrice'
            ).innerText =
                hasSizes
                    ? '₱' +
                    activeLargePrice.toFixed(2)
                    : '';

            document.getElementById(
                'itemQty'
            ).value = 1;

            document.getElementById(
                'itemNotes'
            ).value = '';

            const radios =
                document.querySelectorAll(
                    'input[name="itemSize"]'
                );

            radios.forEach(
                radio => {

                    radio.checked =
                        radio.value === 'Small';
                }
            );

            // Populate the Add-ons checkboxes for this item's category.
            const addonOptions =
                getAddonsForCategory(activeCategory);

            const addonsSection =
                document.getElementById('addonsSection');

            const addonsList =
                document.getElementById('addonsList');

            if (addonOptions.length > 0) {

                addonsSection.style.display = 'block';

                addonsList.innerHTML =
                    addonOptions.map(label => `
                        <label class="addon-check">
                            <input type="checkbox" name="modalAddon" value="${label}">
                            ${label}
                        </label>
                    `).join('');

            }
            else {

                addonsSection.style.display = 'none';
                addonsList.innerHTML = '';
            }

            document.getElementById(
                'sizeModal'
            ).style.display =
                'flex';
        }

        function closeModal() {

            document.getElementById(
                'sizeModal'
            ).style.display =
                'none';
        }

        function updateQty(change) {

            const el =
                document.getElementById(
                    'itemQty'
                );

            el.value =
                Math.max(
                    1,
                    parseInt(
                        el.value
                    ) + change
                );
        }

        function confirmAddToCart() {

            if (activeSmallId === null) {

                Swal.fire(
                    'Error',
                    'Item not found in menu.',
                    'error'
                );

                return;
            }

            const hasSizes =
                activeLargeId !== null;

            const size =
                hasSizes
                    ? document.querySelector(
                        'input[name="itemSize"]:checked'
                    ).value
                    : 'Regular';

            const qty =
                parseInt(
                    document.getElementById(
                        'itemQty'
                    ).value
                );

            const notes =
                document.getElementById(
                    'itemNotes'
                ).value.trim();

            const selectedAddons =
                Array.from(
                    document.querySelectorAll('input[name="modalAddon"]:checked')
                ).map(cb => cb.value);

            const useLarge =
                hasSizes &&
                size === 'Large';

            const productId =
                useLarge
                    ? activeLargeId
                    : activeSmallId;

            const price =
                useLarge
                    ? activeLargePrice
                    : activeSmallPrice;

            const existingIdx =
                customerCart.findIndex(
                    i =>
                        i.id === productId &&
                        i.size === size &&
                        i.notes === notes &&
                        JSON.stringify(i.addons || []) === JSON.stringify(selectedAddons)
                );

            if (existingIdx > -1) {

                customerCart[
                    existingIdx
                ].qty += qty;

            }
            else {

                customerCart.push({
                    id: productId,
                    name: activeItemName,
                    size: size,
                    qty: qty,
                    price: price,
                    notes: notes,
                    addons: selectedAddons,
                    category: activeCategory
                });
            }

            localStorage.setItem(
                'caferoCustomerCart',
                JSON.stringify(
                    customerCart
                )
            );

            updateCartBadge();

            closeModal();

            Swal.fire({

                title:
                    'Added! 🛒',

                text:
                    `${qty}× ${activeItemName}` +
                    (
                        hasSizes
                            ? ' (' + size + ')'
                            : ''
                    ) +
                    ' added to your order.',

                icon:
                    'success',

                timer:
                    1200,

                showConfirmButton:
                    false
            });
        }

        // ── CART RENDER ───────────────────────────────────────────────────────────

        function updateCartBadge() {

            const total =
                customerCart.reduce(
                    (s, i) =>
                        s + i.qty,
                    0
                );

            const badge =
                document.getElementById(
                    'cartBadge'
                );

            if (badge) {

                badge.style.display =
                    total > 0
                        ? 'flex'
                        : 'none';

                badge.innerText =
                    total;
            }
        }

        function renderCustomerCart() {

            const container =
                document.getElementById(
                    'customerCartList'
                );

            const totalDisplay =
                document.getElementById(
                    'customerCartTotal'
                );

            updateCartBadge();

            if (!container) return;

            if (customerCart.length === 0) {

                container.innerHTML =
                    '<div class="empty-cart-msg">Your cart is empty.</div>';

                if (totalDisplay) {
                    totalDisplay.innerText =
                        '₱0.00';
                }

                editingIndex = null;

                return;
            }

            let html = '';
            let grandTotal = 0;

            customerCart.forEach(
                (item, idx) => {

                    const sub =
                        item.qty * item.price;

                    grandTotal += sub;

                    html +=
                        (editingIndex === idx)
                            ? buildCartItemEditHtml(item, idx)
                            : buildCartItemViewHtml(item, idx, sub);
                }
            );

            container.innerHTML =
                html;

            if (totalDisplay) {

                totalDisplay.innerText =
                    '₱' +
                    grandTotal.toFixed(
                        2
                    );
            }
        }

        // Normal (read-only) row for a cart item.
        function buildCartItemViewHtml(item, idx, sub) {

            const addonsHtml =
                (item.addons && item.addons.length > 0)
                    ? `<div class="cart-addons">🧩 ${escapeHTML(item.addons.join(', '))}</div>`
                    : '';

            const notesHtml =
                item.notes
                    ? `<div class="cart-notes-line"><em class="cart-notes">📝 ${escapeHTML(item.notes)}</em></div>`
                    : '';

            return `
                <div class="cart-item-row">

                    <div class="cart-item-info">
                        <h4>${escapeHTML(item.name)}</h4>

                        <p>
                            ${escapeHTML(item.size)}
                            · ₱${item.price.toFixed(2)}/ea
                        </p>

                        ${addonsHtml}
                        ${notesHtml}

                        <button type="button"
                                class="cart-edit-btn"
                                onclick="toggleCartItemEdit(${idx})">
                            ✏️ Edit Instructions / Add-ons
                        </button>
                    </div>

                    <div class="cart-item-controls">

                        <button
                            class="cart-qty-btn"
                            onclick="updateCustomerQty(${idx},-1)">
                            -
                        </button>

                        <span class="cart-qty-val">
                            ${item.qty}
                        </span>

                        <button
                            class="cart-qty-btn"
                            onclick="updateCustomerQty(${idx},1)">
                            +
                        </button>

                    </div>

                    <div class="cart-subtotal-val">
                        ₱${sub.toFixed(2)}
                    </div>

                </div>`;
        }

        // Inline editor for a cart item's Add-ons + Special Instructions.
        // Only one row is ever in edit mode at a time (tracked via
        // editingIndex), so there's exactly one ".cart-item-editing" element
        // in the DOM whenever this renders — saveCartItemEdit relies on that.
        function buildCartItemEditHtml(item, idx) {

            const addonOptions =
                getAddonsForCategory(item.category || '');

            const currentAddons =
                item.addons || [];

            const addonsCheckboxes =
                addonOptions.map(label => {

                    const checked =
                        currentAddons.includes(label)
                            ? 'checked'
                            : '';

                    return `
                        <label class="addon-check">
                            <input type="checkbox" class="cart-edit-addon" value="${label}" ${checked}>
                            ${label}
                        </label>
                    `;

                }).join('');

            return `
                <div class="cart-item-row cart-item-editing">

                    <div class="cart-item-info cart-edit-info">

                        <h4>
                            ${escapeHTML(item.name)}
                            <span class="cart-edit-size">
                                (${escapeHTML(item.size)})
                            </span>
                        </h4>

                        ${
                            addonOptions.length > 0
                                ? `
                                    <p class="modal-label">Add-ons</p>
                                    <div class="addon-options">${addonsCheckboxes}</div>
                                  `
                                : ''
                        }

                        <p class="modal-label">Special Instructions</p>

                        <textarea class="notes-textarea cart-edit-notes"
                                  rows="2"
                                  placeholder="e.g. less sugar, no ice, extra hot...">${escapeHTML(item.notes || '')}</textarea>

                        <div class="cart-edit-actions">

                            <button type="button"
                                    class="btn-cart-edit-save"
                                    onclick="saveCartItemEdit(${idx})">
                                Save
                            </button>

                            <button type="button"
                                    class="btn-cart-edit-cancel"
                                    onclick="cancelCartItemEdit()">
                                Cancel
                            </button>

                        </div>

                    </div>

                </div>`;
        }

        function toggleCartItemEdit(idx) {

            editingIndex =
                (editingIndex === idx)
                    ? null
                    : idx;

            renderCustomerCart();
        }

        function cancelCartItemEdit() {

            editingIndex = null;

            renderCustomerCart();
        }

        function saveCartItemEdit(idx) {

            const row =
                document.querySelector('.cart-item-editing');

            if (!row) return;

            const notes =
                row.querySelector('.cart-edit-notes')?.value.trim() || '';

            const addons =
                Array.from(
                    row.querySelectorAll('.cart-edit-addon:checked')
                ).map(cb => cb.value);

            customerCart[idx].notes = notes;
            customerCart[idx].addons = addons;

            localStorage.setItem(
                'caferoCustomerCart',
                JSON.stringify(customerCart)
            );

            editingIndex = null;

            renderCustomerCart();
        }

        function updateCustomerQty(
            index,
            change
        ) {

            customerCart[index].qty +=
                change;

            if (
                customerCart[index].qty <=
                0
            ) {

                customerCart.splice(
                    index,
                    1
                );

                editingIndex = null;
            }

            localStorage.setItem(
                'caferoCustomerCart',
                JSON.stringify(
                    customerCart
                )
            );

            renderCustomerCart();
        }

        // ── SUBMIT ORDER VIA API ──────────────────────────────────────────────────
        // (fixed: this is now the ONLY submitOnlineOrder() in the file, and it
        // starts with a store-open check before anything else runs)

        async function submitOnlineOrder() {

            if (!isStoreOpen()) {

                Swal.fire(
                    storeTemporarilyClosed ? 'Store Temporarily Closed' : 'Store Closed',
                    storeTemporarilyClosed
                        ? "We're currently on a break. Please check back shortly."
                        : `We're closed right now. Ordering opens at ${formatMinutesAsClock(parseTimeToMinutes(storeOpeningTime))}.`,
                    'warning'
                );

                return;
            }

            if (customerCart.length === 0) {

                Swal.fire(
                    'Empty Cart',
                    'Please add items before checking out.',
                    'warning'
                );

                return;
            }

            const orderType =
                document.getElementById(
                    'customerOrderType'
                ).value;

            const paymentMethod =
                document.getElementById(
                    'customerPaymentMethod'
                ).value;

            const paymentReference =
                document.getElementById(
                    'customerPaymentReference'
                )?.value.trim() || '';

            const isOnlinePayment =
                paymentMethod === 'GCash' || paymentMethod === 'Maya';

            if (
                isOnlinePayment &&
                !paymentReference
            ) {

                Swal.fire(
                    'Missing Reference Number',
                    `Please enter your ${paymentMethod} payment reference number before sending your order.`,
                    'warning'
                );

                return;
            }

            const contactNumber =
                document.getElementById('customerContactNumber')?.value.trim() || '';

            const street =
                document.getElementById('customerStreetAddress')?.value.trim() || '';

            const barangay =
                document.getElementById('customerBarangay')?.value.trim() || '';

            const landmark =
                document.getElementById('customerLandmark')?.value.trim() || '';

            const deliveryInstructions =
                document.getElementById('customerDeliveryInstructions')?.value.trim() || '';

            const addressParts = {
                contactNumber, street, barangay, landmark, instructions: deliveryInstructions
            };

            // Combined single-line string for the kitchen/rider display and
            // for the API payload, which still expects one address string.
            const address =
                [street, barangay ? `Brgy. ${barangay}` : '', landmark ? `(near ${landmark})` : '']
                    .filter(Boolean)
                    .join(', ');

            const pickupTimeRaw =
                document.getElementById(
                    'customerPickupTime'
                )?.value || '';

            const grandTotal =
                customerCart.reduce(
                    (s, i) =>
                        s +
                        i.qty *
                        i.price,
                    0
                );

            if (
                orderType === 'Delivery' &&
                !contactNumber
            ) {

                Swal.fire(
                    'Missing Contact Number',
                    'Please enter a contact number so the rider can reach you.',
                    'warning'
                );

                return;
            }

            if (
                orderType === 'Delivery' &&
                street.length < 10
            ) {

                Swal.fire(
                    'Incomplete Address',
                    'Please enter a more complete street address (unit/house no. and street name).',
                    'warning'
                );

                return;
            }

            if (
                orderType === 'Delivery' &&
                !barangay
            ) {

                Swal.fire(
                    'Missing Barangay',
                    'Please enter your barangay so we can confirm your delivery zone.',
                    'warning'
                );

                return;
            }

            if (
                orderType === 'Delivery' &&
                grandTotal < 200
            ) {

                Swal.fire(
                    'Minimum Order',
                    'Delivery requires a minimum order of ₱200.',
                    'warning'
                );

                return;
            }

            if (
                orderType === 'Pick-up' &&
                !pickupTimeRaw
            ) {

                Swal.fire(
                    'Missing Pick-up Time',
                    'Please choose your preferred pick-up date and time.',
                    'warning'
                );

                return;
            }

            if (
                orderType === 'Pick-up' &&
                new Date(pickupTimeRaw) < new Date()
            ) {

                Swal.fire(
                    'Invalid Pick-up Time',
                    'Please choose a pick-up time in the future.',
                    'warning'
                );

                return;
            }

            const btn =
                document.getElementById(
                    'checkoutBtn'
                );

            btn.disabled =
                true;

            btn.innerText =
                'Sending to kitchen...';

            const payload = {

                OrderType:
                    orderType,

                PaymentMethod:
                    paymentMethod,

                PaymentReference:
                    isOnlinePayment
                        ? paymentReference
                        : null,

                DeliveryAddress:
                    orderType === 'Delivery'
                        ? address
                        : null,

                ContactNumber:
                    orderType === 'Delivery'
                        ? contactNumber
                        : null,

                Barangay:
                    orderType === 'Delivery'
                        ? barangay
                        : null,

                Landmark:
                    orderType === 'Delivery'
                        ? landmark
                        : null,

                DeliveryInstructions:
                    orderType === 'Delivery'
                        ? deliveryInstructions
                        : null,

                PickupTime:
                    orderType === 'Pick-up' && pickupTimeRaw
                        ? pickupTimeRaw
                        : null,

                Items:
                    customerCart.map(
                        i => ({

                            ProductId:
                                i.id,

                            Quantity:
                                i.qty,

                            Price:
                                i.price,

                            Size:
                                i.size,

                            SpecialInstructions:
                                buildInstructionsText(i)
                        })
                    )
            };

            try {

                const response =
                    await fetch(
                        '/Customer/PlaceOnlineOrder',
                        {
                            method:
                                'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify(
                                    payload
                                )
                        }
                    );

                if (response.ok) {

                    const result =
                        await response.json();

                    const earned =
                        Math.floor(
                            grandTotal /
                            10
                        );

                    loyaltyPts +=
                        earned;

                    localStorage.setItem(
                        'caferoLoyaltyPoints',
                        loyaltyPts
                    );

                    updateLoyaltyUI();

                    if (orderType === 'Delivery') {
                        saveAddressIfRequested(addressParts);
                    }

                    Swal.fire({

                        title:
                            'Order Received!',

                        html:
                            `<b>Order #${result.orderId}</b> sent to the kitchen.<br>
                                                Estimated wait: <b>15–20 minutes</b><br>
                                                <small>+${earned} loyalty points earned!</small>`,

                        icon:
                            'success'

                    }).then(() => {

                        customerCart =
                            [];

                        localStorage.removeItem(
                            'caferoCustomerCart'
                        );

                        location.reload();
                    });

                }
                else {

                    const err =
                        await response
                            .json()
                            .catch(
                                () => ({})
                            );

                    Swal.fire(
                        'Checkout Failed',
                        err.message ||
                        'Something went wrong. Please try again.',
                        'error'
                    );
                }

            }
            catch (e) {

                Swal.fire(
                    'Network Error',
                    'Could not reach the server.',
                    'error'
                );

            }
            finally {

                btn.disabled =
                    false;

                btn.innerText =
                    'Send Order to Kitchen';
            }
        }

        // ── MENU FILTER ───────────────────────────────────────────────────────────

        function filterMenu(
            category,
            btnEl
        ) {

            if (category) {

                document
                    .querySelectorAll('.cat-btn')
                    .forEach(
                        b =>
                            b.classList.remove(
                                'active'
                            )
                    );

                if (btnEl) {
                    btnEl.classList.add(
                        'active'
                    );
                }

                document
                    .getElementById(
                        'menuGrid'
                    )
                    .setAttribute(
                        'data-current-cat',
                        category
                    );
            }

            const currentCat =
                document
                    .getElementById(
                        'menuGrid'
                    )
                    .getAttribute(
                        'data-current-cat'
                    );

            const search =
                (
                    document
                        .getElementById(
                            'menuSearch'
                        )
                        .value ||
                    ''
                ).toLowerCase();

            document
                .querySelectorAll(
                    '.product-card'
                )
                .forEach(
                    card => {

                        const cardCat =
                            (
                                card.getAttribute(
                                    'data-category'
                                ) || ''
                            )
                                .toLowerCase()
                                .replace(
                                    /\s/g,
                                    ''
                                );

                        const cardName =
                            (
                                card.getAttribute(
                                    'data-name'
                                ) || ''
                            ).toLowerCase();

                        const cardId =
                            card.getAttribute(
                                'data-id'
                            );

                        let matchCat;

                        if (
                            currentCat ===
                            'all'
                        ) {

                            matchCat =
                                true;

                        }
                        else if (
                            currentCat ===
                            'favorites'
                        ) {

                            matchCat =
                                favoriteIds.includes(
                                    String(
                                        cardId
                                    )
                                );

                        }
                        else {

                            matchCat =
                                cardCat.includes(
                                    currentCat.replace(
                                        /\s/g,
                                        ''
                                    )
                                );
                        }

                        const matchSearch =
                            !search ||
                            cardName.includes(
                                search
                            );

                        card.style.display =
                            (
                                matchCat &&
                                matchSearch
                            )
                                ? ''
                                : 'none';
                    }
                );
        }

        // ── FLOATING CHAT WIDGET LOGIC ─────────────────────────────────────────────

        let chatConn;

        let supportAgent = null;

        const currentUser =
            "@(User.FindFirst("Username")?.Value ?? "Customer")";

        function toggleChatWidget() {

            const chatWindow =
                document.getElementById(
                    'chatWindow'
                );

            const dot =
                document.getElementById(
                    'chatBadgeDot'
                );

            chatWindow.classList.toggle(
                'open'
            );

            if (
                chatWindow.classList.contains(
                    'open'
                ) &&
                dot
            ) {

                dot.style.display =
                    'none';
            }
        }

        function handleChatKey(
            event
        ) {

            if (
                event.key ===
                'Enter'
            ) {

                sendChatMessage();
            }
        }

        function sendChatMessage() {

            const input =
                document.getElementById(
                    'chatInput'
                );

            const messageText =
                input.value.trim();

            if (!messageText) return;

            if (!supportAgent) {

                appendChatMessage(
                    "We couldn't reach a staff member right now. Please try again shortly.",
                    'bot',
                    'System'
                );

                return;
            }

            if (
                chatConn &&
                chatConn.state ===
                signalR.HubConnectionState.Connected
            ) {

                chatConn
                    .invoke(
                        "SendMessage",
                        supportAgent,
                        messageText
                    )
                    .catch(
                        err =>
                            console.error(
                                "Error sending message:",
                                err
                            )
                    );

            }
            else {

                appendChatMessage(
                    messageText,
                    'user',
                    currentUser
                );

                setTimeout(
                    () => {

                        appendChatMessage(
                            "Connecting you back to our customer service...",
                            'bot',
                            "System"
                        );

                    },
                    1000
                );
            }

            input.value =
                '';
        }

        function appendChatMessage(
            text,
            alignment,
            displayName
        ) {

            const body =
                document.getElementById(
                    'chatBody'
                );

            const now =
                new Date();

            const timeString =
                now.toLocaleTimeString(
                    [],
                    {
                        hour:
                            '2-digit',
                        minute:
                            '2-digit'
                    }
                );

            const msgDiv =
                document.createElement(
                    'div'
                );

            msgDiv.className =
                `chat-msg ${alignment}`;

            const staticMsg =
                body.querySelector(
                    ".system-message"
                );

            if (staticMsg) {

                staticMsg.remove();
            }

            const label =
                displayName
                    ? `${displayName} • `
                    : '';

            msgDiv.innerHTML = `
                                    <div class="msg-bubble">
                                        ${escapeHTML(text)}
                                    </div>

                                    <span class="msg-time">
                                        ${label}${timeString}
                                    </span>
                                `;

            body.appendChild(
                msgDiv
            );

            body.scrollTop =
                body.scrollHeight;
        }

        function escapeHTML(str) {

            return str.replace(
                /[&<>'"]/g,
                tag =>
                ({
                    '&':
                        '&amp;',
                    '<':
                        '&lt;',
                    '>':
                        '&gt;',
                    "'":
                        '&#39;',
                    '"':
                        '&quot;'
                }[tag] || tag)
            );
        }

        async function loadChatHistory() {

            if (!supportAgent)
                return;

            try {

                const res =
                    await fetch(
                        `/Chat/GetChatHistory?chatWith=${encodeURIComponent(supportAgent)}`
                    );

                if (!res.ok)
                    return;

                const history =
                    await res.json();

                const body =
                    document.getElementById(
                        'chatBody'
                    );

                if (history.length > 0) {

                    const staticMsg =
                        body.querySelector(
                            ".system-message"
                        );

                    if (staticMsg) {

                        staticMsg.remove();
                    }
                }

                history.forEach(
                    msg => {

                        const isUser =
                            msg.sender ===
                            currentUser;

                        appendChatMessage(
                            msg.text,
                            isUser
                                ? 'user'
                                : 'bot',
                            msg.sender
                        );
                    }
                );

            }
            catch (err) {

                console.error(
                    "Failed to load chat history:",
                    err
                );
            }
        }

        // ── INIT ──────────────────────────────────────────────────────────────────

        window.onload =
            async () => {

                updateCartBadge();

                updateLoyaltyUI();

                checkStoreStatus();

                restoreFavHearts();

                try {

                    const res =
                        await fetch(
                            '/Chat/GetSupportAgent'
                        );

                    if (res.ok) {

                        const data =
                            await res.json();

                        supportAgent =
                            data.agent;
                    }

                }
                catch (err) {

                    console.error(
                        "Failed to resolve support agent:",
                        err
                    );
                }

                chatConn =
                    new signalR.HubConnectionBuilder()
                        .withUrl(
                            "/chatHub"
                        )
                        .build();

                chatConn
                    .start()
                    .then(() => {

                        console.log(
                            "Customer SignalR Chat Connected!"
                        );

                        loadChatHistory();
                    })
                    .catch(
                        err =>
                            console.error(
                                "SignalR Startup Error:",
                                err
                            )
                    );

                chatConn.on(
                    "ReceiveMessage",
                    function(
                        sender,
                        receiver,
                        message,
                        time
                    ) {

                        const isUser =
                            sender ===
                            currentUser;

                        const alignment =
                            isUser
                                ? 'user'
                                : 'bot';

                        appendChatMessage(
                            message,
                            alignment,
                            sender
                        );

                        const chatWindow =
                            document.getElementById(
                                'chatWindow'
                            );

                        const dot =
                            document.getElementById(
                                'chatBadgeDot'
                            );

                        if (
                            !chatWindow.classList.contains(
                                'open'
                            ) &&
                            !isUser &&
                            dot
                        ) {

                            dot.style.display =
                                'block';
                        }
                    }
                );
            };

        window.onclick =
            e => {

                if (
                    e.target ===
                    document.getElementById(
                        'sizeModal'
                    )
                ) {

                    closeModal();
                }
            };

</script>
</body>
</html>
