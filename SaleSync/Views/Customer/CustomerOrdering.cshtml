@model SaleSync.Models.CustomerDashboardViewModel
@{
    Layout = null;
    var storeSettings = ViewBag.StoreSettings as SaleSync.Models.WebCustomization ?? new SaleSync.Models.WebCustomization();
    var storeStatus = ViewBag.StoreStatus as SaleSync.Models.StoreStatus;

    // Merge "X - Small" / "X - Large" rows into a single card per drink,
    // keeping the real ProductId and Price for each size so checkout
    // still submits accurate data.
    var groupedProducts = Model?.MenuItems != null
        ? Model.MenuItems
            .GroupBy(i => new
            {
                BaseName = System.Text.RegularExpressions.Regex.Replace(
                    i.ProductName ?? "",
                    @"\s*-\s*(Small|Large)\s*$",
                    "",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase
                ).Trim(),
                Category = i.CategoryName
            })
            .Select(g => new
            {
                g.Key.BaseName,
                g.Key.Category,
                SmallItem = g.FirstOrDefault(
                    x => !(x.ProductName != null &&
                           x.ProductName.Trim().EndsWith("Large", StringComparison.OrdinalIgnoreCase))
                ) ?? g.First(),
                LargeItem = g.FirstOrDefault(
                    x => x.ProductName != null &&
                         x.ProductName.Trim().EndsWith("Large", StringComparison.OrdinalIgnoreCase)
                )
            })
            .ToList()
        : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Order Now | @storeSettings.StoreName</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/CustomerOrdering.css" asp-append-version="true" />
    <link rel="icon" type="image/jpeg" href="~/images/CaferoLogo.jpg" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Real-Time Chat SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

</head>
<body>
    <div class="dashboard-container">

        <aside class="sidebar">
            <div class="sidebar-top">
                <div class="logo-section">
                    @if (!string.IsNullOrEmpty(storeSettings.LogoPath))
                    {
                        <img src="@storeSettings.LogoPath" alt="@storeSettings.StoreName logo" class="brand-logo" />
                    }
                    <div class="brand-name">@storeSettings.StoreName</div>
                    <div class="brand-sub">@storeSettings.StoreTagline</div>
                </div>

                <div class="store-status-banner @(storeStatus != null && storeStatus.IsOpen ? "open" : "")" id="storeBanner">
                    <span class="store-dot"></span>
                    <span id="storeStatusText">
                        @if (storeStatus != null)
                        {
                            @(storeStatus.IsOpen ? $"We're Open · Closes {storeStatus.ClosingTimeLabel}" : $"We're {storeStatus.Label} · Opens {storeStatus.OpeningTimeLabel}")
                        }
                        else
                        {
                            @:We're Open
                        }
                    </span>
                </div>

                <div class="sidebar-tabs">
                    <button class="tab-btn active" onclick="switchTab('menu', this)">Order</button>
                    <button class="tab-btn" onclick="switchTab('orders', this)">My Orders</button>
                    <button class="tab-btn" onclick="switchTab('promos', this)">Promos</button>
                </div>

                <div id="catNav">
                    <p class="sidebar-section-label">Categories</p>
                    <nav class="sidebar-menu">
                        <button class="menu-btn cat-btn active" onclick="filterMenu('all', this)">All Items</button>
                        <button class="menu-btn cat-btn" onclick="filterMenu('coffee', this)">Coffee</button>
                        <button class="menu-btn cat-btn" onclick="filterMenu('milktea', this)">Milktea</button>
                        <button class="menu-btn cat-btn" onclick="filterMenu('fruittea', this)">Fruit Tea</button>
                        <button class="menu-btn cat-btn" onclick="filterMenu('ricemeal', this)">Rice Meals</button>
                        <button class="menu-btn cat-btn" onclick="filterMenu('bread&pastry', this)">Bread & Pastry</button>
                        <button class="menu-btn cat-btn" onclick="filterMenu('snacks&pasta', this)">Snacks & Pasta</button>
                        <button class="menu-btn cat-btn fav-btn" onclick="filterMenu('favorites', this)">❤️ My Favorites</button>
                    </nav>
                </div>

                <div class="loyalty-box" id="loyaltyBox">
                    <div class="loyalty-header">
                        <span>Loyalty Points</span>
                        <strong id="loyaltyPoints">0 pts</strong>
                    </div>
                    <div class="loyalty-bar-bg">
                        <div class="loyalty-bar-fill" id="loyaltyBarFill" style="width:0%"></div>
                    </div>
                    <p class="loyalty-hint" id="loyaltyHint">Earn points on every order!</p>
                </div>
            </div>

            <div class="logout-section">
                <form method="post" action="/Home/Logout" id="logoutForm">
                    <button type="button" class="menu-btn logout-btn" onclick="confirmLogout()">
                        Log Out
                    </button>
                </form>
            </div>
        </aside>

        <!-- MOBILE HAMBURGER -->
        <div class="mobile-header">
            <button type="button"
                    class="hamburger-btn"
                    id="mobileMenuButton"
                    onclick="toggleSidebar(event)"
                    aria-label="Open menu"
                    aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="mobile-brand">
                @storeSettings.StoreName
            </div>
        </div>

        <!-- MOBILE SIDEBAR OVERLAY -->
        <div class="sidebar-overlay"
             id="sidebarOverlay"
             onclick="closeSidebar()"></div>

        <main class="main-content slide-up">
            <div class="announcement-banner" id="announcementBanner">
                <strong>Welcome to @storeSettings.StoreName!</strong> Free delivery on orders ₱300+
                <button class="close-announcement" onclick="this.parentElement.style.display='none'">✕</button>
            </div>

            <div id="tabMenu">
                <header class="pos-header">
                    <div>
                        <h1>Place an Order</h1>
                        <p>Handcrafted beverages and meals made with love</p>
                    </div>
                    <div class="header-actions">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <input type="text" id="menuSearch" placeholder="Search menu items..." onkeyup="filterMenu()">
                        </div>
                        <button class="cart-icon-btn" onclick="toggleCart()">
                            🛒
                            <span class="cart-badge" id="cartBadge" style="display:none;">0</span>
                        </button>
                    </div>
                </header>

                <div class="product-container" id="menuGrid" data-current-cat="all">
                    @if (groupedProducts != null && groupedProducts.Count > 0)
                    {
                        foreach (var p in groupedProducts)
                        {
                            var smallItem = p.SmallItem;

                            // Safety check to prevent possible-null Razor warning.
                            if (smallItem == null)
                            {
                                continue;
                            }

                            var largeItem = p.LargeItem;

                            // Keep the existing Small/Large behavior,
                            // but avoid possible-null warnings.
                            int? largeProductId = largeItem?.ProductId;
                            decimal? largeProductPrice = largeItem?.Price;

                            bool hasLarge = largeProductId.HasValue;

                            string catRaw = (p.Category ?? "Uncategorized")
                                .ToLower()
                                .Replace(" ", "");

                            <div class="product-card"
                                 data-category="@catRaw"
                                 data-name="@p.BaseName.ToLower()"
                                 data-id="@smallItem.ProductId"
                                 data-price="@smallItem.Price">

                                <button class="fav-heart"
                                        onclick="toggleFav(this, '@smallItem.ProductId')"
                                        title="Add to favorites">
                                    ♡
                                </button>

                                <div class="product-img-placeholder">
                                    @if (!string.IsNullOrEmpty(smallItem.ImagePath))
                                    {
                                        <img src="@smallItem.ImagePath"
                                             alt="@p.BaseName"
                                             class="product-uploaded-img" />
                                    }
                                    else
                                    {
                                        <span class="product-img-emoji">
                                            @GetCategoryEmoji(p.Category)
                                        </span>
                                    }
                                </div>

                                <div class="product-info">

                                    <div class="info-top">
                                        <h3>@p.BaseName</h3>

                                        <span class="price">
                                            ₱@smallItem.Price.ToString("0.##")
                                        </span>
                                    </div>

                                    <p class="description">
                                        Freshly prepared @p.BaseName.
                                    </p>

                                    <button class="btn-add-order"
                                            onclick='openModal(
                                        @smallItem.ProductId,
                                        @(hasLarge ? largeProductId.Value.ToString() : "null"),
                                        @Html.Raw(Json.Serialize(p.BaseName)),
                                        @smallItem.Price,
                                        @(hasLarge ? largeProductPrice.Value.ToString() : "null"),
                                        @Html.Raw(Json.Serialize(catRaw))
                                        )'>

                                        + Add to Order

                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-items-fallback">
                            <p>No menu items found.</p>
                        </div>
                    }
                </div>
            </div>

            <div id="tabOrders" style="display:none;">
                <header class="pos-header">
                    <div>
                        <h1>My Orders</h1>
                        <p>Track your active orders and view past purchases</p>
                    </div>
                    <button class="refresh-btn" onclick="location.reload()">↻ Refresh</button>
                </header>

                <div class="orders-section">
                    <h2 class="section-title">Active Orders</h2>

                    <div id="activeOrdersList">
                        @{
                            var activeStatuses = new List<string>
                            {
                                "Pending",
                                "Preparing",
                                "Ready",
                                "On the Way",
                                "Delivered"
                            };

                            var activeOrders = Model?.OrderHistory?
                                .Where(o => activeStatuses.Contains(o.Status))
                                .ToList();
                        }

                        @if (activeOrders != null && activeOrders.Any())
                        {
                            foreach (var order in activeOrders)
                            {
                                bool isDelivery = string.Equals(
                                    order.OrderType,
                                    "Delivery",
                                    StringComparison.OrdinalIgnoreCase
                                );

                                string[] stepLabels = isDelivery
                                    ? new[] { "Received", "Preparing", "Out for Delivery", "Delivered" }
                                    : new[] { "Received", "Preparing", "Ready" };

                                int step;
                                string eta;

                                if (isDelivery)
                                {
                                    step =
                                        order.Status == "Preparing"
                                            ? 2
                                            : (order.Status == "Ready" ||
                                               order.Status == "On the Way")
                                                ? 3
                                                : order.Status == "Delivered"
                                                    ? 4
                                                    : 1;

                                    eta =
                                        order.Status == "Preparing"
                                            ? "Est. 10–15 mins"
                                            : order.Status == "Ready"
                                                ? "Preparing for your rider..."
                                                : order.Status == "On the Way"
                                                    ? "Your rider is on the way!"
                                                    : order.Status == "Delivered"
                                                        ? "Delivered! Enjoy your order 🎉"
                                                        : "Est. 20–30 mins";
                                }
                                else
                                {
                                    step =
                                        order.Status == "Preparing"
                                            ? 2
                                            : (order.Status == "Ready" ||
                                               order.Status == "On the Way")
                                                ? 3
                                                : 1;

                                    eta =
                                        order.Status == "Preparing"
                                            ? "Est. 10–15 mins"
                                            : (order.Status == "Ready" ||
                                               order.Status == "On the Way")
                                                ? "Ready for pickup!"
                                                : "Est. 15–20 mins";
                                }

                                <div class="track-card">
                                    <div class="track-header">
                                        <span class="track-id">
                                            Order #@order.SaleId
                                        </span>

                                        <span class="track-badge status-@order.Status.ToLower().Replace(" ", "-")">
                                            @order.Status
                                        </span>
                                    </div>

                                    <div class="track-meta">
                                        <span class="track-price">
                                            ₱@order.TotalAmount.ToString("F2")
                                        </span>

                                        <span class="track-time">
                                            @order.SaleDate.ToString("hh:mm tt")
                                        </span>
                                    </div>

                                    <div class="eta-bar">
                                        @eta
                                    </div>

                                    <div class="track-steps">
                                        @for (int i = 0; i < stepLabels.Length; i++)
                                        {
                                            int stepNum = i + 1;
                                            bool done = step >= stepNum;

                                            <div class="track-step @(done ? "done" : "")">
                                                <div class="step-dot">
                                                    @(done ? "✓" : stepNum.ToString())
                                                </div>
                                                <span>@stepLabels[i]</span>
                                            </div>

                                            if (i < stepLabels.Length - 1)
                                            {
                                                bool lineDone = step >= stepNum + 1;

                                                <div class="track-line @(lineDone ? "done" : "")"></div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-orders-msg">
                                No active orders right now.
                            </div>
                        }
                    </div>
                </div>

                <div class="orders-section">
                    <h2 class="section-title">Order History</h2>

                    <div id="orderHistoryList">
                        @if (Model?.OrderHistory != null && Model.OrderHistory.Any())
                        {
                            foreach (var order in Model.OrderHistory)
                            {
                                <div class="history-row">

                                    <div class="history-left">

                                        <div class="history-id">
                                            Order #@order.SaleId
                                        </div>

                                        <div class="history-items">
                                            Type: @order.OrderType
                                        </div>

                                        <div class="history-time">
                                            @order.SaleDate.ToString("MMM dd, hh:mm tt")
                                        </div>

                                    </div>

                                    <div class="history-right">

                                        <span class="track-badge badge-@order.Status.ToLower()">
                                            @order.Status
                                        </span>

                                        <div class="history-total">
                                            ₱@order.TotalAmount.ToString("F2")
                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-orders-msg">
                                No past orders yet.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div id="tabPromos" style="display:none;">
                <header class="pos-header">
                    <div>
                        <h1>Promotions</h1>
                        <p>Enjoy our latest deals and special offers.</p>
                    </div>
                </header>

                <div class="promo-customer-grid">

                    <div class="customer-promo-card">
                        <div class="customer-promo-badge">20% OFF</div>

                        <h2>Weekend Coffee Deal</h2>

                        <p>
                            Enjoy 20% off your favorite coffee drinks this weekend.
                        </p>

                        <div class="customer-promo-code">
                            Code: <strong>WEEKEND20</strong>
                        </div>

                        <div class="customer-promo-validity">
                            Valid Aug 22 – Aug 30
                        </div>
                    </div>

                    <div class="customer-promo-card">
                        <div class="customer-promo-badge">₱20 OFF</div>

                        <h2>Iced Latte Special</h2>

                        <p>
                            Get ₱20 off selected iced latte drinks.
                        </p>

                        <div class="customer-promo-code">
                            Code: <strong>ICEDLATTE</strong>
                        </div>

                        <div class="customer-promo-validity">
                            Valid Aug 25 – Sep 5
                        </div>
                    </div>

                    <div class="customer-promo-card">
                        <div class="customer-promo-badge">10% OFF</div>

                        <h2>New Customer Discount</h2>

                        <p>
                            New customers can enjoy 10% off their first order.
                        </p>

                        <div class="customer-promo-code">
                            Code: <strong>WELCOME10</strong>
                        </div>

                        <div class="customer-promo-validity">
                            Promotion available for new customers.
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>

    <!-- Modals & Overlays -->

    <div id="sizeModal" class="modal-overlay">
        <div class="modal-card">

            <div class="modal-header">
                <h2 id="modalItemName">Item Name</h2>

                <button class="close-modal"
                        onclick="closeModal()">
                    ✕
                </button>
            </div>

            <div id="sizeSection">
                <p class="modal-label">Select Size</p>

                <div class="size-options">

                    <label class="size-box">
                        <input type="radio"
                               name="itemSize"
                               value="Small"
                               checked>

                        <div class="size-content">
                            <span class="size-label">Small</span>
                            <span class="size-price-mod"
                                  id="smallPrice">
                                ₱0
                            </span>
                        </div>
                    </label>

                    <label class="size-box">
                        <input type="radio"
                               name="itemSize"
                               value="Large">

                        <div class="size-content">
                            <span class="size-label">Large</span>
                            <span class="size-price-mod"
                                  id="largePrice">
                                ₱0
                            </span>
                        </div>
                    </label>

                </div>
            </div>

            <!-- ADD-ONS: category-specific checkboxes (e.g. a rice meal won't
                 show "Oat Milk"). Hidden automatically when a category has
                 no add-ons defined for it. -->
            <div id="addonsSection">
                <p class="modal-label">
                    Add-ons
                    <span class="optional-tag">(Optional)</span>
                </p>

                <div id="addonsList" class="addon-options">
                </div>
            </div>

            <p class="modal-label">Quantity</p>

            <div class="quantity-selector">

                <button type="button"
                        class="qty-btn"
                        onclick="updateQty(-1)">
                    −
                </button>

                <input type="number"
                       id="itemQty"
                       value="1"
                       min="1"
                       readonly>

                <button type="button"
                        class="qty-btn"
                        onclick="updateQty(1)">
                    +
                </button>

            </div>

            <p class="modal-label">
                Special Instructions
                <span class="optional-tag">(Optional)</span>
            </p>

            <textarea id="itemNotes"
                      class="notes-textarea"
                      placeholder="e.g. less sugar, no ice, extra hot..."></textarea>

            <button class="btn-confirm-add"
                    onclick="confirmAddToCart()">
                Add to Cart
            </button>

        </div>
    </div>

    <div id="cartSidebar" class="cart-sidebar">

        <div class="cart-header">

            <h2>🛒 Your Order</h2>

            <button class="close-cart-btn"
                    onclick="toggleCart()">
                ✕
            </button>

        </div>

        <div class="cart-items-container"
             id="customerCartList">

            <div class="empty-cart-msg">
                Your cart is empty.
            </div>

        </div>

        <div class="cart-footer">

            <div class="cart-total-row">
                <span>Total</span>
                <span id="customerCartTotal">
                    ₱0.00
                </span>
            </div>

            <div class="min-order-note"
                 id="minOrderNote"
                 style="display:none;">
                Minimum ₱200 for delivery
            </div>

            <select id="customerOrderType"
                    class="cart-select"
                    onchange="toggleAddressField()">

                <option value="Dine In">Dine In</option>
                <option value="Pick-up">Pick-up</option>
                <option value="Delivery">Delivery</option>

            </select>

            <div id="addressContainer"
                 style="display:none;">

                <div class="addr-field-group">
                    <label class="addr-label" for="customerContactNumber">Contact Number</label>
                    <input type="tel"
                           id="customerContactNumber"
                           class="cart-select"
                           placeholder="09XX XXX XXXX"
                           maxlength="20" />
                </div>

                <div class="addr-field-group">
                    <label class="addr-label" for="customerStreetAddress">Street Address / House No. &amp; Building</label>
                    <textarea id="customerStreetAddress"
                              class="cart-textarea"
                              placeholder="Unit/House No., Street, Subdivision..."
                              rows="2"></textarea>
                </div>

                <div class="addr-field-row">
                    <div class="addr-field-group">
                        <label class="addr-label" for="customerBarangay">Barangay</label>
                        <input type="text"
                               id="customerBarangay"
                               class="cart-select"
                               placeholder="e.g. Barangay 123" />
                    </div>

                    <div class="addr-field-group">
                        <label class="addr-label" for="customerLandmark">Landmark</label>
                        <input type="text"
                               id="customerLandmark"
                               class="cart-select"
                               placeholder="e.g. near XYZ school" />
                    </div>
                </div>

                <div class="addr-field-group">
                    <label class="addr-label" for="customerDeliveryInstructions">
                        Delivery Instructions
                        <span class="optional-tag">(Optional)</span>
                    </label>
                    <textarea id="customerDeliveryInstructions"
                              class="cart-textarea"
                              placeholder="e.g. gate code, floor/unit no., leave with guard..."
                              rows="2"></textarea>
                </div>

                <button type="button"
                        class="btn-use-location"
                        onclick="useCurrentLocation()"
                        id="useLocationBtn">
                    📍 Use my current location
                </button>

                <label class="addr-save-check">
                    <input type="checkbox" id="saveAddressCheck" checked />
                    Save this address for next time
                </label>

            </div>

            <div id="pickupContainer"
                 style="display:none;">

                <label for="customerPickupTime"
                       style="display:block; color:var(--cream); font-size:12px; font-weight:600; margin-bottom:6px;">
                    Preferred pick-up date &amp; time
                </label>

                <input type="datetime-local"
                       id="customerPickupTime"
                       class="cart-select" />

            </div>

            <select id="customerPaymentMethod"
                    class="cart-select"
                    onchange="togglePaymentProof()">

                <option value="Cash">
                    Pay at Counter (Cash)
                </option>

                <option value="GCash">
                    GCash
                </option>

                <option value="Maya">
                    Maya
                </option>

                <option value="Card">
                    Card
                </option>

            </select>

            <div id="paymentProofContainer" style="display:none;">

                <div class="qr-payment-box">

                    <div class="qr-placeholder" id="qrPlaceholder">
                        <svg viewBox="0 0 110 110" class="qr-mock-svg" role="img" aria-label="Sample QR code placeholder">
                            <rect x="0" y="0" width="110" height="110" fill="var(--bg-surface)" />

                            <!-- Finder pattern: top-left -->
                            <rect x="6" y="6" width="24" height="24" fill="none" stroke="var(--gold)" stroke-width="4" />
                            <rect x="14" y="14" width="8" height="8" fill="var(--gold)" />

                            <!-- Finder pattern: top-right -->
                            <rect x="80" y="6" width="24" height="24" fill="none" stroke="var(--gold)" stroke-width="4" />
                            <rect x="88" y="14" width="8" height="8" fill="var(--gold)" />

                            <!-- Finder pattern: bottom-left -->
                            <rect x="6" y="80" width="24" height="24" fill="none" stroke="var(--gold)" stroke-width="4" />
                            <rect x="14" y="88" width="8" height="8" fill="var(--gold)" />

                            <!-- Mock data cells (decorative, not a real scannable code) -->
                            <g fill="var(--gold-light)" opacity="0.75">
                                <rect x="40" y="10" width="6" height="6" />
                                <rect x="52" y="10" width="6" height="6" />
                                <rect x="64" y="18" width="6" height="6" />
                                <rect x="40" y="24" width="6" height="6" />
                                <rect x="58" y="30" width="6" height="6" />
                                <rect x="10" y="40" width="6" height="6" />
                                <rect x="22" y="46" width="6" height="6" />
                                <rect x="36" y="40" width="6" height="6" />
                                <rect x="48" y="46" width="6" height="6" />
                                <rect x="60" y="40" width="6" height="6" />
                                <rect x="72" y="46" width="6" height="6" />
                                <rect x="84" y="40" width="6" height="6" />
                                <rect x="96" y="46" width="6" height="6" />
                                <rect x="40" y="58" width="6" height="6" />
                                <rect x="52" y="64" width="6" height="6" />
                                <rect x="64" y="58" width="6" height="6" />
                                <rect x="76" y="64" width="6" height="6" />
                                <rect x="40" y="80" width="6" height="6" />
                                <rect x="52" y="86" width="6" height="6" />
                                <rect x="64" y="80" width="6" height="6" />
                                <rect x="76" y="92" width="6" height="6" />
                                <rect x="88" y="80" width="6" height="6" />
                                <rect x="96" y="92" width="6" height="6" />
                            </g>
                        </svg>
                        <span class="qr-placeholder-text">Sample QR — coming soon</span>
                    </div>

                    <p class="qr-account-note" id="qrAccountNote">
                        Scan to pay via <strong id="qrMethodLabel">GCash</strong>. Account details will be posted here soon —
                        for now, please coordinate payment with staff via chat before sending.
                    </p>

                </div>

                <div class="addr-field-group">
                    <label class="addr-label" for="customerPaymentReference">
                        Payment Reference Number
                    </label>
                    <input type="text"
                           id="customerPaymentReference"
                           class="cart-select"
                           placeholder="e.g. GCash/Maya reference no." />
                    <p class="qr-hint">
                        Enter the reference number from your GCash/Maya payment confirmation. Staff will verify this against your order.
                    </p>
                </div>

            </div>

            <button class="btn-checkout"
                    id="checkoutBtn"
                    onclick="submitOnlineOrder()">

                Proceed to Checkout

            </button>

        </div>
    </div>

    <div id="cartOverlay"
         class="cart-overlay"
         onclick="toggleCart()">
    </div>

    <!-- ── FLOATING CHAT WIDGET HTML ── -->

    <div class="chat-widget"
         id="chatWidget">

        <button class="chat-fab"
                onclick="toggleChatWidget()"
                id="chatFab">

            💬

            <span class="chat-badge-dot"
                  id="chatBadgeDot"
                  style="display: none;">
            </span>

        </button>

        <div class="chat-window"
             id="chatWindow">

            <div class="chat-header">

                <div class="chat-header-info">

                    <span class="chat-avatar">
                        ☕
                    </span>

                    <div>

                        <h4 class="chat-title">
                            @storeSettings.StoreName Assistant
                        </h4>

                        <span class="chat-status">
                            Online
                        </span>

                    </div>

                </div>

                <button class="close-chat-widget"
                        onclick="toggleChatWidget()">
                    ✕
                </button>

            </div>

            <div class="chat-body"
                 id="chatBody">

                <div class="system-message">
                    No active messages. Introduce yourself to start chatting...
                </div>

            </div>

            <div class="chat-footer">

                <input type="text"
                       id="chatInput"
                       placeholder="Type a message..."
                       onkeypress="handleChatKey(event)">

