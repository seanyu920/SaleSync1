@model List<SaleSync.Models.DashboardLowStockItem>
@{
    string FormatQty(SaleSync.Models.DashboardLowStockItem item)
    {
        string qty = item.Quantity.ToString("0.##");
        return string.IsNullOrWhiteSpace(item.Unit) ? qty : qty + " " + item.Unit;
    }
}

@if (Model == null || !Model.Any())
{
    <div class="table-responsive">
        <p class="text-muted" style="padding: 16px 4px;">All inventory items are above the low-stock level.</p>
    </div>
}
else
{
    <!-- DESKTOP VIEW -->
    <div class="table-responsive desktop-only">
        <table class="pos-table">
            <thead>
                <tr>
                    <th>Item Stock</th>
                    <th>Current Qty</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ItemName</td>
                        <td>@FormatQty(item)</td>
                        <td><span class="badge @(item.IsCritical ? "badge-danger" : "badge-warning")">@(item.IsCritical ? "Critical" : "Low")</span></td>
                        <td class="text-right">
                            <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- MOBILE VIEW -->
    <div class="mobile-only">
        @foreach (var item in Model)
        {
            <div class="tx-card">
                <div class="tx-card-summary">
                    <div class="tx-main-info">
                        <span class="tx-customer">@item.ItemName</span>
                    </div>
                    <button type="button" class="tx-view-btn" onclick="toggleCardDetails(this)">
                        <span>Details</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                </div>
                <div class="tx-card-details hidden">
                    <div class="tx-detail-row">
                        <span class="tx-label">Current Qty:</span>
                        <span class="tx-value">@FormatQty(item)</span>
                    </div>
                    <div class="tx-detail-row">
                        <span class="tx-label">Status:</span>
                        <span class="badge @(item.IsCritical ? "badge-danger" : "badge-warning")">@(item.IsCritical ? "Critical" : "Low")</span>
                    </div>
                    <div class="tx-detail-row" style="margin-top: 6px;">
                        <span class="tx-label">Action:</span>
                        <button type="button" class="btn-restock" onclick="location.href='/Admin/Inventory'">Restock</button>
                    </div>
                </div>
            </div>
        }
    </div>
}
