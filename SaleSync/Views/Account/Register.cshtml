@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register - Cafero</title>

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Playfair+Display:wght@800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Register.css" asp-append-version="true" />
    <link rel="icon" type="image/jpeg" href="~/images/CaferoLogo.jpg" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="register-split-container">

        <div class="register-left">
            <div class="brand-content">
                <div class="brand-lockup">
                    <h1 class="register-logo">Cafèro</h1>
                    <div class="software-tag">POWERED BY <strong>SALESYNC</strong></div>
                </div>
                <p>Join the Cafèro family! Create an account to order ahead, customize your drinks, and skip the line.</p>
            </div>
        </div>

        <div class="register-right">
            <div class="register-card">
                <div class="register-header">
                    <h2>Create Account</h2>
                    <p>Fill in your details to get started.</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">

                    <div class="input-group">
                        <label for="fullName">FULL NAME</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>

                            <input type="text"
                                   id="fullName"
                                   name="fullName"
                                   placeholder="e.g. Juan Dela Cruz"
                                   value="@(Context.Request.HasFormContentType ? Context.Request.Form["fullName"].ToString() : "")"
                                   required />
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="username">USERNAME</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path>
                                </svg>
                            </span>

                            <input type="text"
                                   id="username"
                                   name="username"
                                   placeholder="Choose a username"
                                   value="@(Context.Request.HasFormContentType ? Context.Request.Form["username"].ToString() : "")"
                                   required />
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="email">EMAIL ADDRESS</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </span>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   placeholder="e.g. juan@example.com"
                                   value="@(Context.Request.HasFormContentType ? Context.Request.Form["email"].ToString() : "")"
                                   required />
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="password">PASSWORD</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>

                            <input type="password"
                                   id="password"
                                   name="password"
                                   placeholder="Create a password"
                                   required />

                            <!-- Toggle Button for Main Password -->
                            <button type="button"
                                    class="password-toggle-btn"
                                    id="togglePassword"
                                    aria-label="Toggle password visibility">

                                <svg class="eye-icon eye-open"
                                     xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>

                                <svg class="eye-icon eye-closed"
                                     xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     style="display: none;">

                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="confirmPassword">CONFIRM PASSWORD</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24"
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round">

                                    <rect x="3"
                                          y="11"
                                          width="18"
                                          height="11"
                                          rx="2"
                                          ry="2"></rect>

                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>

                                    <polyline points="11 15 13 17 17 13"></polyline>
                                </svg>
                            </span>

                            <input type="password"
                                   id="confirmPassword"
                                   name="confirmPassword"
                                   placeholder="Repeat password"
                                   required />

                            <!-- Toggle Button for Confirm Password -->
                            <button type="button"
                                    class="password-toggle-btn"
                                    id="toggleConfirmPassword"
                                    aria-label="Toggle confirm password visibility">

                                <svg class="eye-icon eye-open"
                                     xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>

                                <svg class="eye-icon eye-closed"
                                     xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     style="display: none;">

                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>


                    <!-- =====================================================
                         TERMS & PRIVACY AGREEMENT
                         ===================================================== -->

                    <div class="terms-agreement">

                        <label class="terms-checkbox-label">

                            <input type="checkbox"
                                   id="agreeTerms"
                                   name="agreeTerms"
                                   value="true"
                                   required />

                            <span class="custom-checkbox"></span>

                            <span class="terms-text">
                                I agree to the
                                <a href="#" id="openTerms">Terms &amp; Conditions</a>
                                and
                                <a href="#" id="openPrivacy">Privacy Policy</a>.
                            </span>

                        </label>

                    </div>


                    <div class="form-actions">
                        <button type="submit"
                                class="btn-register"
                                id="registerButton"
                                style="margin-top: 15px;">

                            Create Account

                        </button>
                    </div>

                </form>

                <div class="login-prompt">
                    <p>Already have an account?</p>
                    <a href="/Home/Login" class="login-link">Log In here</a>
                </div>

            </div>
        </div>

    </div>


    <!-- ================================================================
         TERMS & CONDITIONS MODAL
         ================================================================ -->

    <div class="legal-modal-overlay" id="termsModal">

        <div class="legal-modal">

            <button type="button"
                    class="legal-modal-close"
                    id="closeTerms"
                    aria-label="Close">

                ✕

            </button>

            <div class="legal-modal-header">

                <div class="legal-icon">
                    ✓
                </div>

                <h2>Terms &amp; Conditions</h2>

                <p>
                    Please read these terms before creating your SaleSync account.
                </p>

            </div>

            <div class="legal-modal-body">

                <h3>1. Account Registration</h3>

                <p>
                    By creating an account, you agree to provide accurate and
                    complete information. You are responsible for keeping your
                    account credentials secure.
                </p>

                <h3>2. Use of the System</h3>

                <p>
                    Your SaleSync account may be used to place orders, customize
                    products, and access customer features provided by the system.
                </p>

                <h3>3. Orders and Payments</h3>

                <p>
                    Customers are responsible for reviewing their orders before
                    submitting them. Orders and payments are subject to the
                    available options and policies of SaleSync.
                </p>

                <h3>4. Account Security</h3>

                <p>
                    Do not share your username or password with other people.
                    You are responsible for activity performed using your account.
                </p>

                <h3>5. Acceptance</h3>

                <p>
                    By checking the agreement box during registration, you confirm
                    that you have read and agree to these Terms &amp; Conditions.
                </p>

            </div>

            <div class="legal-modal-footer">

                <button type="button"
                        class="legal-close-button"
                        id="termsDone">

                    I Understand

                </button>

            </div>

        </div>

    </div>


    <!-- ================================================================
         PRIVACY POLICY MODAL
         ================================================================ -->

    <div class="legal-modal-overlay" id="privacyModal">

        <div class="legal-modal">

            <button type="button"
                    class="legal-modal-close"
                    id="closePrivacy"
                    aria-label="Close">

                ✕

            </button>

            <div class="legal-modal-header">

                <div class="legal-icon">
                    🔒
                </div>

                <h2>Privacy Policy</h2>

                <p>
                    Information about how SaleSync handles customer information.
                </p>

            </div>

            <div class="legal-modal-body">

                <h3>1. Information We Collect</h3>

                <p>
                    When you create an account, the system may collect information
                    such as your full name, username, email address, and account
                    credentials.
                </p>

                <h3>2. How Information Is Used</h3>

                <p>
                    Customer information may be used to manage accounts, process
                    orders, provide customer services, and operate the SaleSync
                    ordering system.
                </p>

                <h3>3. Information Security</h3>

                <p>
                    Reasonable measures are used to protect customer information
                    and account details from unauthorized access.
                </p>

                <h3>4. Information Sharing</h3>

                <p>
                    Customer information should only be accessed or used for
                    legitimate system and business purposes, subject to applicable
                    policies and requirements.
                </p>

                <h3>5. Your Agreement</h3>

                <p>
                    By checking the agreement box during registration, you
                    acknowledge that you have read and understood this Privacy
                    Policy.
                </p>

            </div>

            <div class="legal-modal-footer">

                <button type="button"
                        class="legal-close-button"
                        id="privacyDone">

                    I Understand

                </button>

            </div>

        </div>

    </div>


    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // =============================================================
            // SWEETALERT CONFIGURATION
            // =============================================================

            const modernToast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                background: '#fdfaf6',
                color: '#4a2511',
                iconColor: '#f46a05',
                customClass: {
                    popup: 'modern-toast-popup'
                },
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });


            // =============================================================
            // ERROR TOAST
            // =============================================================

            @if (ViewBag.Message != null)
            {
                <text>
                    modernToast.fire({
                        icon: 'error',
                        title: '@Html.Raw(ViewBag.Message)'
                    });
                </text>
            }


            // =============================================================
            // SUCCESS TOAST
            // =============================================================

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                    modernToast.fire({
                        icon: 'success',
                        title: '@Html.Raw(TempData["SuccessMessage"])'
                    });
                </text>
            }


            // =============================================================
            // PASSWORD TOGGLE
            // =============================================================

            function setupPasswordToggle(buttonId, inputId) {

                const toggleBtn =
                    document.getElementById(buttonId);

                const passwordInput =
                    document.getElementById(inputId);

                if (!toggleBtn || !passwordInput) return;

                const eyeOpenIcon =
                    toggleBtn.querySelector('.eye-open');

                const eyeClosedIcon =
                    toggleBtn.querySelector('.eye-closed');


                toggleBtn.addEventListener('click', function() {

                    const type =
                        passwordInput.getAttribute('type') === 'password'
                            ? 'text'
                            : 'password';

                    passwordInput.setAttribute('type', type);


                    if (type === 'password') {

                        eyeOpenIcon.style.display = 'block';
                        eyeClosedIcon.style.display = 'none';

                    } else {

                        eyeOpenIcon.style.display = 'none';
                        eyeClosedIcon.style.display = 'block';

                    }

                });

            }


            // Initialize password toggles
            setupPasswordToggle('togglePassword', 'password');
            setupPasswordToggle('toggleConfirmPassword', 'confirmPassword');


            // =============================================================
            // TERMS & PRIVACY MODALS
            // =============================================================

            const termsModal =
                document.getElementById('termsModal');

            const privacyModal =
                document.getElementById('privacyModal');

            const openTerms =
                document.getElementById('openTerms');

            const openPrivacy =
                document.getElementById('openPrivacy');

            const closeTerms =
                document.getElementById('closeTerms');

            const closePrivacy =
                document.getElementById('closePrivacy');

            const termsDone =
                document.getElementById('termsDone');

            const privacyDone =
                document.getElementById('privacyDone');


            // Open Terms
            openTerms.addEventListener('click', function(e) {

                e.preventDefault();

                termsModal.classList.add('open');

            });


            // Open Privacy Policy
            openPrivacy.addEventListener('click', function(e) {

                e.preventDefault();

                privacyModal.classList.add('open');

            });


            // Close Terms
            closeTerms.addEventListener('click', function() {

                termsModal.classList.remove('open');

            });


            termsDone.addEventListener('click', function() {

                termsModal.classList.remove('open');

            });


            // Close Privacy
            closePrivacy.addEventListener('click', function() {

                privacyModal.classList.remove('open');

            });


            privacyDone.addEventListener('click', function() {

                privacyModal.classList.remove('open');

            });


            // Close modal when clicking outside
            termsModal.addEventListener('click', function(e) {

                if (e.target === termsModal) {

                    termsModal.classList.remove('open');

                }

            });


            privacyModal.addEventListener('click', function(e) {

                if (e.target === privacyModal) {

                    privacyModal.classList.remove('open');

                }

            });


            // =============================================================
            // REQUIRED TERMS CHECK
            // =============================================================

            const registerForm =
                document.getElementById('registerForm');

            const agreeTerms =
                document.getElementById('agreeTerms');


            registerForm.addEventListener('submit', function(e) {

                if (!agreeTerms.checked) {

                    e.preventDefault();

                    modernToast.fire({
                        icon: 'warning',
                        title: 'Please agree to the Terms & Conditions and Privacy Policy.'
                    });

                    agreeTerms.focus();

                    return false;
                }

            });

        });

    </script>

</body>
</html>