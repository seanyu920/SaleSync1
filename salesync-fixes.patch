+
+                    if (el.tagName === 'SELECT') {
+                        let original = el.options.length ? el.options[0].value : '';
+                        for (let j = 0; j < el.options.length; j++) {
+                            if (el.options[j].defaultSelected) { original = el.options[j].value; break; }
+                        }
